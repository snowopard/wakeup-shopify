{%- comment -%}
------------------------------------------------------------------------------
	Section: Cart drawer
------------------------------------------------------------------------------
{%- endcomment -%}
{%- if settings.cart_type == "drawer" and template != "cart" -%}
	{% liquid
		assign discount_codes = cart.cart_level_discount_applications | where: 'type', 'discount_code' | map: 'title'
		for item in cart.items
			for allocation in item.line_level_discount_allocations
				if allocation.discount_application.type == 'discount_code'
					assign discount_codes = item.line_level_discount_allocations | slice: forloop.index0 | map: 'discount_application' | map: 'title' | concat: discount_codes
				endif
			endfor
		endfor

		assign discount_codes = discount_codes | uniq
	%}

	{%- render 'adastra' with '/src/styles/cart.scss' -%}

	{%- capture default_heading -%}
		{{- "cart.general.title" | t -}}
	{%- endcapture -%}

	{%- assign show_cart_items_count 			= section.settings.show_cart_items_count -%}
	{%- assign heading 							= section.settings.heading | default: default_heading -%}
	{%- assign color_scheme      	           	= section.settings.color_scheme -%}
	{%- assign enable_color_scheme_inheritance 	= section.settings.enable_color_scheme_inheritance -%}

	{%- if enable_color_scheme_inheritance -%}
		{%- assign color_scheme = settings.main_color_scheme -%}
	{%- endif -%}

	{%- if show_cart_items_count -%}
		{%- capture heading -%}
			{{- heading }} ({{- cart.item_count -}})
		{%- endcapture -%}
	{%- endif -%}

	{%- capture content -%}
		{%- for block in section.blocks -%}
			{%- case block.type -%}
				{%- when 'items' -%}
					<div class="cart-drawer__section cart-drawer__section--items">
						<div class="cart-items">
							<form action="{{- routes.cart_url -}}" id="cart-{{- section.id -}}" class="cart-items__form" method="post">
								<div class="cart-items__body">
									{%- unless cart.empty? -%}
										{%- for item in cart.items -%}
											{% render 'cart-item-drawer', item: item %}
										{%- endfor -%}
									{%- endunless -%}
								</div>
							</form>
						</div>
					</div>
				{%- when 'upsell' -%}
					{%- assign upsell_heading 	= block.settings.heading -%}
					{%- assign products       	= block.settings.product_list -%}

					{%- capture upsell_content -%}
						{%- render 'cart-upsell',
							products: products,
							heading: upsell_heading
						-%}
					{%- endcapture -%}

					{%- if upsell_content != '' -%}
						<div class="cart-drawer__section">
							{{- upsell_content -}}
						</div>
					{%- endif -%}
				{%- when 'shipping' -%}
					{%- capture shipping_content -%}
						{%- render 'cart-shipping',
							amount: block.settings.amount,
							message: block.settings.message,
							congratulatory_message: block.settings.congratulatory_message,
							block_background: block.settings.block_background,
							text_color: block.settings.text_color,
							amount_color: block.settings.amount_color,
							amount_bg: block.settings.amount_bg,
							bar_color: block.settings.bar_color,
							fill_color: block.settings.fill_color
						-%}
					{%- endcapture -%}

					{%- if shipping_content != '' -%}
						{{- shipping_content -}}
					{%- endif -%}
			{%- endcase -%}
		{%- endfor -%}
	{%- endcapture -%}

	<section
		id="CartDrawer"
		class="drawer drawer--right cart-drawer color-{{ color_scheme }} {% if cart.empty? %} is-empty{% endif %}"
		data-section-type="cart-template"
		data-section-modification="drawer"
		data-section-id="{{- section.id -}}"
		data-shadow-root
		role="dialog"
		aria-labelledby="CartDrawer-{{- heading | handle -}}"
	>
		<div class="drawer__body cart-drawer__container js-cart-container" data-scrollable>
			<div class="cart-drawer__content js-cart-content">
				<div class="drawer__header">
					<h2 class="drawer__title" id="CartDrawer-{{- heading | handle -}}">
						{{- heading -}}
					</h2>

					<button
						class="drawer__close focus-visible-outline cart-drawer__close js-cart-close-button"
						data-target="CartDrawer"
						data-js-toggle="CartDrawer"
						aria-label="{{- 'general.accessibility.close_modal' | t | escape -}}"
					>
						{% render 'icons', icon: 'close' %}
					</button>
				</div>

				{%- if cart.empty? -%}
					{%- render 'cart-empty' -%}
				{%- else -%}
					{%- if content != '' -%}
						{{- content -}}
					{%- endif -%}

					{%- if settings.show_cart_discounts -%}
						<div
							class="cart-drawer__section cart-drawer__section--discount-form js-cart-discount-accordion-container js-accordion-container">
							<div class="cart-drawer__accordion-item accordion__item js-accordion-item">
								<button
									class="cart-drawer__discount-form-label accordion__control focus-visible-outline js-accordion-control"
									aria-controls="cart-drawer-discounts"
									aria-expanded="false"
								>
									{{- "cart.general.discount_accordion_button" | t -}}

									<span class="cart-drawer__discount-form-label-icon">
										{%- render 'icons', icon: 'arrow-down', class: 'icon-arrow-down' -%}
										{%- render 'icons', icon: 'circle-decoration-border' -%}
									</span>
								</button>

								<div
									class="cart-drawer__accordion-content accordion__content accordion__content--animate js-accordion-content"
									id="cart-drawer-discounts">
									<div class="js-accordion-inner">
										<form class="cart-drawer__discount-form js-cart-discount-form">
											<div class="input-wrapper cart-drawer__discount-form-input-wrapper">
												<label class="visually-hidden" for="cart-discount">
													{{- "cart.general.discount" | t -}}
												</label>

												<input
													class="input cart-drawer__discount-form-input"
													type="text"
													id="cart-discount"
													name="discount"
													placeholder="{{- 'cart.general.discount_placeholder' | t -}}"
													required
												/>
											</div>

											<button
												class="button button-simple button-simple--primary cart-drawer__discount-form-button js-cart-discount-apply-button"
												type="submit"
											>
												{{- "cart.general.apply_discount" | t -}}
											</button>
										</form>

										<div
											class="cart-drawer__discount-form-error js-cart-discount-error is-hidden"
											role="alert"
										>
											<span class="cart-drawer__discount-form-error-icon-wrapper">
												{% render 'icons', icon: 'error' %}
											</span>

											<span class="cart-drawer__discount-form-error-text js-cart-discount-error-code is-hidden">
												{{ 'cart.general.discount_code_error' | t }}
											</span>

											<small class="cart-drawer__discount-form-error-text js-cart-discount-error-shipping is-hidden">
												{{ 'cart.general.shipping_discount_error' | t }}
											</small>
										</div>

										{%- if discount_codes.size > 0 -%}
											<ul class="cart-drawer__discount-codes">
												{% for discount_code in discount_codes %}
													<li
														class="cart-drawer__discount-pill js-cart-discount-pill"
														data-discount-code="{{ discount_code }}"
														aria-label="{{ 'cart.general.discount_applied' | t: code: discount_code }}"
													>
														<p class="cart-drawer__discount-pill-code">
															{{ discount_code }}
														</p>

														<button
															class="cart-drawer__discount-pill-remove focus-visible-outline js-cart-discount-pill-remove"
															type="button"
															aria-label="{{ 'cart.general.remove_discount' | t: code: discount_code }}"
														>
															{% render 'icons', icon: 'close' %}
														</button>
													</li>
												{% endfor %}
											</ul>
										{%- endif -%}
									</div>
								</div>
							</div>
						</div>
					{%- endif -%}
				{%- endif -%}
			</div>

			{%- render 'cart-footer', section: section, cart_drawer: true -%}
		</div>

		{%- render 'preloader' -%}
	</section>

	{%- render 'adastra' with '/src/scripts/cart-drawer.js' -%}

{% endif %}

{% schema %}
{
	"name": "Cart drawer",
	"settings": [
		{
			"type": "header",
			"content": "Cart drawer settings"
		},
		{
			"type": "text",
			"id": "heading",
			"label": "Heading",
			"default": "Your Cart"
		},
		{
			"type": "checkbox",
			"id": "show_cart_items_count",
			"label": "Show items count in the cart",
			"default": true
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "checkbox",
			"id": "enable_color_scheme_inheritance",
			"label": "Enable color scheme inheritance",
			"default": true,
			"info": "When this setting is enabled, the color scheme is inherited from the theme settings."
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "Color scheme",
			"default": "scheme-1"
		}
	],
	"blocks": [
		{
			"name": "Items",
			"type": "items",
			"limit": 1,
			"settings": []
		},
		{
			"name": "Upsell products",
			"type": "upsell",
			"limit": 1,
			"settings": [
				{
					"type": "text",
					"id": "heading",
					"label": "Heading",
					"default": "You might also like"
				},
				{
					"type": "product_list",
					"id": "product_list",
					"label": "Products",
					"limit": 12
				}
			]
		},
		{
			"name": "Shipping bar",
			"type": "shipping",
			"limit": 1,
			"settings": [
				{
					"type": "number",
					"id": "amount",
					"label": "Free shipping amount",
					"default": 100
				},
				{
					"type": "textarea",
					"id": "message",
					"label": "Shipping message",
					"default": "You are only {amount} away from free shipping",
					"info": "The pattern {amount} will be replaced with the remaining amount"
				},
				{
					"type": "textarea",
					"id": "congratulatory_message",
					"label": "Shipping congratulatory message",
					"default": "You got free shipping"
				},
				{
					"type": "header",
					"content": "Colors"
				},
				{
					"type": "color_background",
					"id": "block_background",
					"label": "Background",
					"default": "rgba(255,255,255, 0.06)"
				},
				{
					"type": "color",
					"id": "text_color",
					"label": "Text",
					"default": "#fff"
				},
				{
					"type": "color",
					"id": "amount_color",
					"label": "Amount text",
					"default": "#fff"
				},
				{
					"type": "color_background",
					"id": "amount_bg",
					"label": "Amount background",
					"default": "linear-gradient(85.71deg, #CF1D5D 0.03%, rgba(255, 113, 12, 0.6) 100%)"
				},
				{
					"type": "color",
					"id": "bar_color",
					"label": "Progress bar background color",
					"default": "#585b61"
				},
				{
					"type": "color",
					"id": "fill_color",
					"label": "Progress bar fill color",
					"default": "#FF710C"
				}
			]
		}
	],
	"default": {
		"blocks": [
			{
				"type": "items"
			},
			{
				"type": "upsell"
			},
			{
				"type": "shipping"
			}
		]
	}
}
{% endschema %}
