{%- comment -%}
------------------------------------------------------------------------------
	Section: Banner
------------------------------------------------------------------------------
{%- endcomment -%}

{%- assign section_background 			= section.settings.section_background -%}
{%- assign content_background 			= section.settings.content_background -%}
{%- assign text_color 					= section.settings.text_color -%}
{%- assign link_color 					= section.settings.link_color -%}
{%- assign button_background 			= section.settings.button_background -%}
{%- assign button_color 				= section.settings.button_color -%}
{%- assign button_border 				= section.settings.button_border -%}
{%- assign button_border_outer 			= section.settings.button_border_outer -%}
{%- assign button_background_hover 		= section.settings.button_background_hover -%}
{%- assign button_color_hover 			= section.settings.button_color_hover -%}
{%- assign button_border_hover 			= section.settings.button_border_hover -%}
{%- assign button_border_outer_hover 	= section.settings.button_border_outer_hover -%}
{%- assign overlay       				= section.settings.overlay -%}
{%- assign enable_glass_effect      	= section.settings.enable_glass_effect -%}
{%- assign container 					= section.settings.container_width -%}

{% if container == 'inherit' %}
	{% assign container_width = settings.container_width %}
{% else %}
	{% assign container_width = container %}
{% endif %}

{%- capture section_styles -%}
	--banner-background-color: {{- section_background -}}; {{-  -}}
	--banner-content-background: {{- content_background -}}; {{-  -}}
	--banner-text-color: {{- text_color -}}; {{-  -}}
	--banner-link-color: {{- link_color -}}; {{-  -}}
	--banner-button-background: {{- button_background -}}; {{-  -}}
	--banner-button-color: {{- button_color -}}; {{-  -}}
	--banner-button-border: {{- button_border -}}; {{-  -}}
	--banner-button-border-outer: {{- button_border_outer -}}; {{-  -}}
	--banner-button-border-outer-alpha: {{- button_border_outer | color_modify: 'alpha', 0.16 -}}; {{-  -}}
	--banner-button-background-hover: {{- button_background_hover -}}; {{-  -}}
	--banner-button-color-hover: {{- button_color_hover -}}; {{-  -}}
	--banner-button-border-hover: {{- button_border_hover -}}; {{-  -}}
	--banner-button-border-outer-hover: {{- button_border_outer_hover -}}; {{-  -}}
	--banner-button-border-outer-alpha-hover: {{- button_border_outer_hover | color_modify: 'alpha', 0.16 -}}; {{-  -}}
	--overlay: {{- overlay -}}; {{-  -}}
	--container-width: {{ container_width }}; {{-  -}}
{%- endcapture -%}

{%- capture banner -%}
	{%- if section.blocks.size > 0 -%}
		{%- for block in section.blocks -%}
			{%- assign banner_height_desktop 			= block.settings.desktop_image_height -%}
			{%- assign banner_height_mobile 			= block.settings.mobile_image_height -%}
			{%- assign media_type 					  	= block.settings.media_type -%}
			{%- assign heading_first_line				= block.settings.heading_first_line -%}
			{%- assign heading_second_line				= block.settings.heading_second_line -%}
			{%- assign text 						  	= block.settings.text -%}
			{%- assign button_text 					  	= block.settings.button_text -%}
			{%- assign button_url 					  	= block.settings.button_url -%}
			{%- assign button_aria 					  	= block.settings.button_aria -%}
			{%- assign image_desktop 				  	= block.settings.image_desktop -%}
			{%- assign image_mobile 				  	= block.settings.image_mobile | default: image_desktop -%}
			{%- assign html_video_desktop 		  		= block.settings.html_video_desktop -%}
			{%- assign html_video_mobile 		  		= block.settings.html_video_mobile | default: html_video_desktop -%}
			{%- assign external_video_url_desktop 		= block.settings.external_video_url_desktop -%}
			{%- assign external_video_url_mobile 		= block.settings.external_video_url_mobile | default: external_video_url_desktop -%}
			{%- assign content_alignment 				= block.settings.content_alignment -%}
			{%- assign content_alignment_mobile 		= block.settings.content_alignment_mobile -%}
			{%- assign block_alignment 					= block.settings.block_alignment -%}
			{%- assign enable_countdown_timer 			= block.settings.enable_countdown_timer -%}
			{%- assign timer_type 						= block.settings.timer_type -%}
			{%- assign timer_duration 					= block.settings.timer_duration -%}
			{%- assign enable_timer_loop 				= block.settings.enable_timer_loop -%}
			{%- assign timer_year 						= block.settings.timer_year -%}
			{%- assign timer_month 						= block.settings.timer_month -%}
			{%- assign timer_day 						= block.settings.timer_day -%}
			{%- assign timer_hour 						= block.settings.timer_hour -%}
			{%- assign timer_timezone 					= block.settings.timer_timezone -%}
			{%- assign enable_slice_animation 			= block.settings.enable_slice_animation -%}

			{%- if block.type == 'two_columns' -%}
				{%- assign ellipse_color 			= block.settings.ellipse_color -%}
				{%- assign object_fit_main 			= block.settings.object_fit_main -%}
				{%- assign image_secondary_desktop 	= block.settings.image_secondary_desktop -%}
				{%- assign image_secondary_mobile 	= block.settings.image_secondary_mobile | default: image_secondary_desktop -%}
				{%- assign object_fit_secondary 	= block.settings.object_fit_secondary -%}
				{%- assign image_decor 				= block.settings.image_decor -%}
			{%- endif -%}

			{%- assign enable_lazy_load = true -%}

			{% if section.index == 1 %}
				{%- assign enable_lazy_load = false -%}
			{% endif %}

			{%- if block.type == 'full_width' -%}
				{%- assign is_full_width = true -%}
			{%- else -%}
				{%- assign is_full_width = false -%}
			{%- endif -%}

			{%- if enable_countdown_timer or media_type == 'html_video' or media_type == 'iframe_video' or enable_slice_animation -%}
				{%- assign is_script_needed = true -%}
			{%- endif -%}

			{% if banner_height_desktop == 'auto' and image_desktop != blank %}
				{% assign use_aspect_desktop_class = true %}
			{% elsif banner_height_desktop == 'auto' and html_video_desktop != blank %}
				{% assign use_aspect_desktop_class = true %}
			{% endif %}

			{% if banner_height_mobile == 'auto' and image_mobile != blank %}
				{% assign use_aspect_mobile_class = true %}
			{% elsif banner_height_mobile == 'auto' and html_video_mobile != blank %}
				{% assign use_aspect_mobile_class = true %}
			{% endif %}

			{%- capture aspect_ratio_height_styles -%}
				{%- if  media_type == 'image' and image_desktop != blank -%}
					--aspect-ratio-media-desktop: {{ image_desktop.aspect_ratio |  round: 2 }}; {{-  -}}
					--aspect-ratio-media-mobile: {{ image_mobile.aspect_ratio | round: 2 }}; {{-  -}}
				{%- elsif media_type == 'html_video' and html_video_desktop != blank -%}
					--aspect-ratio-media-desktop: {{ html_video_desktop.aspect_ratio |  round: 2 }}; {{-  -}}
					--aspect-ratio-media-mobile: {{ html_video_mobile.aspect_ratio | round: 2 }}; {{-  -}}
				{%- endif -%}
			{%- endcapture -%}

			{%- capture image -%}
				{%- if image_desktop != blank -%}
					{%- render
						'banner-image',
						image_desktop: image_desktop,
						image_mobile: image_mobile,
						enable_lazy_load: enable_lazy_load,
						is_full_width: is_full_width,
						mobile_height: banner_height_mobile,
						object_fit: object_fit_main,
						enable_slice_animation: enable_slice_animation,
						class: 'banner__media--primary',
						delay: '0.3s',
						mouse_move_class: 'js-image-mouse-move is-reverse-translate'
					-%}

					{% if block.type == 'two_columns' and image_secondary_desktop != blank %}
						{%- render
							'banner-image',
							image_desktop: image_secondary_desktop,
							image_mobile: image_secondary_mobile,
							enable_lazy_load: true,
							is_full_width: false,
							mobile_height: banner_height_mobile,
							object_fit: object_fit_secondary,
							class: 'banner__media--secondary',
							delay: '0.7s',
							mouse_move_class: 'js-image-mouse-move'
						-%}
					{% endif %}

					{% if block.type == 'two_columns' and image_decor != blank %}
						<picture style="--delay: 1.3s;">
							<source srcset="{{ image_decor | image_url: width: 125 }} 1x, {{ image_decor | image_url: width: 250 }} 2x">

							<img
								class="banner__media-decor need-animate js-image-mouse-move is-reverse-translate"
								data-animation-speed="0.2"
								data-move-distance="2.3"
								src="{{ image_decor | image_url: width: 240 }}"
								srcset="{{ image_decor | image_url: width: 240 }} 1x, {{ image_decor | image_url: width: 480 }} 2x"
								alt="{{ image_decor.alt | escape }}"
								loading="lazy"
							>
						</picture>
					{% endif %}
				{%- endif -%}
			{%- endcapture -%}

			{%- capture html_video -%}
				{%- if html_video_desktop != blank -%}
					<video
						class="banner__media banner__video js-video"
						data-device="desktop"
						data-type="html"
						loop
						muted
						playsinline
						tabindex="-1"
						aria-hidden="true"
					>
						{%- for source in html_video_desktop.sources -%}
							{%- if source.mime_type == 'video/mp4' -%}
								<source src="{{- source.url -}}" type="{{- source.mime_type -}}">
							{%- endif -%}
						{%- endfor -%}
					</video>

					<video
						class="banner__media banner__video banner__video--mobile js-video"
						data-device="mobile"
						data-type="html"
						loop
						muted
						playsinline
						tabindex="-1"
						aria-hidden="true"
					>
						{%- for source in html_video_mobile.sources -%}
							{%- if source.mime_type == 'video/mp4' -%}
								<source src="{{- source.url -}}" type="{{- source.mime_type -}}">
							{%- endif -%}
						{%- endfor -%}
					</video>
				{%- endif -%}
			{%- endcapture -%}

			{%- if external_video_url_desktop != nil -%}
				{%- capture external_video -%}
					{%- if external_video_url_desktop != nil -%}
						{%- if external_video_url_desktop.type == 'youtube' -%}
							<div
								class="banner__media banner__video js-video"
								data-device="desktop"
								data-type="{{- external_video_url_desktop.type -}}"
							>
								<div
									class="js-video-youtube"
									data-video-id="{{- external_video_url_desktop.id -}}"
									tabindex="-1"
									aria-hidden="true"
								></div>
							</div>
						{%- else -%}
							<div
								class="banner__media banner__video js-video"
								data-device="desktop"
								data-video-id="{{- external_video_url_desktop.id -}}"
								data-type="{{- external_video_url_desktop.type -}}"
								aria-hidden="true"
							></div>
						{%- endif -%}
					{%- endif -%}

					{%- if external_video_url_mobile != nil -%}
						{%- if external_video_url_mobile.type == 'youtube' -%}
							<div
								class="banner__media banner__video banner__video--mobile js-video"
								data-device="mobile"
								data-type="{{- external_video_url_mobile.type -}}"
							>
								<div
									class="js-video-youtube"
									data-video-id="{{- external_video_url_mobile.id -}}"
									tabindex="-1"
									aria-hidden="true"
								></div>
							</div>
						{%- else -%}
							<div
								class="banner__media banner__video banner__video--mobile js-video"
								data-device="mobile"
								data-video-id="{{- external_video_url_mobile.id -}}"
								data-type="{{- external_video_url_mobile.type -}}"
								aria-hidden="true"
							></div>
						{%- endif -%}
					{%- endif -%}
				{%- endcapture -%}
			{%- endif -%}

			{%- capture banner_media -%}
				{%- case media_type -%}
					{%- when 'image' -%}
						{{- image -}}
					{%- when 'html_video' -%}
						{{- html_video -}}
					{%- when 'iframe_video' -%}
						{{- external_video -}}
				{%- endcase -%}
			{%- endcapture -%}

			{%- capture timer -%}
				{%- if enable_countdown_timer and timer_year != blank and timer_month != blank and timer_day != blank and timer_hour != blank -%}
					{% render 'countdown-timer',
						timer_type: timer_type,
						timer_duration: timer_duration,
						enable_timer_loop: enable_timer_loop,
						timer_year: timer_year,
						timer_month: timer_month,
						timer_day: timer_day,
						timer_hour: timer_hour,
						timer_timezone: timer_timezone,
						main_extra_class: 'banner__timer'
					%}
				{%- endif -%}
			{%- endcapture -%}

			{%- capture banner_content -%}
				{%- if heading_first_line != blank or heading_second_line != blank or text != blank or button_url != blank or timer != blank -%}
					{% if block.type == 'full_width' and content_background != blank %}
						{% assign content_extra_class = 'banner__content--with-bg' %}
					{% endif %}
					<div class="banner__content {{  -}}
						{% if enable_glass_effect %}banner__content--glass{% endif %} {{  -}}
						{% if enable_slice_animation and image_desktop != blank and media_type == 'image' %}banner__content-fade-in{% endif %} {{  -}}
						{{ content_extra_class }}"
					>
						{%- if heading_first_line != blank or heading_second_line != blank -%}
							<h2 class="banner__heading section-title need-animate">
								{%- if heading_first_line != blank -%}
									<span class="section-title__text-container">
										<span class="section-title__text {{ heading_first_line_class }}" style="--delay-step: 0.5s;">
											{{- heading_first_line -}}
										</span>
									</span>
								{%- endif -%}

								{%- if heading_second_line != blank -%}
									<span class="section-title__text-container">
										<span class="section-title__text {{ heading_second_line_class }}" style="--delay-step: 0.75s;">
											{{- heading_second_line -}}
										</span>
									</span>
								{%- endif -%}
							</h2>
						{%- endif -%}

						{%- if text != blank -%}
							<div class="banner__text rte need-animate">
								{{- text -}}
							</div>
						{%- endif -%}

						{%- if timer != blank -%}
							{{- timer -}}
						{%- endif -%}

						{%- if button_text != blank and button_url != blank -%}
							<div class="banner__button-wrapper need-animate">
								<a
									class="button button--primary banner__button"
									href="{{- button_url -}}"
									{% if button_aria != blank %}
										aria-label="{{- button_aria | escape -}}"
									{% endif %}
								>
									<span class="button__outer"></span>
									{{- button_text -}}
								</a>
							</div>
						{%- endif -%}
					</div>
				{%- endif -%}
			{%- endcapture -%}

			{%- case content_alignment -%}
				{%- when 'center' -%}
					{%- assign timer_content_alignment = 'center' -%}
				{%- when 'right' -%}
					{%- assign timer_content_alignment = 'flex-end' -%}
				{%- else -%}
					{%- assign timer_content_alignment = 'flex-start' -%}
			{%- endcase -%}

			{%- case content_alignment_mobile -%}
				{%- when 'center' -%}
					{%- assign timer_content_alignment_mobile = 'center' -%}
				{%- when 'right' -%}
					{%- assign timer_content_alignment_mobile = 'flex-end' -%}
				{%- else -%}
					{%- assign timer_content_alignment_mobile = 'flex-start' -%}
			{%- endcase -%}

			{%- capture banner_wrapper_classes -%}
				banner__wrapper js-banner-wrapper {{-  -}}
				{% if overlay %} banner__wrapper--overlayed {{-  -}} {%- endif -%}
				{% if block.type == 'two_columns' %} banner__wrapper--two-cols {% else %} banner__wrapper--one-col {%- endif -%}
			{%- endcapture -%}

			{%- capture banner_wrapper_styles -%}
				{%- if block.type == 'full_width' or block.type == 'two_columns' -%}
					--banner-min-height-desktop: {{ block.settings.desktop_image_height }}; {{-  -}}
					--banner-min-height-mobile: {{ block.settings.mobile_image_height }}; {{-  -}}
				{%- endif -%}
				--banner-inner-content-alignment: {{- content_alignment -}}; {{-  -}}
				--banner-inner-content-alignment-mobile: {{- content_alignment_mobile -}}; {{-  -}}
				{%- if block.type == 'full_width' -%}
					--banner-block-alignment: {{- block_alignment -}}; {{-  -}}
				{%- endif -%}
				--timer-content-alignment: {{- timer_content_alignment -}}; {{-  -}}
				--timer-content-alignment-mobile: {{- timer_content_alignment_mobile -}}; {{-  -}}
				{{- aspect_ratio_height_styles -}}
			{%- endcapture -%}

			{%- capture media_wrapper_classes -%}
				banner__media-wrapper
				{% if enable_slice_animation and media_type == 'image' %}banner__media-wrapper-slice js-banner-split-image{% endif %} {{-  -}}
				{% if media_type == 'html_video' or media_type == 'iframe_video' %} js-videos {%- endif -%}
			{%- endcapture -%}

			{%- capture aspect_ratio_class -%}
				{% if use_aspect_desktop_class and media_type != 'iframe_video' %} banner__inner--aspect-desktop{%- endif -%}
				{% if use_aspect_mobile_class and media_type != 'iframe_video' %} banner__inner--aspect-mobile{%- endif -%}
			{%- endcapture -%}

			{%- capture banner_full_size -%}
				<div class="{{- banner_wrapper_classes | strip_newlines -}}" style="{{- banner_wrapper_styles | strip_newlines -}}">
					{%- if banner_media != blank -%}
						<div class="{{- media_wrapper_classes | strip_newlines -}}">
							{{- banner_media -}}
						</div>
					{%- endif -%}

					{%- if banner_content != blank -%}
						<div class="banner__inner {% if image_desktop != blank %}js-banner-inner{% endif %} {{ aspect_ratio_class | strip_newlines }}">
							{{- banner_content -}}
						</div>
					{%- endif -%}
				</div>
			{%- endcapture -%}

			{%- case block.type -%}
				{%- when 'full_width' -%}
				{{- banner_full_size -}}
				{%- when 'two_columns' -%}
				{%- assign media_content_position 	= block.settings.media_content_position -%}

				{%- capture banner_two_cols -%}
					{%- case media_content_position -%}
						{%- when 'first' -%}
							{%- if banner_media != blank -%}
								<div class="banner__col banner__col--media">
									<div class="{{ media_wrapper_classes | strip_newlines }}">
										{{- banner_media -}}
									</div>
								</div>
							{%- endif -%}

							<div class="banner__col banner__col--text">
								{{- banner_content -}}
							</div>
						{%- when 'last' -%}
							<div class="banner__col banner__col--text">
								{{- banner_content -}}
							</div>

							{%- if banner_media != blank -%}
								<div class="banner__col banner__col--media">
									<div class="{{ media_wrapper_classes | strip_newlines }}">
										{{- banner_media -}}
									</div>
								</div>
							{%- endif -%}
					{%- endcase -%}
				{%- endcapture -%}

				<div class="{{- banner_wrapper_classes | strip_newlines -}}" style="{{- banner_wrapper_styles | strip_newlines -}}">
					{{- banner_two_cols -}}

					{% if ellipse_color != blank %}
						<span class="banner__ellipse banner__ellipse--left" style="--ellipse-color: {{ ellipse_color }};"></span>
						<span class="banner__ellipse banner__ellipse--right" style="--ellipse-color: {{ ellipse_color }};"></span>
					{% endif %}
				</div>
			{%- endcase -%}
		{%- endfor -%}
	{%- endif -%}
{%- endcapture -%}

{%- if banner != blank -%}
	{%- render 'adastra' with '/src/styles/banner.scss' -%}

	{%- style -%}
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_mobile -}}px;
			padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
		}

		@media screen and (min-width: 768px) {
			#shopify-section-{{- section.id -}} {
				padding-top: {{- section.settings.offset_top_desktop -}}px;
				padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
			}
		}
	{%- endstyle -%}

	{%- if container_width == '100%' -%}
		{% assign full_width_class = "banner--full-width" %}
	{%- endif -%}

	{% if section.blocks[0].type == 'full_width' and template.name == 'index' %}
		{% assign allow_transparent_header = true %}
	{% endif %}

	{%- if section.blocks[0].type == 'two_columns' and section.blocks[0].settings.image_decor != blank  -%}
		{%- assign has_mouse_move_animation = true -%}
	{%- else -%}
		{%- assign has_mouse_move_animation = false -%}
	{% endif %}

	<section class="banner {% if allow_transparent_header %}allow-transparent-header{% endif %} {{ full_width_class }} need-animate js-banner js-animate {% if has_mouse_move_animation == true %} js-image-mouse-move-wrapper {% endif %} {% if request.visual_preview_mode or section.index == 1 %}animated{% endif %}" style="{{- section_styles | strip_newlines -}}">
		{{- banner -}}
	</section>

	{%- if is_script_needed == true -%}
		{%- render 'adastra' with '/src/scripts/section-banner.js' -%}
	{%- endif -%}
{%- endif -%}

{%- schema -%}
{
	"name": "Banner",
	"max_blocks": 1,
	"disabled_on": {
		"groups": ["header", "footer", "custom.popup"]
	},
	"settings": [
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "color",
			"id": "section_background",
			"label": "Section background",
			"default": "#222222"
		},
		{
			"type": "color_background",
			"id": "content_background",
			"label": "Text content background",
			"info": "This setting works with 'Full width' banner.",
			"default": "rgba(255,255,255, 0.2)"
		},
		{
			"type": "checkbox",
			"id": "enable_glass_effect",
			"label": "Enable glass effect",
			"default": true,
			"info": "This setting works with 'Full width' banner."
		},
		{
			"type": "color",
			"id": "text_color",
			"label": "Text",
			"default": "#FFFFFF"
		},
		{
			"type": "color",
			"id": "link_color",
			"label": "Link",
			"default": "#FFFFFF",
			"info": "Color of the links inside a richtext"
		},
		{
			"type": "color_background",
			"id": "button_background",
			"label": "Button background",
			"default": "#ffffff1f"
		},
		{
			"type": "color",
			"id": "button_color",
			"label": "Button label",
			"default": "#fff"
		},
		{
