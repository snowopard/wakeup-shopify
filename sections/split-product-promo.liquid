{%- comment -%}
------------------------------------------------------------------------------
	Section: Split product promo
------------------------------------------------------------------------------
{%- endcomment -%}

{%- render 'adastra' with '/src/styles/split-product-promo.scss' -%}

{%- assign offset_top_desktop 		= section.settings.offset_top_desktop -%}
{%- assign offset_bottom_desktop 	= section.settings.offset_bottom_desktop -%}
{%- assign offset_top_mobile 		= section.settings.offset_top_mobile -%}
{%- assign offset_bottom_mobile 	= section.settings.offset_bottom_mobile -%}
{%- assign heading 					= section.settings.heading -%}
{%- assign container 				= section.settings.container_width -%}

{% if container == 'inherit' %}
	{% assign container_width = settings.container_width %}
{% else %}
	{% assign container_width = container %}
{% endif %}

{%- capture section_styles -%}
	--container-width: {{ container_width }}; {{- -}}
{%- endcapture -%}

{%- style -%}
	#shopify-section-{{- section.id -}} {
		padding-top: {{- offset_top_mobile -}}px;
		padding-bottom: {{- offset_bottom_mobile -}}px;
	}

	@media screen and (min-width: 992px) {
		#shopify-section-{{- section.id -}} {
			padding-top: {{- offset_top_desktop -}}px;
			padding-bottom: {{- offset_bottom_desktop -}}px;
		}
	}
{%- endstyle -%}

<section
	class="split-product-promo js-animate {% if request.visual_preview_mode or section.index == 1 %}animated{% endif %} need-animate"
	style="{{- section_styles -}}"
>
	<div class="container">
		{% if heading != blank %}
			<h2 class="split-product-promo__title h2 need-animate">{{ heading }}</h2>
		{% endif %}

		<div class="split-product-promo__wrapper">
			{%- for block in section.blocks -%}
				{%- assign product 				= block.settings.promo_product -%}
				{%- assign image 				= block.settings.image_desktop -%}
				{%- assign heading 				= block.settings.heading -%}
				{%- assign text 				= block.settings.text -%}
				{%- assign button_label 		= block.settings.button_label -%}
				{%- assign button_link 			= block.settings.button_link -%}

				{%- assign color_image_overlay 	= block.settings.color_image_overlay -%}
				{%- assign color_text 			= block.settings.color_text -%}
				{%- assign heading_bg 			= block.settings.heading_bg -%}
				{%- assign product_bg 			= block.settings.product_bg -%}
				{%- assign product_button_bg 	= block.settings.product_button_bg -%}
				{%- assign product_button_icon 	= block.settings.product_button_icon -%}

				{% liquid
					assign show_button = false

					if button_label != blank and button_link != blank
						assign show_button = true
					endif
				%}

				{%- capture img_focal -%}
					--img-pos: {{ image.presentation.focal_point }};
				{%- endcapture -%}

				{%- capture block_styles -%}
					--image-overlay: {{- color_image_overlay -}}; {{-  -}}
					--text-color: {{- color_text -}}; {{-  -}}
					--heading-bg: {{- heading_bg -}}; {{-  -}}
					--product-bg: {{- product_bg -}}; {{-  -}}
					--product-button-bg: {{- product_button_bg -}}; {{-  -}}
					--product-button-icon: {{- product_button_icon -}}; {{-  -}}
				{%- endcapture -%}

				{% liquid
					assign is_lazy = true

					if section.index == 1 and forloop.first
						assign is_lazy = false
					endif
				%}

				<div class="split-product-promo__item{% if section.blocks.size == 1 %} split-product-promo__item-wide{% endif %}"
					style="{{- block_styles | strip_newlines -}}"
				>
					{%- if image != blank -%}
						{%- capture img_focal -%}
							--img-pos: {{ image.presentation.focal_point }};
						{%- endcapture -%}

						{% liquid
							if section.blocks.size == 1
								assign image_420_height = 229
								assign image_768_height = 414
								assign image_991_height = 540
								assign image_1199_height = 657
								assign image_1600_height = 833

								assign image_1199_width = 1167
								assign image_1600_width = 1480

								assign image_default_width = 1800
								assign image_default_height = 1013
							else
								assign image_420_height = 388
								assign image_768_height = 736
								assign image_991_height = 959
								assign image_1199_height = 584
								assign image_1600_height = 736

								assign image_1199_width = 584
								assign image_1600_width = 740

								assign image_default_width = 900
								assign image_default_height = 900
							endif

							assign image_1199_width_2x = image_1199_width | times: 2
							assign image_1600_width_2x = image_1600_width | times: 2
							assign image_default_width_2x = image_default_width | times: 2
						%}

						<picture {% if is_lazy %}class="lazy"{% endif %}>
							<source
								{% if is_lazy %}
									data-srcset="{{ image | image_url: width: 388 }} 1x, {{ image | image_url: width: 776 }} 2x"
									srcset="{{ image | image_url: width: 10 }} 1x, {{ image | image_url: width: 10 }} 2x"
								{% else %}
									srcset="{{ image | image_url: width: 388 }} 1x, {{ image | image_url: width: 776 }} 2x"
								{% endif %}
								media="(max-width: 420px)"
								width="388"
								height="{{ image_420_height }}"
							>

							<source
								{% if is_lazy %}
									data-srcset="{{ image | image_url: width: 736 }} 1x, {{ image | image_url: width: 1472 }} 2x"
									srcset="{{ image | image_url: width: 10 }} 1x, {{ image | image_url: width: 10 }} 2x"
								{% else %}
									srcset="{{ image | image_url: width: 736 }} 1x, {{ image | image_url: width: 1472 }} 2x"
								{% endif %}
								media="(max-width: 768px)"
								width="736"
								height="{{ image_768_height }}"
							>

							<source
								{% if is_lazy %}
									data-srcset="{{ image | image_url: width: 959 }} 1x, {{ image | image_url: width: 1918 }} 2x"
									srcset="{{ image | image_url: width: 10 }} 1x, {{ image | image_url: width: 10 }} 2x"
								{% else %}
									srcset="{{ image | image_url: width: 959 }} 1x, {{ image | image_url: width: 1918 }} 2x"
								{% endif %}
								media="(max-width: 991px)"
								width="959"
								height="{{ image_991_height }}"
							>

							<source
								{% if is_lazy %}
									data-srcset="{{ image | image_url: width: image_1199_width }} 1x, {{ image | image_url: width: image_1199_width_2x }} 2x"
									srcset="{{ image | image_url: width: 10 }} 1x, {{ image | image_url: width: 10 }} 2x"
								{% else %}
									srcset="{{ image | image_url: width: image_1199_width }} 1x, {{ image | image_url: width: image_1199_width_2x }} 2x"
								{% endif %}
								media="(max-width: 1199px)"
								width="{{ image_1199_width }}"
								height="{{ image_1199_height }}"
							>

							<source
								{% if is_lazy %}
									data-srcset="{{ image | image_url: width: image_1600_width }} 1x, {{ image | image_url: width: image_1600_width_2x }} 2x"
									srcset="{{ image | image_url: width: 10 }} 1x, {{ image | image_url: width: 10 }} 2x"
								{% else %}
									srcset="{{ image | image_url: width: image_1600_width }} 1x, {{ image | image_url: width: image_1600_width_2x }} 2x"
								{% endif %}
								media="(max-width: 1600px)"
								width="{{ image_1600_width }}"
								height="{{ image_1600_height }}"
							>

							<img
								class="split-product-promo__image"
								{% if is_lazy %}
									data-srcset="{{ image | image_url: width: image_default_width }} 1x, {{ image | image_url: width: image_default_width_2x }} 2x"
									srcset="{{ image | image_url: width: 10 }} 1x, {{ image | image_url: width: 10 }} 2x"
									data-src="{{ image | image_url: width: image_default_width }}"
									src="{{ image | image_url: width: 10 }}"
								{% else %}
									srcset="{{ image | image_url: width: image_default_width }} 1x, {{ image | image_url: width: image_default_width_2x }} 2x"
									src="{{- image | image_url: width: image_default_width -}}"
								{% endif %}
								alt="{{- image.alt | escape -}}"
								width="{{ image_default_width }}"
								height="{{ image_default_height }}"
								style="{{ img_focal }}"
							>
						</picture>
					{%- else -%}
						{%- assign placeholder_index = forloop.index0 | modulo: 2 | plus: 1 -%}
						{%- assign placeholer_svg_name = 'hero-apparel-' | append: placeholder_index -%}

						{{- placeholer_svg_name | placeholder_svg_tag: 'split-product-promo__image' -}}
					{%- endif -%}

					<div class="split-product-promo__overlay"></div>

					{%- if show_button or text != blank or heading !=blank -%}
						<div class="split-product-promo__content">
							{%- if heading != blank -%}
								<h2 class="split-product-promo__heading" aria-hidden="true">
									{{- heading -}}
								</h2>
							{%- endif -%}

							<div class="split-product-promo__content-hover">
								{%- if heading != blank -%}
									<h2 class="split-product-promo__hover-heading">
										{{- heading -}}
									</h2>
								{%- endif -%}

								{%- if text != blank -%}
									<div class="split-product-promo__description rte">
										{{- text -}}
									</div>
								{%- endif -%}

								{%- if show_button -%}
									<div class="split-product-promo__button-wrapper">
										<a href="{{- button_link -}}" class="focus-visible-outline split-product-promo__button">
											<span class="button__text">
												{{- button_label -}}
											</span>

											<span class="button__icon">
												{%- render 'icons', icon: 'slider-arrow-right' -%}
											</span>
										</a>
									</div>
								{%- endif -%}
							</div>
						</div>
					{%- endif -%}

					{%- if product != blank -%}
						{%- assign product_image = product.selected_or_first_available_variant.image | default: product.featured_image -%}

						<div class="split-product-promo__product">
							<a class="focus-visible-outline split-product-promo__product-image-wrapper" href="{{- product.url -}}" aria-label="{{- product.title | escape -}}">
								<img
									class="split-product-promo__product-image"
									src="{{ product_image | image_url: width: 55, height: 85 }}"
									srcset="{{ product_image | image_url: width: 55, height: 85 }} 1x, {{ product_image | image_url: width: 110, height: 170 }} 2x"
									alt="{{ product_image.alt | escape }}"
									loading="lazy"
									width="55"
									height="85"
								>
							</a>

							<div class="split-product-promo__product-body">
								<div class="split-product-promo__product-content">
									<a class="focus-visible-outline split-product-promo__product-content-title" href="{{- product.url -}}">
										{{- product.title -}}
									</a>

									<div class="split-product-promo__product-content-price">
										{% render 'price', product: product %}
									</div>
								</div>

								<a class="focus-visible-outline split-product-promo__product-button" href="{{- product.url -}}" aria-label="{{- product.title | escape -}}">
									{%- render 'icons', icon: 'plus' -%}
								</a>
							</div>
						</div>
					{%- endif -%}
				</div>
			{%- endfor -%}
		</div>
	</div>
</section>

{%- schema -%}
{
	"name": "Split product promo",
	"max_blocks": 2,
	"disabled_on": {
		"groups": [
			"header",
			"footer",
			"custom.popup"
		]
	},
	"settings": [
		{
			"type": "text",
			"id": "heading",
			"label": "Heading"
		},
		{
			"type": "select",
			"id": "container_width",
			"label": "Container width",
			"options": [
				{
					"value": "1560px",
					"label": "Default - 1440px"
				},
				{
					"value": "2040px",
					"label": "Large - 1920px"
				},
				{
					"value": "100%",
					"label": "Full width"
				},
				{
					"value": "inherit",
					"label": "Inherit of general setting"
				}
			],
			"default": "inherit",
			"info": "If you select 'Inherit of general setting', then container width will be used from the Theme settings/Layout"
		},
		{
			"type": "range",
			"id": "offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset top",
			"default": 50
		},
		{
			"type": "range",
			"id": "offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset bottom",
			"default": 50
		},
		{
			"type": "range",
			"id": "offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset top",
			"default": 25
		},
		{
			"type": "range",
			"id": "offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset bottom",
			"default": 25
		}
	],
	"blocks": [
		{
			"type": "banner",
			"name": "Banner",
			"settings": [
				{
					"type": "product",
					"id": "promo_product",
					"label": "Product"
				},
				{
					"type": "image_picker",
					"id": "image_desktop",
					"label": "Image",
					"info": "1400 x 790px recommended"
				},
				{
					"type": "text",
					"id": "heading",
					"label": "Banner heading",
					"default": "Banner heading"
				},
				{
					"type": "richtext",
					"id": "text",
					"label": "Text",
					"default": "<p>Description for your banner</p>",
					"info": "Only visible on hover"
				},
				{
					"type": "text",
					"id": "button_label",
					"label": "Button label",
					"default": "Shop collection",
					"info": "Only visible on hover"
				},
				{
					"type": "url",
					"id": "button_link",
					"label": "Button link",
					"info": "Only visible on hover"
				},
				{
					"type": "header",
					"content": "Colors"
				},
				{
					"type": "color",
					"id": "color_image_overlay",
					"label": "Image overlay",
					"alpha": true,
					"default": "#0000000A"
				},
				{
					"type": "color",
					"id": "color_text",
					"label": "Text",
					"default": "#ffffff"
				},
				{
					"type": "color",
					"id": "heading_bg",
					"label": "Heading background",
					"alpha": true,
					"default": "#ffffff33"
				},
				{
					"type": "color",
					"id": "product_bg",
					"label": "Product card background",
					"default": "#212121"
				},
				{
					"type": "color",
					"id": "product_button_bg",
					"label": "Product card button background",
					"default": "#ffffff"
				},
				{
					"type": "color",
					"id": "product_button_icon",
					"label": "Product card button icon",
					"default": "#212121"
				}
			]
		}
	],
	"presets": [
		{
			"name": "Split product promo",
			"blocks": [
				{
					"type": "banner",
					"settings": {
						"button_label": "Button label",
						"button_link": "/"
					}
				},
				{
					"type": "banner",
					"settings": {
						"button_label": "Button label",
						"button_link": "/"
					}
				}
			]
		}
	]
}
{%- endschema -%}
