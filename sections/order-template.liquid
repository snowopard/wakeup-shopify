{%- comment -%}
------------------------------------------------------------------------------
	Section: Order template
------------------------------------------------------------------------------
{%- endcomment -%}

{%- render "adastra" with "/src/styles/account-entrance.scss" -%}
{%- render "adastra" with "/src/styles/order-item-details.scss" -%}

{%- style -%}
	#shopify-section-{{- section.id -}} {
		padding-top: {{- section.settings.offset_top_mobile -}}px;
		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
	}

	@media screen and (min-width: 768px) {
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_desktop -}}px;
			padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
		}
	}
{%- endstyle -%}

{%- assign show_unit_price = settings.is_show_unit_price -%}

{%- assign enable_bottom_rounded_corners    = section.settings.enable_bottom_rounded_corners -%}
{%- assign color_scheme      	           	= section.settings.color_scheme -%}
{%- assign enable_color_scheme_inheritance 	= section.settings.enable_color_scheme_inheritance -%}

{%- if enable_color_scheme_inheritance -%}
	{%- assign color_scheme = settings.main_color_scheme -%}
{%- endif -%}

{%- assign color_text_opacity_12 = color_scheme.settings.color_text_primary | color_modify: 'alpha', 0.12 -%}
{%- assign color_text_opacity_20 = color_scheme.settings.color_text_primary | color_modify: 'alpha', 0.2 -%}
{%- assign color_text_opacity_08 = color_scheme.settings.color_text_primary | color_modify: 'alpha', 0.08 -%}

{%- assign min = 1 -%}
{%- assign max = 6 -%}
{%- assign diff = max | minus: min -%}

{%- capture styles -%}
	--color-text-opacity-20: {{- color_text_opacity_20 -}}; {{- -}}
	--color-text-opacity-12: {{- color_text_opacity_12 -}}; {{- -}}
	--color-text-opacity-8: {{- color_text_opacity_08 -}}; {{- -}}
{%- endcapture -%}

<section class="account-entrance color-{{ color_scheme }}{% if enable_bottom_rounded_corners %} section-bottom-rounded{% endif %} js-animate" style="{{- styles -}}">
	<div class="account-entrance__container account-entrance__container--large">
		<div class="account-entrance__body">
			<a class="focus-visible-outline account-entrance__return" href="{{- routes.account_url -}}">
				{%- render 'icons', icon: 'slider-arrow-left' -%}

				<span class="button-link">
					{{- 'customer.account.return' | t -}}
				</span>
			</a>

			<div class="account-entrance__row account-entrance__row--date">
				<h2 class="account-entrance__order-title need-animate">{{ 'customer.order.title' | t: name: order.name }}</h2>

				{%- assign order_date = order.created_at | date: "%B %d, %Y %I:%M%p" -%}
				<p class="account-entrance__order-date">{{ 'customer.order.date' | t: date: order_date }}</p>
			</div>

			{%- if order.cancelled -%}
				<div class="order--cancelled">
					{%- assign cancelled_at = order.cancelled_at | date: "%B %d, %Y %I:%M%p" -%}
					<p>{{ 'customer.order.cancelled' | t: date: cancelled_at }}</p>
					<p>{{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason }}</p>
				</div>
			{%- endif -%}

			<table class="account-entrance__table account-entrance__table--desktop responsive-table">
				<thead>
				<tr>
					<th class="column-large">{{ 'customer.order.product' | t }}</th>
					<th class="responsive-table__sku">{{ 'customer.order.sku' | t }}</th>
					<th class="responsive-table__price">{{ 'customer.order.price' | t }}</th>
					<th class="responsive-table__quantity">{{ 'customer.order.quantity' | t }}</th>
					<th class="responsive-table__total">{{ 'customer.order.total' | t }}</th>
				</tr>
				</thead>

				<tbody>
				{%- for line_item in order.line_items -%}
					<tr id="{{ line_item.key }}" class="responsive-table__row">
						<td class="column-large">
							<span class="responsive-table__links">
								<a class="focus-visible-outline responsive-table__link"
								   href="{{- line_item.product.url -}}">
									{% if line_item.image != blank %}
										{% assign item_image = line_item.image %}
									{% else %}
										{% assign item_image = settings.product_default_image %}
									{% endif %}

									<span class="responsive-table__image-wrapper">
										{% if item_image != blank %}
											<picture>
												<img
													class="responsive-table__image"
													src="{{- item_image | image_url: width: 80, height: 80 -}}"
													srcset="{{ item_image | image_url: width: 80, height: 80 }} 1x,
															{{ item_image | image_url: width: 160, height: 160 }} 2x"
													alt="{{- item_image.alt -}}"
													width="80"
													height="80"
												/>
											</picture>
										{% else %}
											{%- assign random_number = "now" | date: "%N" | modulo: diff | plus: min -%}
											{%- assign placeholder_svg_name = 'product-' | append: random_number -%}

											{{ placeholder_svg_name | placeholder_svg_tag: "responsive-table__image responsive-table__image--placeholder" }}
										{% endif %}
									</span>
								</a>

								<span>
									<a class="focus-visible-outline responsive-table__link"
									   href="{{- line_item.product.url -}}">
										<span>
											{{- line_item.title | split: '-' | first -}}
										</span>
									</a>

									{%- assign variant_title = line_item.variant.title -%}

									<span class="responsive-table__product-options">
										{%- for option_with_value in line_item.options_with_values -%}
										{% assign option_name = option_with_value.name %}
										{% assign option_value = option_with_value.value %}

										{%- if option_name != blank and option_name != 'Default Title' -%}
											<span class="responsive-table__product-option">
												<span class="responsive-table__product-option-name">{{- option_name -}}:</span>
												<span class="responsive-table__product-option-value">{{- option_value -}}</span>
											</span>
										{%- endif -%}
										{%- endfor -%}
									</span>

									{% capture order_status %}
										{% if order.financial_status == 'paid' %}
											responsive-table__order-status--paid
										{% elsif order.financial_status == 'fulfilled' %}
											responsive-table__order-status--fulfilled
										{% endif %}
									{% endcapture %}

									<span class="responsive-table__order-status {{ order_status | strip_newlines }}">
										{{- order.financial_status_label -}}
									</span>

									{%- assign property_size = line_item.properties | size -%}

									{%- unless line_item.selling_plan_allocation == nil and property_size == 0 -%}
										<ul class="account-entrance__order-detail-properties">
											{%- unless line_item.selling_plan_allocation == nil -%}
												<li>
													{{- line_item.selling_plan_allocation.selling_plan.name -}}
												</li>
											{%- endunless -%}

											{%- if property_size != 0 -%}
												{%- for property in line_item.properties -%}
													{% assign property_first_char = property.first | slice: 0 %}

													{%- if property.last != blank and property_first_char != '_' -%}
														<li>
															{{- property.first -}}:&nbsp;

															{%- if property.last contains '/uploads/' -%}
																<a class="focus-visible-outline"
																   href="{{- property.last -}}">
																	{{- property.last | split: '/' | last -}}
																</a>
															{%- else -%}
																{{- property.last -}}
															{%- endif -%}
														</li>
													{%- endif -%}
												{%- endfor -%}
											{%- endif -%}
										</ul>
									{%- endunless -%}

									{%- if line_item.line_level_discount_allocations != blank -%}
										<ul class="account-entrance__discount-list" role="list"
											aria-label="{{ 'customer.order.discount' | t | escape }}">
											{%- for discount_allocation in line_item.line_level_discount_allocations -%}
												<li class="account-entrance__discount-list-item">
													{% render 'icons', icon: 'discount' %} {{- discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money -}})
												</li>
											{%- endfor -%}
										</ul>
									{%- endif -%}

									{%- if line_item.fulfillment -%}
										<div class="account-entrance__order-detail-note">
											{{- 'customer.order.fulfilled_at' | t -}}
										</div>
									{%- endif -%}
								</span>
							</span>
						</td>

						<td class="responsive-table__sku"
							data-label="{{ 'customer.order.sku' | t }}">{{ line_item.sku }}</td>

						<td class="responsive-table__price" data-label="{{ 'customer.order.price' | t }}">
							{%- if line_item.original_price != line_item.final_price or line_item.unit_price_measurement -%}
								<dl>
									{%- if line_item.original_price != line_item.final_price -%}
										<dt>
											<span
												class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
										</dt>
										<dd class="regular-price">
											<s>{{ line_item.original_price | money }}</s>
										</dd>
										<dt>
											<span
												class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
										</dt>
										<dd>
											<span>{{ line_item.final_price | money }}</span>
										</dd>
									{%- else -%}
										<dt>
											<span
												class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
										</dt>
										<dd>
											{{ line_item.original_price | money }}
										</dd>
									{%- endif -%}
									{% if line_item.unit_price_measurement %}
										<dt>
											<span
												class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
										</dt>
										<dd>
											<small>
												{{ line_item.unit_price | money }}

												<span aria-hidden="true">
													{{ 'general.accessibility.unit_price_separator' | t }}
												</span>

												{%- if line_item.unit_price_measurement.reference_value != 1 -%}
													{{ line_item.unit_price_measurement.reference_value }}
												{%- endif -%}

												{%- if line_item.unit_price_measurement.reference_unit == 'item' %}
													{{ 'products.product.unit_price.item' | t -}}
												{%- else -%}
													{{ line_item.unit_price_measurement.reference_unit }}
												{%- endif -%}
											</small>
										</dd>
									{% endif %}
								</dl>
							{%- else -%}
								<span>{{ line_item.final_price | money }}</span>
							{%- endif -%}
						</td>

						<td class="responsive-table__quantity" data-label="{{ 'customer.order.quantity' | t }}">
							{{ line_item.quantity }}
						</td>

						<td class="responsive-table__total" data-label="{{ 'customer.order.total' | t }}">
							{%- if line_item.original_line_price != line_item.final_line_price -%}
								<dl>
									<dt>
										<span
											class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
									</dt>
									<dd class="regular-price">
										<s>{{ line_item.original_line_price | money }}</s>
									</dd>
									<dt>
										<span
											class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
									</dt>
									<dd>
										<span>{{ line_item.final_line_price | money }}</span>
									</dd>
								</dl>
							{%- else -%}
								{{ line_item.original_line_price | money }}
							{%- endif -%}
						</td>
					</tr>
				{%- endfor -%}
				</tbody>

				<tfoot>
				<tr class="responsive-table__row">
					<td colspan="4" class="responsive-table__small-hide">{{ 'customer.order.subtotal' | t }}</td>
					<td data-label="{{ 'customer.order.subtotal' | t }}">{{ order.line_items_subtotal_price | money }}</td>
				</tr>

				{% for discount_application in order.cart_level_discount_applications %}
					<tr>
						<td colspan="4" class="responsive-table__small-hide">{{ 'customer.order.discount' | t }}</td>
						<td data-label="{{ 'customer.order.discount' | t }}">
							-{{ discount_application.total_allocated_amount | money }}

							{% if discount_application.title != blank %}
								<span
									class="account-entrance__order-summary-discount">{% render 'icons', icon: 'discount' %} {{ discount_application.title }}</span>
							{% endif %}
						</td>
					</tr>
				{% endfor %}

				{%- for shipping_method in order.shipping_methods -%}
					<tr>
						<td colspan="4" class="responsive-table__small-hide">{{ 'customer.order.shipping' | t }}
							({{ shipping_method.title }}):
						</td>
						<td data-label="{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})">{{ shipping_method.price | money }}</td>
					</tr>
				{%- endfor -%}

				{%- for tax_line in order.tax_lines -%}
					<tr>
						<td colspan="4" class="responsive-table__small-hide">{{ 'customer.order.tax' | t }}
							({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%):
						</td>
						<td data-label="{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)">{{ tax_line.price | money }}</td>
					</tr>
				{%- endfor -%}

				<tr>
					<td colspan="4" class="responsive-table__small-hide">{{- 'customer.order.total' | t -}}:</td>
					<td data-label="{{ 'customer.order.total' | t }}">{{ order.total_net_amount | money }}</td>
				</tr>
				</tfoot>
			</table>

			<div class="account-entrance__table account-entrance__table--mobile">
				<div class="account-entrance__order-items">
					{%- for line_item in order.line_items -%}
						<div class="order-item-details">
							<div class="order-item-details__image-col">
								<a class="focus-visible-outline order-item-details__image-link"
								   href="{{- line_item.product.url -}}">
									{% if line_item.image != blank %}
										{% assign item_image = line_item.image %}
									{% else %}
										{% assign item_image = settings.product_default_image %}
									{% endif %}

									<span class="order-item-details__image-wrapper">
										{% if item_image != blank %}
											<picture>
												<img
													class="order-item-details__image"
													src="{{- item_image | image_url: width: 80, height: 80 -}}"
													srcset="{{ item_image | image_url: width: 80, height: 80 }} 1x, {{ item_image | image_url: width: 160, height: 160 }} 2x"
													alt="{{- item_image.alt -}}"
													width="80"
													height="80"
												/>
											</picture>
										{% else %}
											{%- assign random_number = "now" | date: "%N" | modulo: diff | plus: min -%}
											{%- assign placeholder_svg_name = 'product-' | append: random_number -%}

											{{ placeholder_svg_name | placeholder_svg_tag: "order-item-details__image order-item-details__image--placeholder" }}
										{% endif %}
								</span>
								</a>
							</div>

							<div class="order-item-details__content-col">
								<a class="focus-visible-outline order-item-details__link"
								   href="{{- line_item.product.url -}}">
									{{- line_item.title | split: '-' | first -}}
								</a>

								{%- assign variant_title = line_item.variant.title -%}

								{%- if variant_title != blank and variant_title != 'Default Title' -%}
									<div class="order-item-details__variant-title">
										{{- variant_title -}}
									</div>
								{%- endif -%}

								{% capture order_status %}
									{% if order.financial_status == 'paid' %}
										order-item-details__order-status--paid
									{% elsif order.financial_status == 'fulfilled' %}
										order-item-details__order-status--fulfilled
									{% endif %}
								{% endcapture %}

								<span class="order-item-details__order-status {{ order_status | strip_newlines }}">
								{{- order.financial_status_label -}}
							</span>

								{%- assign property_size = line_item.properties | size -%}

								{%- unless line_item.selling_plan_allocation == nil and property_size == 0 -%}
									<ul class="order-item-details__properties">
										{%- unless line_item.selling_plan_allocation == nil -%}
											<li>
												{{- line_item.selling_plan_allocation.selling_plan.name -}}
											</li>
										{%- endunless -%}

										{%- if property_size != 0 -%}
											{%- for property in line_item.properties -%}
												{% assign property_first_char = property.first | slice: 0 %}

												{%- if property.last != blank and property_first_char != '_' -%}
													<li>
														{{- property.first -}}:&nbsp;

														{%- if property.last contains '/uploads/' -%}
															<a class="focus-visible-outline"
															   href="{{- property.last -}}">
																{{- property.last | split: '/' | last -}}
															</a>
														{%- else -%}
															{{- property.last -}}
														{%- endif -%}
													</li>
												{%- endif -%}
											{%- endfor -%}
										{%- endif -%}
									</ul>
								{%- endunless -%}

								{%- if line_item.line_level_discount_allocations != blank -%}
									<ul class="order-item-details__discount-list" role="list"
										aria-label="{{- 'customer.order.discount' | t | escape -}}">
										{%- for discount_allocation in line_item.line_level_discount_allocations -%}
											<li class="order-item-details__discount-list-item">
												{%- render 'icons', icon: 'discount' -%} {{- discount_allocation.discount_application.title }}
												(-{{ discount_allocation.amount | money -}})
											</li>
										{%- endfor -%}
									</ul>
								{%- endif -%}

								{%- if line_item.fulfillment -%}
									<div class="order-item-details__note">
										{{- 'customer.order.fulfilled_at' | t -}}
									</div>
								{%- endif -%}

								<div class="order-item-details__item-price-info">
									<div>
										<span>{{- 'customer.order.sku' | t -}}</span>

										<span>{{- line_item.sku -}}</span>
									</div>

									<div>
										<span>{{- 'customer.order.price' | t -}}</span>

										{%- if line_item.original_price != line_item.final_price or line_item.unit_price_measurement -%}
											<dl>
												{%- if line_item.original_price != line_item.final_price -%}
													<dt>
													<span class="visually-hidden">
														{{- 'products.product.price.regular_price' | t -}}
													</span>
													</dt>

													<dd class="regular-price">
														<s>{{- line_item.original_price | money -}}</s>
													</dd>

													<dt>
													<span class="visually-hidden">
														{{- 'products.product.price.sale_price' | t -}}
													</span>
													</dt>

													<dd>
														<span>{{- line_item.final_price | money -}}</span>
													</dd>
												{%- else -%}
													<dt>
													<span class="visually-hidden">
														{{- 'products.product.price.regular_price' | t -}}
													</span>
													</dt>

													<dd>
														{{- line_item.original_price | money -}}
													</dd>
												{%- endif -%}

												{%- if line_item.unit_price_measurement -%}
													<dt>
													<span class="visually-hidden">
														{{- 'products.product.price.unit_price' | t -}}
													</span>
													</dt>

													<dd>
														<small>
															{{ line_item.unit_price | money }}

															<span aria-hidden="true">
																{{ 'general.accessibility.unit_price_separator' | t }}
															</span>

															{%- if line_item.unit_price_measurement.reference_value != 1 -%}
																{{ line_item.unit_price_measurement.reference_value }}
															{%- endif -%}

															{%- if line_item.unit_price_measurement.reference_unit == 'item' -%}
																{{ 'products.product.unit_price.item' | t }}
															{%- else -%}
																{{ line_item.unit_price_measurement.reference_unit }}
															{%- endif -%}
														</small>
													</dd>
												{%- endif -%}
											</dl>
										{%- else -%}
											<span>{{- line_item.final_price | money -}}</span>
										{%- endif -%}
									</div>

									<div>
										<span>{{- 'customer.order.quantity' | t -}}</span>

										<span>{{- line_item.quantity -}}</span>
									</div>

									<div>
										<span>{{- 'customer.order.total' | t -}}</span>

										{%- if line_item.original_line_price != line_item.final_line_price -%}
											<dl>
												<dt>
												<span class="visually-hidden">
													{{- 'products.product.price.regular_price' | t -}}
												</span>
												</dt>

												<dd class="regular-price">
													<s>{{- line_item.original_line_price | money -}}</s>
												</dd>

												<dt>
												<span class="visually-hidden">
													{{- 'products.product.price.sale_price' | t -}}
												</span>
												</dt>

												<dd>
													<span>{{- line_item.final_line_price | money -}}</span>
												</dd>
											</dl>
										{%- else -%}
											<span>{{- line_item.original_line_price | money -}}</span>
										{%- endif -%}
									</div>
								</div>
							</div>
						</div>
					{%- endfor -%}
				</div>

				<div class="account-entrance__order-total">
					<div>
					<span>
						{{- 'customer.order.subtotal' | t -}}
					</span>

						<span>
						{{- order.line_items_subtotal_price | money -}}
					</span>
					</div>

					{%- for discount_application in order.cart_level_discount_applications -%}
						<div>
						<span>
							{{- 'customer.order.discount' | t -}}
						</span>

							<span>
							-{{- discount_application.total_allocated_amount | money -}}

								{%- if discount_application.title != blank -%}
									<span>
									{%- render 'icons', icon: 'discount' -%} {{- discount_application.title -}}
								</span>
								{%- endif -%}
						</span>
						</div>
					{%- endfor -%}

					{%- for shipping_method in order.shipping_methods -%}
						<div>
						<span>
							{{- 'customer.order.shipping' | t }} ({{ shipping_method.title -}}):
						</span>

							<span>
							{{- shipping_method.price | money -}}
						</span>
						</div>
					{%- endfor -%}

					{%- for tax_line in order.tax_lines -%}
						<div>
						<span>
							{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%):
						</span>

							<span>
							{{- tax_line.price | money -}}
						</span>
						</div>
					{%- endfor -%}

					<div>
					<span>
						{{- 'customer.order.total' | t -}}
					</span>

						<span>
						{{- order.total_net_amount | money -}}
					</span>
					</div>
				</div>
			</div>

			<div class="account-entrance__row account-entrance__row--billings">
				<div class="account-entrance__billings">
					<h3 class="account-entrance__billings-heading">
						{{- 'customer.order.billing_address' | t -}}
					</h3>

					<p class="account-entrance__billings-status-wrapper">
						{{- 'customer.order.payment_status' | t -}}:

						{% capture order_status %}
							{% if order.financial_status == 'paid' %}
								account-entrance__billings-status--paid
							{% elsif order.financial_status == 'fulfilled' %}
								account-entrance__billings-status--fulfilled
							{% endif %}
						{% endcapture %}

						<span class="account-entrance__billings-status {{ order_status | strip_newlines }}">
							{{- order.financial_status_label -}}
						</span>
					</p>

					{{ order.billing_address | format_address }}
				</div>

				<div class="account-entrance__billings">
					<h3 class="account-entrance__billings-heading">
						{{- 'customer.order.shipping_address' | t -}}
					</h3>

					<p class="account-entrance__billings-status-wrapper">
						{{- 'customer.order.fulfillment_status' | t -}}:

						{% capture order_status %}
							{% if order.fulfillment_status == 'paid' %}
								account-entrance__billings-status--paid
							{% elsif order.fulfillment_status == 'fulfilled' %}
								account-entrance__billings-status--fulfilled
							{% endif %}
						{% endcapture %}

						<span class="account-entrance__billings-status {{ order_status | strip_newlines }}">
						{{- order.fulfillment_status_label -}}
					</span>
					</p>

					{{ order.shipping_address | format_address }}
				</div>
			</div>

			<a class="button-simple button-simple--primary button-simple--full-width account-entrance__return-button" href="{{- routes.account_url -}}">
				{{- 'customer.account.return' | t -}}
			</a>
		</div>
	</div>
</section>

{%- schema -%}
{
	"name": "Order template",
	"settings": [
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "checkbox",
			"id": "enable_bottom_rounded_corners",
			"label": "Enable bottom rounded corners",
			"info": "This setting rounds the inner bottom corners. If the section background is the same as the page background, the effect will not be visible. To see the rounded corners clearly, choose a section background color different from the page background.",
			"default": false
		},
		{
			"type": "range",
			"id": "offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset top",
			"default": 24
		},
		{
			"type": "range",
			"id": "offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset bottom",
			"default": 64
		},
		{
			"type": "range",
			"id": "offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset top",
			"default": 16
		},
		{
			"type": "range",
			"id": "offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset bottom",
			"default": 48
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "checkbox",
			"id": "enable_color_scheme_inheritance",
			"label": "Enable color scheme inheritance",
			"default": true,
			"info": "When this setting is enabled, the color scheme is inherited from the theme settings."
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"default": "scheme_1",
			"label": "Color scheme"
		}
	]
}
{%- endschema -%}
