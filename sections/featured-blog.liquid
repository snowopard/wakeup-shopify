{%- comment -%}
------------------------------------------------------------------------------
	Section: Featured blog
------------------------------------------------------------------------------
{%- endcomment -%}

{%- render 'adastra' with '/src/styles/featured-blog.scss' -%}

{%- style -%}
	#shopify-section-{{- section.id -}} {
		padding-top: {{- section.settings.offset_top_mobile -}}px;
		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
	}

	@media screen and (min-width: 768px) {
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_desktop -}}px;
			padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
		}
	}
{%- endstyle -%}

{%- assign current_article 					= article -%}
{%- assign blog 							= section.settings.blog | default: blog -%}
{%- assign heading_first_line 				= section.settings.heading_first_line -%}
{%- assign heading_second_line 				= section.settings.heading_second_line -%}
{%- assign link_url 						= section.settings.link_url -%}
{%- assign link_text 						= section.settings.link_text -%}
{%- assign link_aria_label_text 			= section.settings.link_aria_label_text -%}
{%- assign layout 							= section.settings.layout -%}
{%- assign container 						= section.settings.container_width -%}
{%- assign enable_bottom_rounded_corners   	= section.settings.enable_bottom_rounded_corners -%}
{%- assign enable_color_scheme_inheritance  = section.settings.enable_color_scheme_inheritance -%}
{%- assign color_scheme 				    = section.settings.color_scheme -%}

{%- if enable_color_scheme_inheritance -%}
	{%- assign color_scheme = settings.main_color_scheme -%}
{%- endif -%}

{% if container == 'inherit' %}
	{% assign container_width = settings.container_width %}
{% else %}
	{% assign container_width = container %}
{% endif %}

{%- if section.index == 1 -%}
	{%- assign remove_lazy = true -%}
{%- endif -%}

{%- assign is_layout_secondary = false -%}

{%- if layout == 'secondary' -%}
	{%- if blog == blank -%}
		{%- assign is_layout_secondary = true -%}
	{%- elsif blog and blog.articles.size > 2 -%}
		{%- assign is_layout_secondary = true -%}
	{%- endif -%}
{%- endif -%}

{%- capture section_styles -%}
	--container-width: {{ container_width }}; {{-  -}}
	--inner-offset-top: {{ section.settings.inner_offset_top_desktop }}px; {{- -}}
	--inner-offset-bottom: {{ section.settings.inner_offset_bottom_desktop }}px; {{- -}}
	--inner-offset-top-mobile: {{ section.settings.inner_offset_top_mobile }}px; {{- -}}
	--inner-offset-bottom-mobile: {{ section.settings.inner_offset_bottom_mobile }}px;
{%- endcapture -%}

{%- capture blog_posts -%}
	{%- if heading_first_line != blank and heading_second_line != blank -%}
		{%- assign delay_step = 0.5 -%}
	{%- elsif heading_first_line != blank or heading_second_line != blank -%}
		{%- assign delay_step = 0.25 -%}
	{%- else -%}
		{%- assign delay_step = 0 -%}
	{%- endif -%}

	<div class="featured-blog__row">
		{%- if is_layout_secondary -%}
			{%- assign article_class = 'article-card--small' -%}
			{%- assign w1600 = 314 -%}
			{%- assign w_default = 390 -%}
		{%- endif -%}

		{%- if blog and blog.articles.size > 0 -%}
			{% assign count = 0 %}

			{%- for article in blog.articles -%}
				{% if article.handle == current_article.handle %}
					{% continue %}
				{% endif %}

				{% if count == 3 %}
					{% break %}
				{% endif %}

				<div class="featured-blog__col need-animate" style="--delay-step: {{ delay_step }}s;">
					{%- render 'article-card',
						article: article,
						class: article_class,
						remove_lazy: remove_lazy,
						w1600: w1600,
						w_default: w_default
					-%}
				</div>

				{% assign delay_step = delay_step | plus: 0.25 %}
				{% assign count = count | plus: 1 %}
			{%- endfor -%}
		{%- else -%}
			{%- for i in (1..3) -%}
				<div class="featured-blog__col need-animate" style="--delay-step: {{ delay_step }}s;">
					{%- render 'article-card', article: blank, class: article_class -%}
				</div>

				{% assign delay_step = delay_step | plus: 0.25 %}
			{%- endfor -%}
		{%- endif -%}
	</div>
{%- endcapture -%}

{%- capture featured_blog -%}
	<div class="featured-blog__content">
		<div class="featured-blog__content-col">
			{%- if heading_first_line != blank or heading_second_line != blank -%}
				<h2 class="featured-blog__heading section-title {% unless is_layout_secondary %} section-title--center {% endunless %} need-animate">
					{%- unless is_layout_secondary -%}
						{% assign heading_first_line_class = 'text-center' %}
						{% assign heading_second_line_class = 'text-center' %}

						{%- if heading_first_line != blank and heading_second_line != blank -%}
							{% assign heading_first_line_class = '' %}
							{% assign heading_second_line_class = 'text-right' %}
						{%- endif -%}
					{%- endunless -%}

					{%- if heading_first_line != blank -%}
						<span class="section-title__text-container">
							<span class="section-title__text {{ heading_first_line_class }}">
								{{- heading_first_line -}}
							</span>
						</span>
					{%- endif -%}

					{%- if heading_second_line != blank -%}
						<span class="section-title__text-container">
							<span class="section-title__text {{ heading_second_line_class }}">
								{{- heading_second_line -}}
							</span>
						</span>
					{%- endif -%}
				</h2>
			{%- endif -%}

			{{- blog_posts -}}
		</div>

		{%- if is_layout_secondary -%}
			{%- assign article_class = 'article-card--big' -%}

			{%- if blog and blog.articles.size > 0 -%}
				{%- if blog.articles.size > 2 -%}
					{% assign delay_step = delay_step | minus: 0.25 %}

					<div class="featured-blog__content-col featured-blog__content-col--wide need-animate"
						 style="--delay-step: {{ delay_step }}s;">
						{%- assign article = blog.articles[2] -%}
						{%- render 'article-card',
							article: article,
							class: article_class,
							remove_lazy: remove_lazy,
							w1600: 741,
							w_default: 909
						-%}
					</div>

					{% assign delay_step = delay_step | plus: 0.25 %}
				{%- endif -%}
			{%- else -%}
				{% assign delay_step = delay_step | minus: 0.25 %}

				<div class="featured-blog__content-col featured-blog__content-col--wide need-animate"
					 style="--delay-step: {{ delay_step }}s;">
					{%- render 'article-card', article: blank, class: article_class -%}
				</div>

				{% assign delay_step = delay_step | plus: 0.25 %}
			{%- endif -%}
		{%- endif -%}
	</div>

	{%- if link_text != blank -%}
		<div class="featured-blog__link-wrapper need-animate" style="--delay-step: {{ delay_step }}s;">
			<a
				class="focus-visible-outline button button--primary featured-blog__link"
				href="{{- blog.url -}}"
				{% if link_aria_label_text != blank %}
					aria-label="{{- link_aria_label_text | escape -}}"
				{% endif %}
			>
				<span class="button__outer"></span>
				{{- link_text -}}
			</a>
		</div>
	{%- endif -%}
{%- endcapture -%}

<section
	class="
		featured-blog
		{% if is_layout_secondary %}featured-blog--secondary{% endif %}
		color-{{ color_scheme.id }}
		{% if enable_bottom_rounded_corners %}section-bottom-rounded{% endif %}
		js-animate
		{% if request.visual_preview_mode or section.index == 1 %}animated{% endif %}
	"
	id="{{- section.id -}}"
	style="{{ section_styles }}">
	<div class="featured-blog__container container">
		{{- featured_blog -}}
	</div>
</section>

{%- schema -%}
{
	"name": "Blog posts",
	"disabled_on": {
		"groups": ["header", "footer", "custom.popup"]
	},
	"settings": [
		{
			"type": "blog",
			"id": "blog",
			"label": "Blog",
			"info": "Will display the last three posts of the selected blog. If you add the section to a article page template and the blog is not selected - then the last three blog posts a blog page will appear."
		},
		{
			"type": "inline_richtext",
			"id": "heading_first_line",
			"label": "Heading (first line)"
		},
		{
			"type": "inline_richtext",
			"id": "heading_second_line",
			"label": "Heading (second line)"
		},
		{
			"type": "text",
			"id": "link_text",
			"label": "Button label",
			"default": "See all"
		},
		{
			"type": "text",
			"id": "link_aria_label_text",
			"label": "Button aria-label",
			"info": "Needed for good accessibility, e.g. 'All news about sports'."
		},
		{
			"type": "select",
			"id": "layout",
			"label": "Layout",
			"options": [
				{
					"value": "primary",
					"label": "3 equal"
				},
				{
					"value": "secondary",
					"label": "2 small and 1 big"
				}
			],
			"default": "secondary",
			"info": "Layout '2 small and 1 big' used when number of articles in blog is more than 2. Visible only on 1500px screens or larger. Equal images are displayed on smaller screens."
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "checkbox",
			"id": "enable_color_scheme_inheritance",
			"label": "Enable color scheme inheritance",
			"default": true,
			"info": "When this setting is enabled, the color scheme is inherited from the theme settings."
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "Color scheme",
			"default": "scheme-1"
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "select",
			"id": "container_width",
			"label": "Container width",
			"options": [
				{
					"value": "1560px",
					"label": "Default - 1440px"
				},
				{
					"value": "2040px",
					"label": "Large - 1920px"
				},
				{
					"value": "100%",
					"label": "Full width"
				},
				{
					"value": "inherit",
					"label": "Inherit of general setting"
				}
			],
			"default": "inherit",
			"info": "if you select 'Inherit of general setting', then container width will be used from the Theme settings/Layout"
		},
		{
			"type": "checkbox",
			"id": "enable_bottom_rounded_corners",
			"label": "Enable bottom rounded corners",
			"info": "This setting rounds the inner bottom corners. If the section background is the same as the page background, the effect will not be visible. To see the rounded corners clearly, choose a section background color different from the page background.",
			"default": false
		},
		{
			"type": "range",
			"id": "offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset top",
			"default": 0
		},
		{
			"type": "range",
			"id": "offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset bottom",
			"default": 0
		},
		{
			"type": "range",
			"id": "offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset top",
			"default": 0
		},
		{
			"type": "range",
			"id": "offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset bottom",
			"default": 0
		},
		{
			"type": "range",
			"id": "inner_offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Inner desktop offset top",
			"default": 100
		},
		{
			"type": "range",
			"id": "inner_offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Inner desktop offset bottom",
			"default": 100
		},
		{
			"type": "range",
			"id": "inner_offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Inner mobile offset top",
			"default": 40
		},
		{
			"type": "range",
			"id": "inner_offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Inner mobile offset bottom",
			"default": 40
		}
	],
	"presets": [
		{
			"name": "Blog posts",
			"settings": {
				"heading_first_line": "<em>Heading primary</em>",
				"heading_second_line": "<strong>Heading secondary</strong>",
				"link_text": "Link text",
				"link_aria_label_text": "Link to blog"
			}
		}
	]
}
{%- endschema -%}
