{%- comment -%}
------------------------------------------------------------------------------
  Section: Product template
------------------------------------------------------------------------------
{%- endcomment -%}

{%- render 'adastra' with '/src/styles/carousel.scss' -%}
{%- render 'adastra' with '/src/styles/product.scss' -%}

{%- assign ui_button_color					= section.settings.ui_button_color -%}
{%- assign ui_button_background_color		= section.settings.ui_button_background_color -%}
{%- assign ui_button_border_color			= section.settings.ui_button_border_color -%}
{%- assign enable_color_scheme_inheritance 	= section.settings.enable_color_scheme_inheritance -%}
{%- assign color_scheme		  				= section.settings.color_scheme -%}
{%- assign product_color 					= product.metafields.custom.main_background_color -%}

{%- assign decor_image_first 				= section.settings.decor_image_first -%}
{%- assign decor_image_second 				= section.settings.decor_image_second -%}

{%- if enable_color_scheme_inheritance -%}
	{%- assign color_scheme	= settings.main_color_scheme -%}
{%- endif -%}

{%- style -%}
	#shopify-section-{{- section.id -}} {
		background-color: {{ color_scheme.settings.color_background }};
		padding-top: {{- section.settings.offset_top_mobile -}}px;
		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
	}

	@media screen and (min-width: 768px) {
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_desktop -}}px;
			padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
		}
	}
{%- endstyle -%}

{%- capture section_styles -%}
	--ui-button-color: {{- ui_button_color -}}; {{-  -}}
	--ui-button-background-color: {{- ui_button_background_color -}}; {{-  -}}
	--ui-button-border-color: {{- ui_button_border_color -}}; {{-  -}}
	--ui-model-view-button-background-color: {{- ui_button_background_color | color_darken: 5 -}}; {{-  -}}
	--image-object-fit: {{- section.settings.image_object_fit -}}; {{-  -}}
	{% if product_color != nil %}--product-color: {{ product_color }}; {{-  -}}{% endif %}
{%- endcapture -%}

<div class="product-section-wrapper allow-transparent-header color-{{ color_scheme.id }} js-image-mouse-move-wrapper" style="{{ section_styles }}">
	{%- if settings.show_breadcrumbs -%}
		{%- render "breadcrumbs" -%}
	{%- endif -%}

	{% if decor_image_first != blank %}
		<picture class="lazy">
			<img class="product-decor-image product-decor-image--first js-image-mouse-move"
				 src="{{ decor_image_first | image_url: width: 10 }}"
				 srcset="{{ decor_image_first | image_url: width: 10 }} 1x"
				 data-srcset="{{ decor_image_first | image_url: width: 140 }} 1x, {{ decor_image_first | image_url: width: 280 }} 2x"
				 data-src="{{ decor_image_first | image_url: width: 140 }}"
				 alt="{{ decor_image_first.alt | escape }}">
		</picture>
	{% endif %}

	<section
		class="product"
		data-section-type="product"
		data-section-id="{{- section.id -}}"
		data-product-handle="{{- product.handle -}}"
		data-url="{{- product.url -}}"
	>
		{%- include 'product-form', blocks: section.blocks, enable_history_state: true, product_template: true -%}
		{%- include 'product-media', media_height: section.settings.media_height, decor_image_second: decor_image_second -%}
		{%- render 'product-drawers-content', product: product, section: section, blocks: section.blocks -%}

		{%- for block in section.blocks -%}
			{%- case block.type -%}
				{% when 'notify_me' -%}
					{%- render 'product-notify-me-popup', block: block, section_id: section.id -%}
				{% when 'ask_question' %}
					{%- render 'product-ask-question-popup', block: block, section_id: section.id -%}
			{%- endcase -%}
		{%- endfor -%}
	</section>
</div>

{% assign description_block = section.blocks | where: 'type', 'description' | first %}

{% if description_block.settings.read_more_label != blank and product.description != blank %}
	{% render 'product-extra-description', product: product, color_scheme: color_scheme.id %}
{% endif %}

{%- render 'adastra' with '/src/scripts/section-product.js' -%}

{%- liquid
	if product.selected_or_first_available_variant.featured_media
	assign seo_media = product.selected_or_first_available_variant.featured_media
	else
	assign seo_media = product.featured_media
	endif
-%}

<script type="application/ld+json">
    {{- product | structured_data -}}
  </script>

