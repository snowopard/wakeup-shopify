{%- comment -%}
------------------------------------------------------------------------------
	Section: Wake Up — RIP
------------------------------------------------------------------------------
{%- endcomment -%}

{%- assign eyebrow                        = section.settings.eyebrow -%}
{%- assign heading                        = section.settings.heading -%}
{%- assign supporting_text                = section.settings.supporting_text -%}

{%- assign background_image               = section.settings.background_image | default: section.settings.background_image_mobile -%}
{%- assign background_image_mobile        = section.settings.background_image_mobile -%}
{%- assign product_image                  = section.settings.product_image | default: section.settings.product_image_mobile -%}
{%- assign product_image_mobile           = section.settings.product_image_mobile -%}
{%- assign tear_overlay_image              = section.settings.tear_overlay_image -%}
{%- assign overlay_strength               = section.settings.overlay_strength -%}
{%- assign background_focal_point         = section.settings.background_focal_point -%}

{%- assign section_height                 = section.settings.section_height -%}
{%- assign product_position               = section.settings.product_position -%}
{%- assign content_alignment              = section.settings.content_alignment -%}
{%- assign show_transition_gradient       = section.settings.show_transition_gradient -%}

{%- case background_focal_point -%}
	{%- when 'top' -%}
		{%- assign focal_position = 'center top' -%}
	{%- when 'bottom' -%}
		{%- assign focal_position = 'center bottom' -%}
	{%- when 'left' -%}
		{%- assign focal_position = 'left center' -%}
	{%- when 'right' -%}
		{%- assign focal_position = 'right center' -%}
	{%- else -%}
		{%- assign focal_position = 'center center' -%}
{%- endcase -%}

{%- assign enable_color_scheme_inheritance = section.settings.enable_color_scheme_inheritance -%}
{%- assign color_scheme                    = section.settings.color_scheme -%}

{%- if enable_color_scheme_inheritance -%}
	{%- assign color_scheme = settings.main_color_scheme -%}
{%- endif -%}

{%- assign enable_lazy_load = true -%}

{%- if section.index == 1 -%}
	{%- assign enable_lazy_load = false -%}
{%- endif -%}

{{ 'wakeup-rip.css' | asset_url | stylesheet_tag }}

{%- capture rip_styles -%}
	--wakeup-rip-min-height: {{ section_height }};
	--wu-rip-overlay-opacity: {{ overlay_strength | divided_by: 100.0 }};
	--wu-rip-focal-position: {{ focal_position }};
{%- endcapture -%}

<section
	class="wakeup-rip js-animate {% if request.visual_preview_mode or section.index == 1 %}animated{% endif %} {% if color_scheme != blank %}color-{{ color_scheme.id }}{% endif %}"
	data-wu-theme="night"
	data-product-position="{{ product_position }}"
	data-content-alignment="{{ content_alignment }}"
	style="{{ rip_styles | strip_newlines }}"
>
	<div class="wakeup-rip__media" aria-hidden="true">
		{%- render 'theme-image',
			image: background_image,
			mobile_image: background_image_mobile,
			mobile_breakpoint: '767',
			img_class: 'wakeup-rip__bg-img',
			picture_class: 'wakeup-rip__bg-picture',
			alt: '',
			lazy: enable_lazy_load,
			src_width: 1600,
			src_crop: 'center',
			breakpoints: '480, 767, 1024, 1440, 1920',
			widths: '480, 767, 1024, 1440, 1920',
			svg_placeholder_name: 'lifestyle-2'
		-%}

		<div class="wakeup-rip__overlay"></div>

		{%- if show_transition_gradient -%}
			<div class="wakeup-rip__transition"></div>
		{%- endif -%}
	</div>

	<div class="wakeup-rip__content">
		<div class="wu-container wakeup-rip__inner">
			{%- if eyebrow != blank -%}
				<p class="wu-eyebrow wakeup-rip__eyebrow need-animate">{{- eyebrow -}}</p>
			{%- endif -%}

			{%- if heading != blank -%}
				<h2 class="wu-heading wu-heading--display wakeup-rip__heading need-animate">{{- heading -}}</h2>
			{%- endif -%}

			{%- if supporting_text != blank -%}
				<div class="wu-body wakeup-rip__text need-animate">{{- supporting_text -}}</div>
			{%- endif -%}
		</div>

		{%- if product_image != blank or product_image_mobile != blank -%}
			<div class="wakeup-rip__product-stage">
				<div class="wakeup-rip__product need-animate">
					{%- render 'theme-image',
						image: product_image,
						mobile_image: product_image_mobile,
						mobile_breakpoint: '767',
						img_class: 'wakeup-rip__product-img',
						picture_class: 'wakeup-rip__product-picture',
						alt: product_image.alt,
						lazy: enable_lazy_load,
						src_width: 900,
						svg_placeholder_name: 'product-2'
					-%}
				</div>

				{%- if tear_overlay_image != blank -%}
					<div class="wakeup-rip__tear need-animate" aria-hidden="true">
						{%- render 'theme-image',
							image: tear_overlay_image,
							img_class: 'wakeup-rip__tear-img',
							picture_class: 'wakeup-rip__tear-picture',
							alt: '',
							lazy: enable_lazy_load,
							src_width: 500,
							svg_placeholder_name: 'product-2'
						-%}
					</div>
				{%- endif -%}
			</div>
		{%- endif -%}
	</div>
</section>

{%- schema -%}
{
	"name": "Wake Up: RIP",
	"class": "shopify-section--wakeup-rip",
	"disabled_on": {
		"groups": ["header", "footer", "custom.popup"]
	},
	"settings": [
		{
			"type": "header",
			"content": "Content"
		},
		{
			"type": "text",
			"id": "eyebrow",
			"label": "Step label / eyebrow",
			"info": "Optional. Keep it short."
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"label": "Heading",
			"default": "RIP."
		},
		{
			"type": "richtext",
			"id": "supporting_text",
			"label": "Supporting text",
			"default": "<p>Every night has a moment before it turns.</p>"
		},
		{
			"type": "header",
			"content": "Media"
		},
		{
			"type": "image_picker",
			"id": "background_image",
			"label": "Background image (desktop)",
			"info": "Dark, atmospheric backdrop. 2400px width recommended."
		},
		{
			"type": "image_picker",
			"id": "background_image_mobile",
			"label": "Background image (mobile)",
			"info": "Optional. Falls back to the desktop image if not set."
		},
		{
			"type": "image_picker",
			"id": "product_image",
			"label": "Product / interaction image (close-up)",
			"info": "Can be the sachet alone, or a hand + sachet interaction shot once campaign photography is ready. 1600px width recommended."
		},
		{
			"type": "image_picker",
			"id": "product_image_mobile",
			"label": "Product / interaction image (mobile)",
			"info": "Optional. Falls back to the desktop image if not set."
		},
		{
			"type": "image_picker",
			"id": "tear_overlay_image",
			"label": "Tear / decorative overlay image",
			"info": "Fully optional. Only renders if an image is set here — leave blank until this asset exists. Transparent PNG recommended."
		},
		{
			"type": "range",
			"id": "overlay_strength",
			"label": "Overlay strength",
			"min": 0,
			"max": 90,
			"step": 5,
			"unit": "%",
			"default": 60,
			"info": "Darkens the background image for text legibility."
		},
		{
			"type": "select",
			"id": "background_focal_point",
			"label": "Background focal point",
			"info": "Controls which part of the background image stays visible when cropped.",
			"options": [
				{
					"value": "center",
					"label": "Center"
				},
				{
					"value": "top",
					"label": "Top"
				},
				{
					"value": "bottom",
					"label": "Bottom"
				},
				{
					"value": "left",
					"label": "Left"
				},
				{
					"value": "right",
					"label": "Right"
				}
			],
			"default": "center"
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "select",
			"id": "section_height",
			"label": "Section height",
			"options": [
				{
					"value": "auto",
					"label": "Auto (content height, recommended)"
				},
				{
					"value": "90svh",
					"label": "Tall"
				},
				{
					"value": "100svh",
					"label": "Full screen"
				}
			],
			"default": "auto"
		},
		{
			"type": "select",
			"id": "product_position",
			"label": "Product position (desktop)",
			"info": "Desktop only — the product always stays centered on mobile and tablet.",
			"options": [
				{
					"value": "center",
					"label": "Center"
				},
				{
					"value": "left",
					"label": "Left"
				},
				{
					"value": "right",
					"label": "Right"
				}
			],
			"default": "center"
		},
		{
			"type": "select",
			"id": "content_alignment",
			"label": "Content alignment",
			"info": "Applies at all breakpoints.",
			"options": [
				{
					"value": "center",
					"label": "Center"
				},
				{
					"value": "left",
					"label": "Left"
				}
			],
			"default": "center"
		},
		{
			"type": "checkbox",
			"id": "show_transition_gradient",
			"label": "Show RIP → SIP atmospheric transition",
			"default": true,
			"info": "A soft gradient at the bottom of the section that prepares the handoff into SIP."
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "checkbox",
			"id": "enable_color_scheme_inheritance",
			"label": "Enable color scheme inheritance",
			"default": false,
			"info": "RIP uses its own night palette by default. Enable this to force it to follow the theme's main color scheme instead."
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "Color scheme",
			"default": "scheme-1",
			"info": "Only affects elements that don't already use the Wake Up night palette."
		}
	],
	"presets": [
		{
			"name": "Wake Up: RIP"
		}
	]
}
{%- endschema -%}
