{%- comment -%}
------------------------------------------------------------------------------
	Section: Addresses template
------------------------------------------------------------------------------
{%- endcomment -%}

{%- render 'adastra' with '/src/styles/addresses.scss' -%}

{%- style -%}
	#shopify-section-{{- section.id -}} {
		padding-top: {{- section.settings.offset_top_mobile -}}px;
		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
	}

	@media screen and (min-width: 768px) {
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_desktop -}}px;
			padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
		}
	}
{%- endstyle -%}

{%- assign enable_color_scheme_inheritance = section.settings.enable_color_scheme_inheritance -%}
{%- assign color_scheme                    = section.settings.color_scheme -%}
{%- assign enable_bottom_rounded_corners   = section.settings.enable_bottom_rounded_corners -%}

{%- if enable_color_scheme_inheritance -%}
	{%- assign color_scheme = settings.main_color_scheme -%}
{%- endif -%}

{%- assign background_brightness = color_scheme.settings.color_background | color_brightness -%}
{%- if background_brightness < 128 -%}
	{%- assign modified_background_color = color_scheme.settings.color_background | color_lighten: 13 | color_modify: 'alpha', 0.90 -%}
{%- else -%}
	{%- assign modified_background_color = color_scheme.settings.color_background | color_darken: 3 | color_modify: 'alpha', 0.90 -%}
{%- endif -%}

{%- capture styles -%}
	--card-background-color: {{- modified_background_color -}}; {{- -}}
	--inner-offset-top-desktop: {{- section.settings.inner_offset_top_desktop -}}px; {{- -}}
	--inner-offset-bottom-desktop: {{- section.settings.inner_offset_bottom_desktop -}}px; {{- -}}
	--inner-offset-top-mobile: {{- section.settings.inner_offset_top_mobile -}}px; {{- -}}
	--inner-offset-bottom-mobile: {{- section.settings.inner_offset_bottom_mobile -}}px; {{- -}}
{%- endcapture -%}

{%- paginate customer.addresses by 5 -%}
	<section class="addresses need-animate js-animate color-{{ color_scheme.id }}{% if enable_bottom_rounded_corners %} section-bottom-rounded{% endif %}" style="{{- styles -}}">
		<div class="container addresses__container js-addresses-container">
			<h1 class="h3 addresses__title">
				{{- "customer.addresses.title" | t -}}
			</h1>

			<a
				class="addresses__return button-link focus-visible-outline addresses__link js-address-new-toggle need-animate tr-dur-1"
				href="{{- routes.account_url -}}"
				aria-label="{{- 'customer.account.return' | t | escape -}}"
			>
				<span class="button-link__icons">
					{% render 'icons', icon: 'arrow-right', class: 'icon-base' %}
					{% render 'icons', icon: 'arrow-right', class: 'icon-hover' %}
				</span>

				<span data-text="{{- "customer.account.return" | t -}}">
					<span class="button-link__text">{{- "customer.account.return" | t -}}</span>
				</span>
			</a>

			<button
				class="button-simple button-simple--primary addresses__button addresses__button--new js-address-new-toggle need-animate tr-dur-1"
				type="button"
				data-new-main-btn
				aria-label="{{- 'customer.addresses.add_new' | t | escape -}}"
			>
				{%- render 'icons', icon: 'plus' -%}

				{{- "customer.addresses.add_new" | t -}}
			</button>

			<div class="is-hidden addresses__new-form-wrapper js-addresses-new-form">
				{%- form "customer_address", customer.new_address, class: "addresses__new-form" -%}
					<h3 class="h4 addresses__subtitle">
						{{- "customer.addresses.add_new" | t -}}
					</h3>

					<div class="addresses__input-wrapper input-wrapper">
						<input
							class="input"
							type="text"
							id="AddressFirstNameNew"
							name="address[first_name]"
							value="{{- form.first_name -}}"
							required
							placeholder="{{- 'customer.addresses.enter_first_name' | t | escape -}}"
							aria-label="{{- 'customer.addresses.enter_first_name' | t | escape -}}"
						/>

						<label class="input-label" for="AddressFirstNameNew">
							{{- "customer.addresses.first_name" | t -}}
						</label>
					</div>

					<div class="addresses__input-wrapper input-wrapper">
						<input
							class="input"
							type="text"
							id="AddressLastNameNew"
							name="address[last_name]"
							value="{{- form.last_name -}}"
							placeholder="{{- 'customer.addresses.enter_last_name' | t | escape -}}"
							aria-label="{{- 'customer.addresses.enter_last_name' | t | escape -}}"
						/>

						<label class="input-label" for="AddressLastNameNew">
							{{- "customer.addresses.last_name" | t -}}
						</label>
					</div>

					<div class="addresses__input-wrapper input-wrapper">
						<input
							class="input"
							type="text"
							id="AddressCompanyNew"
							name="address[company]"
							value="{{- form.company -}}"
							placeholder="{{- 'customer.addresses.enter_company' | t | escape -}}"
							aria-label="{{- 'customer.addresses.enter_company' | t | escape -}}"
						/>

						<label class="input-label" for="AddressCompanyNew">
							{{- "customer.addresses.company" | t -}}
						</label>
					</div>

					<div class="addresses__input-wrapper input-wrapper">
						<input
							class="input"
							type="text"
							id="AddressAddress1New"
							name="address[address1]"
							value="{{- form.address1 -}}"
							required
							placeholder="{{- 'customer.addresses.enter_address_1' | t | escape -}}"
							aria-label="{{- 'customer.addresses.enter_address_1' | t | escape -}}"
						/>

						<label class="input-label" for="AddressAddress1New">
							{{- "customer.addresses.address_1" | t -}}
						</label>
					</div>

					<div class="addresses__input-wrapper input-wrapper">
						<input
							class="input"
							type="text"
							id="AddressAddress2New"
							name="address[address2]"
							value="{{- form.address2 -}}"
							placeholder="{{- 'customer.addresses.enter_address_2' | t | escape -}}"
							aria-label="{{- 'customer.addresses.enter_address_2' | t | escape -}}"
						/>

						<label class="input-label" for="AddressAddress2New">
							{{- "customer.addresses.address_2" | t -}}
						</label>
					</div>

					<div class="addresses__input-wrapper input-wrapper">
						<input
							class="input"
							type="text"
							id="AddressCityNew"
							name="address[city]"
							value="{{- form.city -}}"
							placeholder="{{- 'customer.addresses.enter_city' | t | escape -}}"
							aria-label="{{- 'customer.addresses.enter_city' | t | escape -}}"
						/>

						<label class="input-label" for="AddressCityNew">
							{{- "customer.addresses.city" | t -}}
						</label>
					</div>

					<div class="addresses__input-wrapper select-wrapper">
						<label class="label-input" for="AddressCountryNew">
							{{- "customer.addresses.country" | t -}}
						</label>

						<select
							class="focus-visible-outline addresses__select"
							id="AddressCountryNew"
							name="address[country]"
							required
							data-default="{{- form.country -}}"
							aria-label="{{- 'customer.addresses.select_country' | t | escape -}}"
						>
							{{- all_country_option_tags | replace: 'value="---"', 'value=""' -}}
						</select>
					</div>

					<div class="select-wrapper" id="AddressProvinceContainerNew" style="display: none">
						<label class="label-input" for="AddressProvinceNew">
							{{- "customer.addresses.province" | t -}}
						</label>

						<select
							class="focus-visible-outline addresses__select"
							id="AddressProvinceNew"
							name="address[province]"
							data-default="{{- form.province -}}"
							aria-label="{{- 'customer.addresses.select_province' | t | escape -}}"
						>
						</select>
					</div>

					<div class="addresses__input-wrapper input-wrapper">
						<input
							class="input"
							type="text"
							id="AddressZipNew"
							name="address[zip]"
							value="{{- form.zip -}}"
							placeholder="{{- 'customer.addresses.enter_zip' | t | escape -}}"
							aria-label="{{- 'customer.addresses.enter_zip' | t | escape -}}"
						/>

						<label class="input-label" for="AddressZipNew">
							{{- "customer.addresses.zip" | t -}}
						</label>
					</div>

					<div class="addresses__input-wrapper input-wrapper">
						<input
							class="input"
							type="tel"
							id="AddressPhoneNew"
							name="address[phone]"
							value="{{- form.phone -}}"
							placeholder="{{- 'customer.addresses.enter_phone' | t | escape -}}"
							aria-label="{{- 'customer.addresses.enter_phone' | t | escape -}}"
						/>

						<label class="input-label" for="AddressPhoneNew">
							{{- "customer.addresses.phone" | t -}}
						</label>
					</div>

					<div class="addresses__checkbox">
						<input
							class="visually-hidden checkbox"
							type="checkbox"
							id="address_default_address_{{- form.id -}}"
							name="address[default]"
							value="1"
						/>

						<label
							class="checkbox-label"
							for="address_default_address_{{- form.id -}}"
							aria-label="{{- "customer.addresses.set_default" | t | escape -}}"
						>
							<span class="checkbox-label__box">
								{% render "icons", icon: "check" %}
							</span>

							{{- "customer.addresses.set_default" | t -}}
						</label>
					</div>

					<button
						class="button button--primary addresses__button addresses__button--add"
						type="submit"
						aria-label="{{- 'customer.addresses.add_address' | t | escape -}}"
					>
						<span class="button__outer"></span>
						{{- 'customer.addresses.add' | t -}}
					</button>

					<button
						class="button-link focus-visible-outline addresses__link js-address-new-toggle"
						type="button"
						aria-label="{{- 'customer.addresses.cancel_addresses' | t | escape -}}"
					>
						<span class="button-link__icons">
							{% render 'icons', icon: 'arrow-right', class: 'icon-base' %}
							{% render 'icons', icon: 'arrow-right', class: 'icon-hover' %}
						</span>

						<span data-text="{{- "customer.addresses.cancel" | t -}}">
							<span class="button-link__text">{{- "customer.addresses.cancel" | t -}}</span>
						</span>
					</button>
				{%- endform -%}
			</div>

			<div class="addresses__row">
				{%- if customer.addresses_count > 0 -%}
					{%- for address in customer.addresses -%}
						<div class="addresses__col">
							<div class="addresses__card need-animate tr-dur-1">
								<div class="addresses__card-content js-addresses-card" data-card-id="{{- address.id -}}">
									<div class="addresses__icon" aria-hidden="true">
										{%- render 'icons', icon: 'map-marker' -%}
									</div>

									<div class="addresses__card-info">
										{%- if address == customer.default_address -%}
											<h2 class="h4 addresses__heading-default">
												{{- "customer.addresses.default" | t -}}
											</h2>
										{%- endif -%}

										{%- if address.first_name != blank or address.last_name != blank -%}
											<p>{{ address.first_name }} {{ address.last_name }}</p>
										{%- endif -%}

										{%- if address.company != blank -%}
											<p>{{- address.company -}}</p>
										{%- endif -%}

										{%- if address.street != blank -%}
											<p>{{- address.street -}}</p>
										{%- endif -%}

										{%- if address.zip != blank -%}
											<p>{{- address.zip -}}</p>
										{%- endif -%}

										{%- if address.city != blank -%}
											<p>{{- address.city -}}</p>
										{%- endif -%}

										{%- if address.province != blank -%}
											<p>{{- address.province -}}</p>
										{%- endif -%}

										{%- if address.country != blank -%}
											<p>{{- address.country -}}</p>
										{%- endif -%}

										{%- if address.phone != blank -%}
											<p>{{- address.phone -}}</p>
										{%- endif -%}
									</div>

									<div class="addresses__card-buttons">
										<button
											class="button-simple button-simple--primary addresses__card-button js-address-edit-toggle"
											type="button"
											data-form-id="{{- address.id -}}"
											aria-label="{{- 'customer.addresses.edit' | t | escape -}}"
										>
											{{- "customer.addresses.edit" | t -}}
										</button>

										<button
											class="button-simple button--small button-simple--primary addresses__card-button js-address-delete"
											type="button"
											data-form-id="{{- address.id -}}"
											data-confirm-message="{{- 'customer.addresses.delete_confirm' | t | escape -}}"
											aria-label="{{- 'customer.addresses.delete' | t | escape -}}"
										>
											{{- "customer.addresses.delete" | t -}}
										</button>
									</div>
								</div>
							</div>

							<div class="addresses__edit-form-wrapper is-hidden" id="EditAddress_{{- address.id -}}">
								{%- form "customer_address", address, class: "addresses__edit-form" -%}
									<div class="addresses__icon" aria-hidden="true">
										{%- render 'icons', icon: 'map-marker' -%}
									</div>

									<h3 class="h4 addresses__subtitle">
										{{- "customer.addresses.edit_address" | t -}}
									</h3>

									<div class="addresses__input-wrapper input-wrapper">
										<input
											class="input"
											type="text"
											id="AddressFirstName_{{- form.id -}}"
											name="address[first_name]"
											value="{{- form.first_name -}}"
											required
											placeholder="{{- 'customer.addresses.enter_first_name' | t | escape -}}"
											aria-label="{{- 'customer.addresses.enter_first_name' | t | escape -}}"
										/>

										<label class="input-label" for="AddressFirstName_{{- form.id -}}">
											{{- "customer.addresses.first_name" | t -}}
										</label>
									</div>

									<div class="addresses__input-wrapper input-wrapper">
										<input
											class="input"
											type="text"
											id="AddressLastName_{{- form.id -}}"
											name="address[last_name]"
											value="{{- form.last_name -}}"
											placeholder="{{- 'customer.addresses.enter_last_name' | t | escape -}}"
											aria-label="{{- 'customer.addresses.enter_last_name' | t | escape -}}"
										/>

										<label class="input-label" for="AddressLastName_{{- form.id -}}">
											{{- "customer.addresses.last_name" | t -}}
										</label>
									</div>

									<div class="addresses__input-wrapper input-wrapper">
										<input
											class="input"
											type="text"
											id="AddressCompany_{{- form.id -}}"
											name="address[company]"
											value="{{- form.company -}}"
											placeholder="{{- 'customer.addresses.enter_company' | t | escape -}}"
											aria-label="{{- 'customer.addresses.enter_company' | t | escape -}}"
										/>

										<label class="input-label" for="AddressCompany_{{- form.id -}}">
											{{- "customer.addresses.company" | t -}}
										</label>
									</div>

									<div class="addresses__input-wrapper input-wrapper">
										<input
											class="input"
											type="text"
											id="AddressAddress1_{{- form.id -}}"
											name="address[address1]"
											value="{{- form.address1 -}}"
											required
											placeholder="{{- 'customer.addresses.enter_address_1' | t | escape -}}"
											aria-label="{{- 'customer.addresses.enter_address_1' | t | escape -}}"
										/>

										<label class="input-label" for="AddressAddress1_{{- form.id -}}">
											{{- "customer.addresses.address_1" | t -}}
										</label>
									</div>

									<div class="addresses__input-wrapper input-wrapper">
										<input
											class="input"
											type="text"
											id="AddressAddress2_{{- form.id -}}"
											name="address[address2]"
											value="{{- form.address2 -}}"
											placeholder="{{- 'customer.addresses.enter_address_2' | t | escape -}}"
											aria-label="{{- 'customer.addresses.enter_address_2' | t | escape -}}"
										/>

										<label class="input-label" for="AddressAddress2_{{- form.id -}}">
											{{- "customer.addresses.address_2" | t -}}
										</label>
									</div>

									<div class="addresses__input-wrapper input-wrapper">
										<input
											class="input"
											type="text"
											id="AddressCity_{{- form.id -}}"
											name="address[city]"
											value="{{- form.city -}}"
											placeholder="{{- 'customer.addresses.enter_city' | t | escape -}}"
											aria-label="{{- 'customer.addresses.enter_city' | t | escape -}}"
										/>

										<label class="input-label" for="AddressCity_{{- form.id -}}">
											{{- "customer.addresses.city" | t -}}
										</label>
									</div>

									<div class="addresses__input-wrapper select-wrapper">
										<label class="label-input" for="AddressCountry_{{- form.id -}}">
											{{- "customer.addresses.country" | t -}}
										</label>

										<select
											class="focus-visible-outline js-address-country-option"
											id="AddressCountry_{{- form.id -}}"
											name="address[country]"
											data-default="{{- form.country -}}"
											data-form-id="{{ form.id }}"
											required
											aria-label="{{- 'customer.addresses.select_country' | t | escape -}}"
										>
											{{- all_country_option_tags | replace: 'value="---"', 'value=""' -}}
										</select>
									</div>

									<div id="AddressProvinceContainer_{{- form.id -}}" style="display: none;">
										<label class="label-input" for="AddressProvince_{{- form.id -}}">
											{{- "customer.addresses.province" | t -}}
										</label>

										<div class="addresses__input-wrapper select-wrapper">
											<select
												class="focus-visible-outline addresses__select"
												id="AddressProvince_{{- form.id -}}"
												name="address[province]"
												data-default="{{- form.province -}}"
												aria-label="{{- 'customer.addresses.select_province' | t | escape -}}"
											>
											</select>
										</div>
									</div>

									<div class="addresses__input-wrapper input-wrapper">
										<input
											class="input"
											type="text"
											id="AddressZip_{{- form.id -}}"
											name="address[zip]"
											value="{{- form.zip -}}"
											placeholder="{{- 'customer.addresses.enter_zip' | t | escape -}}"
											aria-label="{{- 'customer.addresses.enter_zip' | t | escape -}}"
										/>

										<label class="input-label" for="AddressZip_{{- form.id -}}">
											{{- "customer.addresses.zip" | t -}}
										</label>
									</div>

									<div class="addresses__input-wrapper input-wrapper">
										<input
											class="input"
											type="tel"
											id="AddressPhone_{{- form.id -}}"
											name="address[phone]"
											value="{{- form.phone -}}"
											placeholder="{{- 'customer.addresses.enter_phone' | t | escape -}}"
											aria-label="{{- 'customer.addresses.enter_phone' | t | escape -}}"
										/>

										<label class="input-label" for="AddressPhone_{{- form.id -}}">
											{{- "customer.addresses.phone" | t -}}
										</label>
									</div>

									<div class="addresses__checkbox">
										<input
											class="checkbox visually-hidden"
											type="checkbox"
											id="address_default_address_{{- form.id -}}"
											name="address[default]"
											value="1"
										/>

										<label
											class="checkbox-label"
											for="address_default_address_{{- form.id -}}"
											aria-label="{{- "customer.addresses.set_default" | t | escape -}}"
										>
											<span class="checkbox-label__box">
												{% render "icons", icon: "check" %}
											</span>

											{{- "customer.addresses.set_default" | t -}}
										</label>
									</div>

									<button
										class="button button--primary addresses__button addresses__button--update"
										type="submit"
										aria-label="{{- 'customer.addresses.update_address' | t | escape -}}"
									>
										<span class="button__outer"></span>
										{{- 'customer.addresses.update' | t -}}
									</button>

									<button
										class="button-link focus-visible-outline addresses__link js-address-edit-toggle"
										type="reset"
										data-form-id="{{- form.id -}}"
										aria-label="{{- 'customer.addresses.cancel_addresses' | t | escape -}}"
									>
										<span class="button-link__icons">
											{% render 'icons', icon: 'arrow-right', class: 'icon-base' %}
											{% render 'icons', icon: 'arrow-right', class: 'icon-hover' %}
										</span>

										<span data-text="{{- "customer.addresses.cancel" | t -}}">
											<span class="button-link__text">{{- "customer.addresses.cancel" | t -}}</span>
										</span>
									</button>
								{%- endform -%}
							</div>
						</div>
					{%- endfor -%}
				{%- endif -%}

				{%- if paginate.pages > 1 -%}
					{%- render "pagination", paginate: paginate -%}
				{%- endif -%}
			</div>
		</div>
	</section>
{%- endpaginate -%}

{%- render 'adastra' with '/src/scripts/template-customers-addresses.js' -%}

{% schema %}
{
	"name": "Addresses template",
	"settings": [
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "checkbox",
			"id": "enable_color_scheme_inheritance",
			"label": "Enable color scheme inheritance",
			"default": true,
			"info": "When this setting is enabled, the color scheme is inherited from the theme settings."
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "Color scheme",
			"default": "scheme-1"
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "checkbox",
			"id": "enable_bottom_rounded_corners",
			"label": "Enable bottom rounded corners",
			"info": "This setting rounds the inner bottom corners. If the section background is the same as the page background, the effect will not be visible. To see the rounded corners clearly, choose a section background color different from the page background.",
			"default": false
		},
		{
			"type": "range",
			"id": "offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset top",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset bottom",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_top_mobile",
