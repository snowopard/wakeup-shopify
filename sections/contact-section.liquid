		},
		{
			"type": "text",
			"id": "email_label",
			"label": "Email label",
			"default": "Email"
		},
		{
			"type": "text",
			"id": "phone_label",
			"label": "Phone label",
			"default": "Phone"
		},
		{
			"type": "checkbox",
			"id": "is_phone_required",
			"label": "Phone required",
			"default": false
		},
		{
			"type": "text",
			"id": "message_label",
			"label": "Message label",
			"default": "Message"
		},
		{
			"type": "checkbox",
			"id": "is_message_required",
			"label": "Message required",
			"default": false
		},
		{
			"type": "text",
			"id": "submit_label",
			"label": "Button label",
			"default": "Send"
		},
		{
			"type": "header",
			"content": "Socials"
		},
		{
			"type": "checkbox",
			"id": "show_social_links",
			"label": "Show social links",
			"default": true
