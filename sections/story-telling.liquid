{%- style -%}
	#shopify-section-{{ section.id }} {
		padding-top: {{ section.settings.offset_top_desktop }}px;
		padding-bottom: {{ section.settings.offset_bottom_desktop }}px;
	}

	@media screen and (max-width: 768px) {
		#shopify-section-{{ section.id }} {
			padding-top: {{ section.settings.offset_top_mobile }}px;
			padding-bottom: {{ section.settings.offset_bottom_mobile }}px;
		}
	}
{%- endstyle -%}

{%- assign color_scheme = section.settings.color_scheme -%}
{%- assign color_label 	= section.settings.color_label -%}
{%- assign enable_bottom_rounded_corners = section.settings.enable_bottom_rounded_corners -%}
{%- assign container 	= section.settings.container_width -%}
{%- assign blocks 		= section.blocks -%}

{%- if container == "inherit" -%}
	{%- assign container_width = settings.container_width -%}
{%- else -%}
	{%- assign container_width = container -%}
{%- endif -%}

{%- if section.settings.enable_color_scheme_inheritance -%}
	{%- assign color_scheme = settings.main_color_scheme -%}
{%- endif -%}

{%- capture styles -%}
	--color-label: {{ section.settings.color_label -}}; {{  -}}
	--container-width: {{ container_width -}}; {{  -}}
	--inner-offset-top: {{ section.settings.inner_offset_top -}}px; {{  -}}
	--inner-offset-bottom: {{ section.settings.inner_offset_bottom -}}px; {{  -}}
	--inner-offset-top-mobile: {{ section.settings.inner_offset_top_mobile -}}px; {{  -}}
	--inner-offset-bottom-mobile: {{ section.settings.inner_offset_bottom_mobile -}}px; {{  -}}
{%- endcapture -%}

{%- if blocks.size > 0 -%}
	{%- include "adastra" with "/src/styles/story-telling.scss" -%}

	<section
		class="story-telling color-{{ color_scheme.id }}{% if enable_bottom_rounded_corners %} section-bottom-rounded{% endif %} js-animate{% if request.visual_preview_mode or section.index == 1 %} animated{% endif %} js-story-telling"
		style="{{- styles -}}"
	>
		<div class="story-telling__container container">
			<div class="story-telling__slider swiper js-story-telling-slider">
				<div class="story-telling__slider-wrapper swiper-wrapper">
					{%- for block in blocks -%}
						{%- assign slide_heading 	 = block.settings.slide_heading -%}
						{%- assign label 			 = block.settings.label -%}
						{%- assign heading 			 = block.settings.heading -%}
						{%- assign text 			 = block.settings.text -%}
						{%- assign image 			 = block.settings.image -%}
						{%- assign button_label 	 = block.settings.button_label -%}
						{%- assign button_aria_label = block.settings.button_aria_label -%}
						{%- assign button_link 	 	 = block.settings.button_link -%}
						{%- assign is_lazy 			 = true -%}

						{% if section.index == 1 and forloop.index == 1 %}
							{% assign is_lazy = false %}
						{% endif %}

						<div class="story-telling__slider-slide swiper-slide js-story-telling-slide"
							 {% if slide_heading != blank %}
								 data-slide-heading="{{ slide_heading }}"
							 {% endif %}
						>
							{%- if image != blank -%}
								{% assign size_width_375 = 242 %}
								{% assign size_width_375_2x = size_width_375 | times: 2 %}

								{% assign size_width_420 = 290 %}
								{% assign size_width_420_2x = size_width_420 | times: 2 %}

								{% assign size_width_575 = 457 %}
								{% assign size_width_575_2x = size_width_575 | times: 2 %}

								{% assign size_width_991 = 407 %}
								{% assign size_width_991_2x = size_width_991 | times: 2 %}

								{% assign size_width_1199 = 390 %}
								{% assign size_width_1199_2x = size_width_1199 | times: 2 %}

								{% assign size_width_1600 = 430 %}
								{% assign size_width_1600_2x = size_width_1600 | times: 2 %}

								{% assign size_width = 430 %}
								{% assign size_width_2x = size_width | times: 2 %}

								{%- capture img_focal -%}
									--img-pos: {{ image.presentation.focal_point }};
								{%- endcapture -%}

								<div class="story-telling__slide-image-wrapper">
									<div class="story-telling__slide-image-content need-animate">
										<picture class="story-telling__slide-image-inner">
											<source
												srcset="{{ image | image_url: width: size_width_375 }} 1x,
														{{ image | image_url: width: size_width_375_2x }} 2x"
												media="(max-width: 375px)"
												width="{{- size_width_375 -}}"
												height="263"
											>

											<source
												srcset="{{ image | image_url: width: size_width_420 }} 1x,
														{{ image | image_url: width: size_width_420_2x }} 2x"
												media="(max-width: 420px)"
												width="{{- size_width_420 -}}"
												height="316"
											>

											<source
												srcset="{{ image | image_url: width: size_width_575 }} 1x,
														{{ image | image_url: width: size_width_575_2x }} 2x"
												media="(max-width: 575px)"
												width="{{- size_width_575 -}}"
												height="497"
											>

											<source
												srcset="{{ image | image_url: width: size_width_991 }} 1x,
														{{ image | image_url: width: size_width_991_2x }} 2x"
												media="(max-width: 991px)"
												width="{{- size_width_991 -}}"
												height="442"
											>

											<source
												srcset="{{ image | image_url: width: size_width_1199 }} 1x,
														{{ image | image_url: width: size_width_1199_2x }} 2x"
												media="(max-width: 1199px)"
												width="{{- size_width_1199 -}}"
												height="424"
											>

											<source
												srcset="{{ image | image_url: width: size_width_1600 }} 1x,
														{{ image | image_url: width: size_width_1600_2x }} 2x"
												media="(max-width: 1600px)"
												width="{{- size_width_1600 -}}"
												height="467"
											>

											<img
												class="story-telling__slide-image"
												src="{{ image | image_url: width: size_width }}"
												srcset="{{ image | image_url: width: size_width }} 1x,
														{{ image | image_url: width: size_width_2x }} 2x"
												alt="{{ image.alt | escape }}"
												width="{{- size_width -}}"
												height="467"
												{% if is_lazy %}
													loading="lazy"
												{% endif %}
												style="{{- img_focal -}}"
											>
										</picture>
									</div>
								</div>
							{%- endif -%}

							<div class="story-telling__slide-text-wrapper{% if image == blank %} story-telling__slide-text-wrapper--no-image{% endif %}">
								{%- if label != blank -%}
									<div class="story-telling__slide-label need-animate">
										<em>{{- label -}}</em>
									</div>
								{%- endif -%}

								{%- if heading != blank -%}
									<h2 class="story-telling__slide-heading h3 section-title section-title--center need-animate">
										{%- if heading != blank -%}
											<span class="section-title__text-container">
												<span class="section-title__text">
													{{- heading -}}
												</span>
											</span>
										{%- endif -%}
									</h2>
								{%- endif -%}

								{%- if text != blank -%}
									<div class="story-telling__slide-text rte need-animate">
										{{- text -}}
									</div>
								{%- endif -%}

								{%- if button_label != balnk and button_link != balnk -%}
									<div class="story-telling__slide-button-wrapper need-animate">
										<a
											class="button button--primary account-entrance__button"
											href="{{- button_link -}}"
											aria-label="{{- button_aria_label -}}"
										>
											<span class="button__outer"></span>

											{{- button_label -}}
										</a>
									</div>
								{%- endif -%}
							</div>
						</div>
					{%- endfor -%}
				</div>

				<div class="story-telling__slider-controls need-animate{% if blocks.size == 1 %} story-telling__slider-controls--{{ blocks.size }}{% endif %}">
					<div class="story-telling__slider-controls-line">
						{% render "icons", icon: "line-dashed" %}
					</div>

					<div class="story-telling__slider-controls-line story-telling__slider-controls-line--mob">
						{% render "icons", icon: "line-dashed-mob" %}
					</div>

					<div class="story-telling__slider-pagination swiper-pagination js-story-telling-pagination"></div>

					{% render 'swiper-button', direction: 'prev', class: "story-telling__button-slider js-story-telling-button-prev" %}

					{% render 'swiper-button', direction: 'next', class: "story-telling__button-slider js-story-telling-button-next" %}
				</div>
			</div>
		</div>
	</section>

	{%- include "adastra" with "/src/scripts/story-telling.js" -%}
{%- endif -%}

{%- schema -%}
{
	"name": "Story telling",
	"disabled_on": {
		"groups": ["header", "footer", "custom.popup"]
	},
	"settings": [
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "checkbox",
			"id": "enable_color_scheme_inheritance",
			"label": "Enable color scheme inheritance",
			"default": true,
			"info": "When this setting is enabled, the color scheme is inherited from the theme settings."
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"default": "scheme_1",
			"label": "Color scheme"
		},
		{
			"type": "color",
			"id": "color_label",
			"label": "Label",
			"default": "#F8399B"
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "select",
			"id": "container_width",
			"label": "Container width",
			"options": [
				{
					"value": "1560px",
					"label": "Default - 1440px"
				},
				{
					"value": "2040px",
					"label": "Large - 1920px"
				},
				{
					"value": "100%",
					"label": "Full width"
				},
				{
					"value": "inherit",
					"label": "Inherit of general setting"
				}
			],
			"default": "inherit",
			"info": "if you select 'Inherit of general setting', then container width will be used from the Theme settings/Layout"
		},
		{
			"type": "checkbox",
			"id": "enable_bottom_rounded_corners",
			"label": "Enable bottom rounded corners",
			"info": "This setting rounds the inner bottom corners. If the section background is the same as the page background, the effect will not be visible. To see the rounded corners clearly, choose a section background color different from the page background.",
			"default": false
		},
		{
			"type": "range",
			"id": "offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset top",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset bottom",
			"default": 40
		},
		{
			"type": "range",
			"id": "offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset top",
			"default": 25
		},
		{
			"type": "range",
			"id": "offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset bottom",
			"default": 25
		},
		{
			"type": "range",
			"id": "inner_offset_top",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Inner desktop offset top",
			"default": 64
		},
		{
			"type": "range",
			"id": "inner_offset_bottom",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Inner desktop offset bottom",
			"default": 64
		},
		{
			"type": "range",
			"id": "inner_offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Inner mobile offset top",
			"default": 32
		},
		{
			"type": "range",
			"id": "inner_offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Inner mobile offset bottom",
			"default": 32
		}
	],
	"blocks": [
		{
			"name": "Content",
			"type": "content",
			"settings": [
				{
					"type": "text",
					"id": "slide_heading",
					"label": "Slide heading",
					"default": "Slide heading"
				},
				{
					"type": "text",
					"id": "label",
					"label": "Label",
					"default": "Label"
				},
				{
					"type": "text",
					"id": "heading",
					"label": "Heading",
					"default": "Heading"
				},
				{
					"type": "richtext",
					"id": "text",
					"label": "Text",
					"default": "<p>Text that describe content of slide</p>"
				},
				{
					"type": "image_picker",
					"id": "image",
					"label": "Image",
					"info": "654 x 718px recommended"
				},
				{
					"type": "text",
					"id": "button_label",
					"label": "Button label",
					"default": "Button label"
				},
				{
					"type": "text",
					"id": "button_aria_label",
					"label": "Button aria-label"
				},
				{
					"type": "url",
					"id": "button_link",
					"label": "Button link"
				}
			]
		}
	],
	"presets": [
		{
			"name": "Story telling",
			"blocks": [
				{
					"type": "content",
					"settings": {
						"text": "<p>Text that describe content of slide 1</p>"
					}
				},
				{
					"type": "content",
					"settings": {
						"text": "<p>Text that describe content of slide 2</p>"
					}
				},
				{
					"type": "content",
					"settings": {
						"text": "<p>Text that describe content of slide 3</p>"
					}
				},
				{
					"type": "content",
					"settings": {
						"text": "<p>Text that describe content of slide 4</p>"
					}
				}
			]
		}
	]
}
{%- endschema -%}
