{%- comment -%}
------------------------------------------------------------------------------
	Section: Password header
------------------------------------------------------------------------------
{%- endcomment -%}

{%- assign default_popup_button_text = "general.password_page.login_form_submit" | t -%}
{%- assign default_open_popup_button = "general.password_page.header_open_popup_button" | t -%}
{%- assign default_form_label 		 = "general.password_page.form_label" | t -%}

{%- assign button_text 				= section.settings.button_text | default: default_open_popup_button -%}

{%- assign logo 					= section.settings.logo -%}
{%- assign logo_width 				= section.settings.logo_width -%}
{%- assign logo_width_value			= logo_width -%}
{%- assign logo_width 				= logo_width | append: "x" -%}
{%- assign logo_retina_width 		= logo_width | times: 2 | append: "x" -%}
{%- assign logo_width_mobile 		= section.settings.logo_width_mobile -%}
{%- assign logo_width_value_mobile	= logo_width_mobile -%}
{%- assign logo_width_mobile 		= logo_width_mobile | append: "x" -%}
{%- assign logo_retina_width_mobile = logo_width_mobile | times: 2 | append: "x" -%}

{%- assign popup_input_label  		= section.settings.popup_input_label | default: default_form_label -%}
{%- assign popup_input_placeholder  = "general.password_page.form_placeholder" | t -%}
{%- assign popup_heading		 	= section.settings.popup_heading -%}
{%- assign popup_button_text 		= section.settings.popup_button_text | default: default_popup_button_text -%}
{%- assign popup_text 				= section.settings.popup_text -%}

{%- assign background_color		 			= section.settings.section_background | default: "#FFFFFF" -%}
{%- assign background_color_rgba 			= background_color | hex_to_rgba -%}
{%- assign text_color 						= section.settings.section_text_color | default: "#000000" -%}
{%- assign popup_text_color 				= section.settings.popup_text_color | default: "#000000" -%}
{%- assign popup_background_color 			= section.settings.popup_background_color | default: "#FFFFFF" -%}
{%- assign popup_input_color 				= section.settings.input_color %}
{%- assign popup_input_color_transparent 	= section.settings.input_color | color_modify: 'alpha', 0.48 %}
{%- assign popup_input_background_color 	= section.settings.popup_input_background_color %}
{%- assign popup_input_border_color 		= section.settings.popup_input_border_color | default: "#C4C4C4" -%}
{%- assign button_text_color 				= section.settings.button_text_color | default: "#000000" -%}
{%- assign button_background_color 			= section.settings.button_background_color | default: "#000000" -%}
{%- assign button_border_color 				= section.settings.button_border_color | default: "#000000" -%}
{%- assign button_text_hover_color 			= section.settings.button_text_hover_color | default: "#000000" -%}
{%- assign button_background_hover_color 	= section.settings.button_background_hover_color | default: "#000000" -%}
{%- assign button_border_hover_color 		= section.settings.button_border_hover_color | default: "#000000" -%}

{%- capture section_styles -%}
	--section-background: {{ background_color -}}; {{-  -}}
	--section-text_color: {{ text_color -}}; {{-  -}}
	--popup-text-color: {{ popup_text_color -}}; {{-  -}}
	--popup-background-color: {{ popup_background_color -}}; {{-  -}}
	--popup-input-color: {{ popup_input_color -}}; {{-  -}}
	--popup-input-color-transparent: {{ popup_input_color_transparent -}}; {{-  -}}
	--popup-input-background-color: {{ popup_input_background_color -}}; {{-  -}}
	--popup-input-border-color: {{ popup_input_border_color -}}; {{-  -}}
	--popup-button-text-color: {{ button_text_color -}}; {{-  -}}
	--popup-button-background-color: {{ button_background_color -}}; {{-  -}}
	--popup-button-border-color: {{ button_border_color -}}; {{-  -}}
	--popup-button-text-hover-color: {{ button_text_hover_color -}}; {{-  -}}
	--popup-button-background-hover-color: {{ button_background_hover_color -}}; {{-  -}}
	--popup-button-border-hover-color: {{ button_border_hover_color -}}; {{-  -}}
{%- endcapture -%}

<header class="password-header need-animate js-animate{% if request.visual_preview_mode %} animated{% endif %}" style="{{- section_styles -}}">
	{%- render 'adastra' with '/src/styles/password-header.scss' -%}

	<div class="password-header__container">
		<div class="password-header__col">
			<div class="password-header__row">
				<div class="password-header__logo-wrapper need-animate">
					{%- if logo != blank -%}
						{%- capture img_focal -%}
							--img-desktop-pos: {{ logo.presentation.focal_point }};
						{%- endcapture -%}

						<picture>
							<source srcset="{{ logo | img_url: width: logo_width_mobile }} 1x,{{ logo | img_url: logo_retina_width_mobile }} 2x"
									media="(max-width: 767px)"
									width="{{- logo_width_value_mobile -}}"
							>

							<img
								class="password-header__logo"
								src="{{- logo | img_url: logo_width -}}"
								srcset="{{- logo | img_url: logo_width }} 1x, {{- logo | img_url: logo_retina_width }} 2x"
								alt="{{- logo.alt | default: shop.name | escape -}}"
								width="{{ logo_width_value }}"
								style="{{ img_focal }}"
							>
						</picture>
					{%- else -%}
						<span class="h2">{{ shop.name }}</span>
					{%- endif -%}
				</div>
			</div>

			<div class="password-header__row">
				<button
					class="password-header__button button-link button need-animate"
					type="button"
					aria-expanded="false"
					aria-controls="password-popup"
					data-target="password-popup"
					data-js-toggle="password-popup"
				>
					<span class="button-link__text-wrapper" data-text="{{- button_text -}}">
						<span class="button-link__text">{{- button_text -}}</span>
					</span>

					<span class="button-link__icons">
						{% render 'icons', icon: 'arrow-right', class: 'icon-base' %}
						{% render 'icons', icon: 'arrow-right', class: 'icon-hover' %}
					</span>
				</button>
			</div>
		</div>
	</div>

	{%- render "password-popup",
		popup_heading: popup_heading,
		popup_input_label: popup_input_label,
		popup_input_placeholder: popup_input_placeholder,
		popup_button_text: popup_button_text,
		popup_text: popup_text,
		section_id: section.id
	-%}
</header>

{%- schema -%}
	{
		"name": "Password header",
		"settings": [
			{
				"type": "text",
				"id": "button_text",
				"label": "Button label",
				"default": "Enter using password"
			},
			{
				"type": "header",
				"content": "Logo"
			},
			{
				"type": "image_picker",
				"id": "logo",
				"label": "Logo"
			},
			{
				"type": "range",
				"id": "logo_width",
				"min": 20,
				"max": 250,
				"step": 5,
				"default": 125,
				"unit": "px",
				"label": "Logo width",
				"info": "Height will be calculated with image aspect ratio."
			},
			{
				"type": "range",
				"id": "logo_width_mobile",
				"min": 20,
				"max": 250,
				"step": 5,
				"default": 125,
				"unit": "px",
				"label": "Logo width mobile",
				"info": "Height will be calculated with image aspect ratio."
			},
			{
				"type": "header",
				"content": "Popup"
			},
			{
				"type": "text",
				"id": "popup_heading",
				"label": "Heading",
				"default": "Enter store using password"
			},
			{
				"type": "text",
				"id": "popup_input_label",
				"label": "Input label",
				"default": "Your password"
			},
			{
				"type": "text",
				"id": "popup_button_text",
				"label": "Button label",
				"default": "Enter"
			},
			{
				"type": "inline_richtext",
				"id": "popup_text",
				"label": "Bottom text",
				"default": "Are you the store owner? <a href=\"/admin\">Log in here</a>"
			},
			{
				"type": "header",
				"content": "Colors"
			},
			{
				"type": "color",
				"id": "section_background",
				"label": "Section background",
				"default": "#000000"
			},
			{
				"type": "color",
				"id": "section_text_color",
				"label": "Section text",
				"default": "#FFFFFF"
			},
			{
				"type": "color",
				"id": "popup_text_color",
				"label": "Popup text",
				"default": "#FFFFFF"
			},
			{
				"type": "color",
				"id": "popup_background_color",
				"label": "Popup background",
				"default": "#212121"
			},
			{
				"type": "color",
				"id": "input_color",
				"label": "Input text",
				"default": "#ffffff"
			},
			{
				"type": "color",
				"id": "popup_input_background_color",
				"label": "Input background",
				"default": "#212121"
			},
			{
				"type": "color",
				"id": "popup_input_border_color",
				"label": "Input border",
				"default": "#434343"
			},
			{
				"type": "color",
				"id": "button_text_color",
				"label": "Button label",
				"default": "#000000"
			},
			{
				"type": "color",
				"id": "button_background_color",
				"label": "Button background",
				"default": "#FFFFFF"
			},
			{
				"type": "color",
				"id": "button_border_color",
				"label": "Button border",
				"default": "#000000"
			},
			{
				"type": "color",
				"id": "button_text_hover_color",
				"label": "Button label (hover)",
				"default": "#000000"
			},
			{
				"type": "color",
				"id": "button_background_hover_color",
				"label": "Button background (hover)",
				"default": "#d8d8d8"
			},
			{
				"type": "color",
				"id": "button_border_hover_color",
				"label": "Button border (hover)",
				"default": "#000000"
			}
		]
	}
{%- endschema -%}
