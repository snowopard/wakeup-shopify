{%- comment -%}
------------------------------------------------------------------------------
	Section: Product recommendations
------------------------------------------------------------------------------
{%- endcomment -%}


{%- render 'adastra' with '/src/styles/tabs.scss' -%}
{%- render 'adastra' with '/src/styles/carousel.scss' -%}
{%- render 'adastra' with '/src/styles/featured-products.scss' -%}

{%- style -%}
	#shopify-section-{{- section.id -}} {
		padding-top: {{- section.settings.offset_top_mobile -}}px;
		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
	}

	@media screen and (min-width: 768px) {
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_desktop -}}px;
			padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
		}
	}
{%- endstyle -%}

{%- assign heading_first_line   			= section.settings.heading_first_line -%}
{%- assign heading_second_line  			= section.settings.heading_second_line -%}
{%- assign layout       					= section.settings.layout -%}
{%- assign enable_shopify_recommendations   = section.settings.enable_shopify_recommendations -%}
{%- assign collection       				= section.settings.collection -%}
{%- assign recommendations_tab_label       	= section.settings.recommendations_tab_label -%}
{%- assign show_recently_viewed       		= section.settings.show_recently_viewed -%}
{%- assign recently_viewed_tab_label       	= section.settings.recently_viewed_tab_label -%}

{%- if enable_shopify_recommendations -%}
	{%- assign product_list = recommendations.products -%}
{%- else -%}
	{%- assign product_list = collection.products -%}
{%- endif -%}
{%- assign product_list_count = product_list | size -%}

{%- assign container 						= section.settings.container_width -%}
{%- assign enable_bottom_rounded_corners   	= section.settings.enable_bottom_rounded_corners -%}
{%- assign enable_color_scheme_inheritance  = section.settings.enable_color_scheme_inheritance -%}
{%- assign color_scheme 				    = section.settings.color_scheme -%}

{%- if enable_color_scheme_inheritance -%}
	{%- assign color_scheme = settings.main_color_scheme -%}
{%- endif -%}

{% if container == 'inherit' %}
	{% assign container_width = settings.container_width %}
{% else %}
	{% assign container_width = container %}
{% endif %}

{%- capture featured_products_row_wrapper_classes -%}
	featured-products__slider swiper need-animate tr-dur-0-8
 	js-product-recommendations-slider {{-  -}}
{%- endcapture -%}

{%- capture featured_product_row_classes -%}
	{%- if product_list_count <= 2 and product_list != blank -%}
		featured-products__row--center-desktop {{- -}}
	{%- elsif layout == "4" and product_list_count < 4 -%}
		featured-products__row--center-desktop {{- -}}
	{% endif %}

	{% if product_list_count < 3 %} {{- -}}
		featured-products__row--center-tablet
	{% endif %}

	featured-products__row swiper-wrapper {{-  -}}
{%- endcapture -%}

{% assign heading_first_line_class = 'text-center' %}
{% assign heading_second_line_class = 'text-center' %}

{%- if heading_first_line != blank and heading_second_line != blank -%}
	{% assign heading_first_line_class = '' %}
	{% assign heading_second_line_class = 'text-right' %}
{%- endif -%}

{%- capture section_styles -%}
	--container-width: {{ container_width }}; {{-  -}}
	--inner-offset-top: {{ section.settings.inner_offset_top_desktop }}px; {{- -}}
	--inner-offset-bottom: {{ section.settings.inner_offset_bottom_desktop }}px; {{- -}}
	--inner-offset-top-mobile: {{ section.settings.inner_offset_top_mobile }}px; {{- -}}
	--inner-offset-bottom-mobile: {{ section.settings.inner_offset_bottom_mobile }}px;
{%- endcapture -%}

{%- if product_list_count > 0 or enable_shopify_recommendations -%}
	<section class="featured-products color-{{ color_scheme.id }} {% if enable_bottom_rounded_corners %}section-bottom-rounded{% endif %} js-product-recommendations js-animate {% if request.visual_preview_mode or section.index == 1 %}animated{% endif %}"
			 id="{{- section.id -}}"
			 style="{{ section_styles }}"
			 data-slides-in-row="{{ layout }}"
			 {% if enable_shopify_recommendations %}
			 data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=20&intent=related"
			 {% endif %}
	>
		<div class="container js-product-recommendations-content">
			{%- if heading_first_line != blank or heading_second_line != blank -%}
				<h2 class="featured-products__heading h2 section-title section-title--center need-animate">
					{%- if heading_first_line != blank -%}
						<span class="section-title__text-container">
							<span class="section-title__text {{ heading_first_line_class }}">
								{{- heading_first_line -}}
							</span>
						</span>
					{%- endif -%}

					{%- if heading_second_line != blank -%}
						<span class="section-title__text-container">
							<span class="section-title__text {{ heading_second_line_class }}">
								{{- heading_second_line -}}
							</span>
						</span>
					{%- endif -%}
				</h2>
			{%- endif -%}

			<div data-tabs-container>
				{%- if show_recently_viewed and recently_viewed_tab_label != blank -%}
					<div class="featured-products__tabs js-product-recommendations-tabs-wrapper">
						<div class="tabs">
							<button data-tab="tab-panel-recommendations" class="tabs__item focus-visible-outline js-tab-button is-active">{{ recommendations_tab_label }}</button>

							<button data-tab="tab-panel-recently-viewed" class="tabs__item focus-visible-outline js-tab-button">{{ recently_viewed_tab_label }}</button>

							<div class="tab__underline js-tab-underline"></div>
						</div>
					</div>
				{%- endif -%}

				<div class="featured-products__tab-content active" data-tab-content="tab-panel-recommendations">
					<div class="featured-products__content-wrapper">
						<div class="{{- featured_products_row_wrapper_classes | strip_newlines -}}"
							 data-slides-in-row="{{ layout }}"
						>
							<div class="{{- featured_product_row_classes | strip_newlines -}}">
								{%- if product_list != blank and product_list_count > 0 -%}
									{%- assign image_size = 640 -%}
									{%- assign image_size_tablet = 382 -%}
									{%- assign image_size_mobile = 390 -%}

									{%- if layout == '4' -%}
										{%- assign image_size = 480 -%}
									{%- endif -%}

									{%- for product in product_list limit: 20 -%}
										{% assign is_lazy = true %}

										{% if section.index == 1 and forloop.index == 1 %}
											{% assign is_lazy = false %}
										{% endif %}

										<div class="featured-products__col swiper-slide featured-products__col--{{- layout -}}">
											{%- render
												'product-card',
												product: product,
												size: image_size,
												tablet_size: image_size_tablet,
												mobile_size: image_size_mobile,
												is_lazy: is_lazy
											-%}
										</div>
									{%- endfor -%}
								{%- elsif enable_shopify_recommendations -%}
									{%- for i in (1..4) -%}
										<div class="featured-products__col swiper-slide featured-products__col--{{- layout -}}">
											{%- render 'product-card', product: nil, loading: true -%}
										</div>
									{%- endfor -%}
								{%- endif -%}
							</div>

							{%- if product_list_count > 1 -%}
								{% assign arrow_prev_class = 'js-swiper-button-prev-' | append: section.id %}
								{% assign arrow_next_class = 'js-swiper-button-next-' | append: section.id %}

								<div class="slider-pagination featured-products__slider-pagination js-product-recommendations-pagination-wrapper">
									{% render 'swiper-button', direction: 'prev', class: arrow_prev_class %}

									<div class="custom-swiper-pagination js-product-recommendations-pagination"></div>

									{% render 'swiper-button', direction: 'next', class: arrow_next_class %}
								</div>
							{%- endif -%}
						</div>
					</div>
				</div>

				{%- if show_recently_viewed and recently_viewed_tab_label != blank -%}
					<div class="featured-products__tab-content" data-tab-content="tab-panel-recently-viewed">
						<div class="featured-products__slider swiper js-recently-viewed-products-slider">
							<div class="featured-products__row swiper-wrapper js-product-recommendations-viewed-content"></div>

							<div class="slider-pagination featured-products__slider-pagination js-product-recently-viewed-pagination-wrapper">
								{% render 'swiper-button', direction: 'prev', class: 'js-swiper-button-prev' %}

								<div class="custom-swiper-pagination js-product-recently-viewed-pagination"></div>

								{% render 'swiper-button', direction: 'next', class: 'js-swiper-button-next' %}
							</div>
						</div>
					</div>
				{% endif %}
			</div>

		</div>
	</section>

	{%- render 'adastra' with '/src/scripts/section-product-recommendations.js' -%}
{%- endif -%}

{%- schema -%}
{
	"name": "Product recommendations",
	"settings": [
		{
			"id": "heading_first_line",
			"type": "inline_richtext",
			"label": "Heading (first line)",
			"default": "Product recommendations"
		},
		{
			"id": "heading_second_line",
			"type": "inline_richtext",
			"label": "Heading (second line)"
		},
		{
			"type": "select",
			"id": "layout",
			"label": "Layout",
			"options": [
				{
					"value": "3",
					"label": "3 products per row"
				},
				{
					"value": "4",
					"label": "4 products per row"
				}
			],
			"default": "3",
			"info": "Desktop only"
		},
		{
			"type": "header",
			"content": "Recommendations"
		},
		{
			"type": "text",
			"id": "recommendations_tab_label",
			"label": "Tab label",
			"default": "Related products"
		},
		{
			"type": "checkbox",
			"id": "enable_shopify_recommendations",
			"label": "Use Shopify recommendations",
			"default": true
		},
		{
			"type": "collection",
			"id": "collection",
			"label": "Resource collection"
		},
		{
			"type": "header",
			"content": "Recently viewed"
		},
		{
			"type": "checkbox",
			"id": "show_recently_viewed",
			"label": "Show",
			"default": false
		},
		{
			"type": "text",
			"id": "recently_viewed_tab_label",
			"label": "Tab label",
			"default": "Recently viewed"
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "checkbox",
			"id": "enable_color_scheme_inheritance",
			"label": "Enable color scheme inheritance",
			"default": true,
			"info": "When this setting is enabled, the color scheme is inherited from the theme settings."
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "Color scheme",
			"default": "scheme-1"
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "select",
			"id": "container_width",
			"label": "Container width",
			"options": [
				{
					"value": "1432px",
					"label": "Default - 1400px"
				},
				{
					"value": "2040px",
					"label": "Large - 1920px"
				},
				{
					"value": "100%",
					"label": "Full width"
				},
				{
					"value": "inherit",
					"label": "Inherit of general setting"
				}
			],
			"default": "inherit",
			"info": "If you select 'Inherit of general setting', then container width will be used from the Theme settings/Layout"
		},
		{
			"type": "checkbox",
			"id": "enable_bottom_rounded_corners",
			"label": "Enable bottom rounded corners",
			"info": "This setting rounds the inner bottom corners. If the section background is the same as the page background, the effect will not be visible. To see the rounded corners clearly, choose a section background color different from the page background.",
			"default": false
		},
		{
			"type": "range",
			"id": "offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset top",
			"default": 25
		},
		{
			"type": "range",
			"id": "offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Desktop offset bottom",
			"default": 25
		},
		{
			"type": "range",
			"id": "offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset top",
			"default": 25
		},
		{
			"type": "range",
			"id": "offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Mobile offset bottom",
			"default": 25
		},
		{
			"type": "range",
			"id": "inner_offset_top_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Inner desktop offset top",
			"default": 40
		},
		{
			"type": "range",
			"id": "inner_offset_bottom_desktop",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Inner desktop offset bottom",
			"default": 40
		},
		{
			"type": "range",
			"id": "inner_offset_top_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Inner mobile offset top",
			"default": 40
		},
		{
			"type": "range",
			"id": "inner_offset_bottom_mobile",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Inner mobile offset bottom",
			"default": 40
		}
	]
}
{%- endschema -%}
