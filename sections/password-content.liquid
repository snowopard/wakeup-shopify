{%- comment -%}
------------------------------------------------------------------------------
	Section: Password content
------------------------------------------------------------------------------
{%- endcomment -%}

{%- assign default_success 		= "general.password_page.content_success" | t  -%}
{%- assign default_button_label = "general.password_page.content_button_label" | t -%}
{%- assign input_placeholder 	= "general.password_page.content_label" | t -%}
{%- assign default_input_label 	= "general.password_page.form_label" | t -%}

{%- assign heading 				   = section.settings.heading -%}
{%- assign description 			   = section.settings.description -%}
{%- assign additional_text 		   = section.settings.additional_text -%}
{%- assign show_form 			   = section.settings.show_form -%}
{%- assign success_message 		   = section.settings.success_message | default: default_success -%}
{%- assign input_label 			   = section.settings.input_label | default: default_input_label -%}
{%- assign button_label 	       = section.settings.button_label | default: default_button_label -%}

{%- assign main_image 	   	= section.settings.main_image -%}
{%- assign back_image 		= section.settings.back_image -%}
{%- assign decor_image_first 		= section.settings.decor_image_first -%}
{%- assign decor_image_second 		= section.settings.decor_image_second -%}
{%- assign decor_image_third 		= section.settings.decor_image_third -%}

{%- assign background_color        = section.settings.background_color -%}
{%- assign background_color_rgba   = background_color | hex_to_rgba -%}
{%- assign text_color	       	   = section.settings.text_color -%}
{%- assign input_color 		       = section.settings.input_color -%}
{%- assign popup_input_background_color = section.settings.popup_input_background_color -%}
{%- assign input_border_color      = section.settings.input_border_color -%}
{%- assign button_label_color      = section.settings.button_label_color -%}
{%- assign button_border_color     = section.settings.button_border_color -%}
{%- assign button_border_outer_color     			= section.settings.button_border_outer_color -%}
{%- assign button_background_hover_color    		= section.settings.button_background_hover_color -%}
{%- assign button_background_opacity_hover_color    = section.settings.button_background_opacity_hover_color | divided_by: 100.0 -%}
{%- assign button_label_hover_color      			= section.settings.button_label_hover_color -%}
{%- assign button_border_hover_color     			= section.settings.button_border_hover_color -%}
{%- assign button_border_hover_outer_color     		= section.settings.button_border_hover_outer_color -%}
{%- assign ellipse_color     		= section.settings.ellipse_color -%}

{%- capture app_block -%}
	{%- for block in section.blocks -%}
		{%- case block.type -%}
			{%- when '@app' -%}
				{% render block %}
		{%- endcase -%}
	{%- endfor -%}
{%- endcapture -%}

{%- capture custom_liquid_block  -%}
	{%- for block in section.blocks -%}
		{%- case block.type -%}
			{%- when 'custom_liquid' -%}
				{{ block.settings.custom_liquid }}
		{%- endcase -%}
	{%- endfor -%}
{%- endcapture -%}

{%- capture section_style -%}
	--background-color: {{ background_color -}}; {{-  -}}
	--text-color: {{ text_color -}}; {{-  -}}
	--text-color-transparent: {{ text_color | color_modify: 'alpha', 0.5 -}}; {{-  -}}
	--input-color: {{ input_color -}}; {{-  -}}
	--input-color-transparent: {{ input_color | color_modify: 'alpha', 0.48 -}}; {{-  -}}
	--popup-input-background-color: {{ popup_input_background_color -}}; {{-  -}}
	--input-border-color: {{ input_border_color -}}; {{-  -}}
	--button-label-color: {{ button_label_color -}}; {{-  -}}
	--button-background-color: {{ button_label_color | color_modify: 'alpha', 0.16 -}}; {{-  -}}
	--button-border-color: {{ button_border_color -}}; {{-  -}}
	--button-border-outer-color: {{ button_border_outer_color | color_modify: 'alpha', 0.16 -}}; {{-  -}}
	--button-border-outer-decor-color: {{ button_border_outer_color -}}; {{-  -}}
	--button-background-hover-color: {{ button_background_hover_color | color_modify: 'alpha', button_background_opacity_hover_color -}}; {{-  -}}
	--button-label-hover-color: {{ button_label_hover_color -}}; {{-  -}}
	--button-border-hover-color: {{ button_border_hover_color -}}; {{-  -}}
	--button-border-hover-outer-color: {{ button_border_hover_outer_color | color_modify: 'alpha', 0.16 -}}; {{-  -}}
	--button-border-hover-outer-decor-color: {{ button_border_hover_outer_color -}}; {{-  -}}
	--ellipse-color: {{ ellipse_color -}}; {{-  -}}
{%- endcapture -%}

<section class="password-content need-animate js-animate{% if request.visual_preview_mode %} animated{% endif %} js-password-content" style="{{- section_style -}}">
	{%- render 'adastra' with '/src/styles/password-content.scss' -%}

	<div class="password-content__container">
		{%- if decor_image_third != blank -%}
			{%- render 'password-content-image',
				image: decor_image_third,
				image_size_991: 192,
				image_size: 140,
				image_class: "password-content__image-inner--third"
			-%}
		{%- endif -%}

		<div class="password-content__block-form">
			{%- if heading != blank or description != blank or show_form -%}
				<div class="password-content__content">
					{%- if heading != blank -%}
						<h1 class="password-content__heading h1 section-title need-animate">
								<span class="section-title__text-container">
									<span class="section-title__text">
										{{- heading -}}
									</span>
								</span>
						</h1>
					{%- endif -%}

					{%- if shop.password_message != blank -%}
						<div class="password-content__message rte">
							{{ shop.password_message }}
						</div>
					{%- endif -%}

					{%- if description != blank -%}
						<div class="password-content__description rte need-animate">
							{{- description -}}
						</div>
					{%- endif -%}

					{%- if show_form -%}
						{%- if custom_liquid_block != blank -%}
							{{ custom_liquid_block }}
						{%- endif -%}

						{%- if app_block != blank -%}
							{{- app_block -}}
						{%- else -%}
							{%- assign id = 'ContactForm--' | append: section.id -%}

							{% form 'customer', class: 'password-content__form js-password-content-form', id: id %}
								<input type="hidden" name="contact[tags]" value="password-content" />

								<div class="password-content__form-field">
									<div class="input-wrapper need-animate">
										<input
											id="PasswordContentForm--{{- section.id -}}"
											type="email"
											name="contact[email]"
											class="input password-content__form-input js-password-content-input"
											value="{{- form.email -}}"
											aria-required="true"
											autocapitalize="off"
											autocomplete="email"
											{% if form.errors %}
												aria-invalid="true"
												aria-describedby="Newsletter-error--{{- section.id -}}"
											{% elsif form.posted_successfully? %}
												aria-describedby="Newsletter-success--{{- section.id -}}"
											{% endif %}
											placeholder="{{- input_placeholder -}}"
											required
										>
										<label class="input-label" for="PasswordContentForm--{{- section.id -}}">{{- input_label  -}}</label>
									</div>

									<button
										type="submit"
										class="password-content__form-button button button--primary need-animate"
									>
										<span class="button__outer"></span>

										{{- button_label -}}
									</button>

									<div class="password-content__footer-text rte need-animate">
										{{- additional_text -}}
									</div>
								</div>

								{%- if form.errors -%}
									<small class="password-content__form-message password-content__form-message--error" id="Newsletter-error--{{- section.id -}}">
										{% render 'icons', icon: 'menu-close' %}

										{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
									</small>
								{%- endif -%}

								{%- if form.posted_successfully? -%}
									<h3
										class="h5 password-content__form-message password-content__form-message--success"
										id="Newsletter-success--{{- section.id -}}"
										tabindex="-1"
									>
										{% render 'icons', icon: 'check' %}

										<p>
											{{- success_message -}}
										</p>
									</h3>
								{%- endif -%}
							{% endform %}
						{%- endif -%}
					{%- endif -%}
				</div>
			{%- endif -%}
		</div>

		<div class="password-content__block-image">
			<div class="password-content__image-wrapper need-animate js-animate">
				{%- if back_image != blank -%}
					{%- render 'password-content-image',
						image: back_image,
						image_size_375: 343,
						image_size_420: 388,
						image_size_767: 735,
						image_size_991: 959,
						image_size_1199: 648,
						image_size: 865,
						image_class: "password-content__image-inner--back"
					-%}
				{%- endif -%}

				{%- render 'password-content-image',
					image: main_image,
					image_size_375: 343,
					image_size_420: 388,
					image_size_767: 735,
					image_size_991: 959,
					image_size_1199: 704,
					image_size: 1108,
					image_class: "password-content__image-inner--main"
				-%}

				{%- if decor_image_first != blank -%}
					{%- render 'password-content-image',
						image: decor_image_first,
						image_size_991: 192,
						image_size: 140,
						image_class: "password-content__image-inner--first"
					-%}
				{%- endif -%}

				{%- if decor_image_second != blank -%}
					{%- render 'password-content-image',
						image: decor_image_second,
						image_size_991: 192,
						image_size: 140,
						image_class: "password-content__image-inner--second"
					-%}
				{%- endif -%}
			</div>
		</div>
	</div>

	{%- render 'adastra' with '/src/scripts/section-password-content.js' -%}
</section>

{%- schema -%}
{
	"name": "Password content",
	"class": "password-content-wrapper",
	"settings": [
		{
			"type": "inline_richtext",
			"id": "heading",
			"label": "Heading",
			"default": "Opening <em>soon</em>"
		},
		{
			"type": "richtext",
			"id": "description",
			"label": "Text",
			"default": "<p>Be the first to know when we launch.</p>"
		},
		{
			"type": "richtext",
			"id": "additional_text",
			"label": "Additional text",
			"default": "<p>Are you the store owner? <a href=\"/admin\">Log in here</a></p>"
		},
		{
			"type": "image_picker",
			"id": "main_image",
			"label": "Main image",
			"info": "1798 x 1798px recommended"
		},
		{
			"type": "image_picker",
			"id": "back_image",
			"label": "Back image",
			"info": "1798 x 1798px recommended"
		},
		{
			"type": "image_picker",
			"id": "decor_image_first",
			"label": "Decor image first",
			"info": "274 x 274px recommended"
		},
		{
			"type": "image_picker",
			"id": "decor_image_second",
			"label": "Decor image second",
			"info": "274 x 274px recommended"
		},
		{
			"type": "image_picker",
			"id": "decor_image_third",
			"label": "Decor image third",
			"info": "522 x 284px recommended"
		},
		{
			"type": "header",
			"content": "Form"
		},
		{
			"type": "checkbox",
			"id": "show_form",
			"label": "Show form",
			"default": true
		},
		{
			"type": "textarea",
			"id": "success_message",
			"label": "Success message",
			"default": "Thanks for subscribing"
		},
		{
			"type": "text",
			"id": "input_label",
			"label": "Input label",
			"default": "Enter email"
		},
		{
			"type": "text",
			"id": "button_label",
			"label": "Button label",
			"default": "Subscribe"
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "color",
			"id": "background_color",
			"label": "Section background",
			"default": "#000000"
		},
		{
			"type": "color",
			"id": "text_color",
			"label": "Text",
			"default": "#FFFFFF"
		},
		{
			"type": "color",
			"id": "input_color",
			"label": "Input text",
			"default": "#FFFFFF"
		},
		{
			"type": "color",
			"id": "popup_input_background_color",
			"label": "Input background",
			"default": "#000000"
		},
		{
			"type": "color",
			"id": "input_border_color",
			"label": "Input border",
			"default": "#434343"
		},
		{
			"type": "color",
			"id": "button_label_color",
			"label": "Button label",
			"default": "#FFFFFF"
		},
		{
			"type": "color",
			"id": "button_border_color",
			"label": "Button border",
			"default": "#FFFFFF"
		},
		{
			"type": "color",
			"id": "button_border_outer_color",
			"label": "Button border outer",
			"default": "#FFFFFF"
		},
		{
			"type": "color",
			"id": "button_background_hover_color",
			"label": "Button background (hover)",
			"default": "#FFFFFF"
		},
		{
			"type": "range",
			"id": "button_background_opacity_hover_color",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "%",
			"label": "Button background opacity (hover)",
			"default": 16
		},
		{
			"type": "color",
			"id": "button_label_hover_color",
			"label": "Button label (hover)",
			"default": "#FFFFFF"
		},
		{
			"type": "color",
			"id": "button_border_hover_color",
			"label": "Button border (hover)",
			"default": "#FFFFFF"
		},
		{
			"type": "color",
			"id": "button_border_hover_outer_color",
			"label": "Button border outer (hover)",
			"default": "#FFFFFF"
		},
		{
			"type": "color",
			"id": "ellipse_color",
			"label": "Ellipse",
			"default": "#FFB600"
		}
	],
	"blocks": [
		{
			"type": "@app"
		},
		{
			"name": "Custom liquid",
			"type": "custom_liquid",
			"settings": [
				{
					"type": "liquid",
					"id": "custom_liquid",
					"label": "Custom liquid",
					"info": "Simple custom liquid"
				}
			]
		}
	]
}
{%- endschema -%}
