{% assign default_label_text = 'newsletter_popup.label' | t %}
{% assign default_btn_text = 'newsletter_popup.button_label' | t %}
{% assign default_success_text = 'newsletter_popup.success' | t %}
{% assign close_modal = 'general.accessibility.close_modal' | t %}

{% assign newsletter_popup_cookie_time 	= section.settings.newsletter_popup_cookie_time %}
{% assign newsletter_popup_heading 		= section.settings.newsletter_popup_heading %}
{% assign newsletter_popup_text 		= section.settings.newsletter_popup_text %}

{% assign newsletter_popup_input_placeholder 		= section.settings.newsletter_popup_input_placeholder | default: default_label_text %}
{% assign newsletter_popup_input_button_submit_text = section.settings.newsletter_popup_input_button_submit_text | default: default_btn_text %}

{% assign newsletter_popup_desktop_image 	= section.settings.newsletter_popup_desktop_image %}
{% assign newsletter_popup_mobile_image 	= section.settings.newsletter_popup_mobile_image | default: newsletter_popup_desktop_image %}
{% assign image_object_fit 					= section.settings.image_object_fit %}

{% assign color_scheme      	           	= section.settings.color_scheme %}
{% assign enable_color_scheme_inheritance 	= section.settings.enable_color_scheme_inheritance %}

{%- if enable_color_scheme_inheritance -%}
	{%- assign color_scheme = settings.main_color_scheme -%}
{%- endif -%}

{% if newsletter_popup_heading != blank or newsletter_popup_text != blank %}
	{%- render 'adastra' with '/src/styles/newsletter-popup.scss' -%}
	{%- render 'adastra' with '/src/scripts/section-newsletter-popup.js' -%}

	<div class="drawer drawer--auto-height newsletter-popup color-{{ color_scheme }} js-newsletter-popup"
		 id="NewsletterPopup"
		 data-cookie-time="{{ newsletter_popup_cookie_time }}"
		 role="dialog"
		 aria-labelledby="NewsletterPopupTitle"
	>
		<div class="drawer__header">
			<button type="button"
					class="drawer__close"
					aria-label="{{- close_modal | escape -}}"
					data-target="NewsletterPopup"
					data-js-toggle="NewsletterPopupToggle"
			>
				{% render 'icons', icon: 'close' %}
			</button>
		</div>

		<div class="drawer__body newsletter-popup__body">
			<div class="newsletter-popup__content">
				{% if newsletter_popup_heading != blank %}
					<h2 class="newsletter-popup__heading" id="NewsletterPopupTitle">
						{{- newsletter_popup_heading -}}
					</h2>
				{% endif %}

				{% if newsletter_popup_text != blank %}
					<p class="newsletter-popup__text">
						{{- newsletter_popup_text -}}
					</p>
				{% endif %}

				{% form 'customer', class: 'newsletter-popup-form', id: 'newsletter-popup-contact-form' %}
					{% assign form_success_status_class = "" %}

					{% if form.posted_successfully? %}
						{% assign form_success_status_class = "posted" %}
					{% endif %}

					<input type="hidden" name="contact[tags]" value="newsletter"/>

					<div class="newsletter-popup-form__field input-wrapper">
						<input
							id="newsletter-popup-contact-form-input"
							type="email"
							name="contact[email]"
							class="input {{ form_success_status_class }} js-newsletter-popup-input"
							value="{{- form.email -}}"
							autocapitalize="off"
							autocomplete="email"
							{% if form.errors %}
								aria-invalid="true"
								aria-describedby="newsletter-popup-contact-form-error"
							{% elsif form.posted_successfully? %}
								aria-describedby="newsletter-popup-contact-form-success"
							{% endif %}
							placeholder="{{- newsletter_popup_input_placeholder -}}"
							required
						/>

						<label class="input-label" for="newsletter-popup-contact-form-input">{{ newsletter_popup_input_placeholder }}</label>
					</div>

					{% if form.errors %}
						<small class="newsletter-popup-form__message newsletter-popup-form__message--error"
							   id="newsletter-popup-contact-form-error">
							{% render 'icons', icon: 'close' %}

							{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
						</small>
					{% endif %}

					{% if form.posted_successfully? %}
						<h3
							class="newsletter-popup-form__message newsletter-popup-form__message--success text"
							id="newsletter-popup-contact-form-success"
							tabindex="-1"
						>
							{% render 'icons', icon: 'check' %}

							{{- success_message | default: default_success_text -}}
						</h3>
					{% endif %}

					<button
						type="submit"
						class="button button--primary"
						name="commit"
					>
						<span class="button__outer"></span>
						{{- newsletter_popup_input_button_submit_text -}}
					</button>
				{% endform %}
			</div>

			{% if newsletter_popup_desktop_image != blank %}
				{%- capture img_styles -%}
					--img-desktop-pos: {{ newsletter_popup_desktop_image.presentation.focal_point }}; {{-  -}}
					--img-mob-pos: {{ newsletter_popup_mobile_image.presentation.focal_point }}; {{-  -}}
					--img-object-fit: {{ image_object_fit }}; {{-  -}}
				{%- endcapture -%}

				<div class="newsletter-popup__box-image" style="{{- img_styles -}}">
					<div class="newsletter-popup__image-wrapper">
						<picture class="lazy">
							<source
								srcset="{{ newsletter_popup_mobile_image | image_url: width: 10 }} 1x"
								data-srcset="{{ newsletter_popup_mobile_image | image_url: width: 375 }} 1x,
											 {{ newsletter_popup_mobile_image | image_url: width: 750 }} 2x"
								media="(max-width: 375px)"
								width="328"
								height="175"
							/>

							<source
								srcset="{{ newsletter_popup_mobile_image | image_url: width: 10 }} 1x"
								data-srcset="{{ newsletter_popup_mobile_image | image_url: width: 420 }} 1x,
											 {{ newsletter_popup_mobile_image | image_url: width: 840 }} 2x"
								media="(max-width: 420px)"
								width="388"
								height="207"
							/>

							<source
								srcset="{{ newsletter_popup_mobile_image | image_url: width: 10 }} 1x"
								data-srcset="{{ newsletter_popup_mobile_image | image_url: width: 470 }} 1x,
											 {{ newsletter_popup_mobile_image | image_url: width: 940 }} 2x"
								media="(max-width: 767px)"
								width="480"
								height="256"
							/>

							<img
								class="newsletter-popup__image"
								src="{{- newsletter_popup_desktop_image | image_url: width: 10, height: 10 -}}"
								srcset="{{- newsletter_popup_desktop_image | image_url: width: 10, height: 10 -}}"
								data-srcset="{{ newsletter_popup_desktop_image | image_url: width: 470 }} 1x,
											 {{ newsletter_popup_desktop_image | image_url: width: 940 }} 2x"
								data-src="{{- newsletter_popup_desktop_image | image_url: width: 470 -}}"
								alt="{{- newsletter_popup_desktop_image.alt | escape -}}"
								width="300"
								height="320"
								style="{{ img_focal }}"
							/>
						</picture>
					</div>
				</div>
			{% endif %}
		</div>
	</div>
{% endif %}

{% schema %}
{
	"name": "Newsletter popup",
	"limit": 1,
	"enabled_on": {
		"groups": ["custom.popup"]
	},
	"settings": [
		{
			"type": "select",
			"id": "newsletter_popup_cookie_time",
			"label": "Cookie time",
			"options": [
				{
					"value": "1",
					"label": "1 day"
				},
				{
					"value": "7",
					"label": "1 week"
				},
				{
					"value": "30",
					"label": "1 month"
				},
				{
					"value": "90",
					"label": "3 months"
				},
				{
					"value": "360",
					"label": "1 year"
				}
			],
			"default": "1"
		},
		{
			"type": "text",
			"id": "newsletter_popup_heading",
			"label": "Heading",
			"default": "Subscribe to our newsletter"
		},
		{
			"type": "textarea",
			"id": "newsletter_popup_text",
			"label": "Text",
			"default": "Be the first to know about sales, exclusive offers and promotions."
		},
		{
			"type": "text",
			"id": "newsletter_popup_input_placeholder",
			"label": "Input label",
			"default": "Enter"
		},
		{
			"type": "text",
			"id": "newsletter_popup_input_button_submit_text",
			"label": "Button label",
			"default": "Submit"
		},
		{
			"type": "image_picker",
			"id": "newsletter_popup_desktop_image",
			"label": "Image desktop",
			"info": "940 x 644px recommended"
		},
		{
			"type": "image_picker",
			"id": "newsletter_popup_mobile_image",
			"label": "Image mobile",
			"info": "960 x 614px recommended"
		},
		{
			"type": "select",
			"id": "image_object_fit",
			"label": "Image object fit",
			"options": [
				{
					"value": "cover",
					"label": "Cover"
				},
				{
					"value": "contain",
					"label": "Contain"
				}
			],
			"default": "cover"
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "checkbox",
			"id": "enable_color_scheme_inheritance",
			"label": "Enable color scheme inheritance",
			"default": true,
			"info": "When this setting is enabled, the color scheme is inherited from the theme settings."
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "Color scheme",
			"default": "scheme-1"
		},
	],
	"presets": [
		{
			"name": "Newsletter popup"
		}
	]
}
{% endschema %}
