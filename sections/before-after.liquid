{%- comment -%}
------------------------------------------------------------------------------
	Section: Before and after
------------------------------------------------------------------------------
{%- endcomment -%}

{%- style -%}
	#shopify-section-{{- section.id -}} {
		padding-top: {{- section.settings.offset_top_mobile -}}px;
		padding-bottom: {{- section.settings.offset_bottom_mobile -}}px;
	}

	@media screen and (min-width: 768px) {
		#shopify-section-{{- section.id -}} {
			padding-top: {{- section.settings.offset_top_desktop -}}px;
			padding-bottom: {{- section.settings.offset_bottom_desktop -}}px;
		}
	}
{%- endstyle -%}

{%- assign heading_first_line			  = section.settings.heading_first_line -%}
{%- assign heading_second_line			= section.settings.heading_second_line -%}
{%- assign desktop_image_height     = section.settings.desktop_image_height -%}
{%- assign mobile_image_height      = section.settings.mobile_image_height -%}
{%- assign first_image              = section.settings.first_image -%}
{%- assign second_image             = section.settings.second_image -%}
{%- assign full_width               = section.settings.full_width -%}
{%- assign container                = section.settings.container_width -%}

{%- assign enable_color_scheme_inheritance 	= section.settings.enable_color_scheme_inheritance -%}
{%- assign color_scheme = section.settings.color_scheme -%}

{%- if enable_color_scheme_inheritance -%}
	{%- assign color_scheme = settings.main_color_scheme -%}
{%- endif -%}

{%- if container == 'inherit' -%}
	{%- assign container_width = settings.container_width -%}
{%- else -%}
	{%- assign container_width = container -%}
{%- endif -%}

{%- capture styles -%}
	--desktop-image-height: {{- desktop_image_height -}}; {{-  -}}
	--mobile-image-height: {{- mobile_image_height -}}; {{-  -}}
	--inner-offset-top: {{ section.settings.inner_offset_top -}}px; {{-  -}}
	--inner-offset-bottom: {{ section.settings.inner_offset_bottom -}}px; {{-  -}}
	--inner-offset-top-mobile: {{ section.settings.inner_offset_top_mobile -}}px; {{-  -}}
	--inner-offset-bottom-mobile: {{ section.settings.inner_offset_bottom_mobile -}}px; {{-  -}}
	--container-width: {{- container_width -}};
{%- endcapture -%}

{%- capture first_image_focal -%}
	--first-img-pos: {{- first_image.presentation.focal_point -}};
{%- endcapture -%}

{%- capture second_image_focal -%}
	--second-img-pos: {{- second_image.presentation.focal_point -}};
{%- endcapture -%}

{%- render 'adastra' with '/src/styles/before-after.scss' -%}

<section
	class="before-after container js-animate color-{{ color_scheme.id }} {% if request.visual_preview_mode %}animated{% endif %}"
	data-section-id="{{- section.id -}}"
	data-section-type="before-after"
	style="{{- styles -}}"
>
	{%- if heading_first_line != blank or heading_second_line != blank -%}
		<h2 class="h1 section-title section-title--center need-animate">
			{%- if heading_first_line != blank -%}
				<span class="section-title__text-container">
						<span class="section-title__text {% if heading_second_line == blank %}text-center{% endif %}">
							{{- heading_first_line -}}
						</span>
					</span>
			{%- endif -%}

			{%- if heading_second_line != blank -%}
				<span class="section-title__text-container">
						<span class="section-title__text {% if heading_first_line == blank %}text-center{% else %}text-right{% endif %}">
							{{- heading_second_line -}}
						</span>
					</span>
			{%- endif -%}
		</h2>
	{%- endif -%}

	<img-comparison-slider tabindex="0">
		{%- if first_image != blank -%}
			<img slot="first"
				 srcset="{{ first_image | img_url: "1920x" }} 1x , {{ first_image | img_url: "3840x" }} 2x"
				 alt="{{- first_image.alt -}}"
				 style="{{- first_image_focal -}}"
				 class="before-after__image before-after__image--first"
				{%- if section.index > 1 -%}
					loading="lazy"
				{%- endif -%}

			>
		{%- else -%}
			<div slot="first" class="before-after__placeholder">
				{{- 'lifestyle-2' | placeholder_svg_tag: 'before-after__image before-after__image--placeholder' -}}
			</div>
		{%- endif -%}

		{%- if second_image != blank -%}
			<img slot="second"
				 srcset="{{ second_image | img_url: "1920x" }} 1x , {{ second_image | img_url: "3840x" }} 2x"
				 alt="{{- first_image.alt -}}"
				 style="{{- second_image_focal -}}"
				 class="before-after__image before-after__image--second"
				{%- if section.index > 1 -%}
					loading="lazy"
				{%- endif -%}
			>
		{%- else -%}
			<div slot="second" class="before-after__placeholder">
				{{- 'lifestyle-2' | placeholder_svg_tag: 'before-after__image before-after__image--placeholder before-after__image--placeholder-compare' -}}
			</div>
		{%- endif -%}

		<div class="before-after__button button-circle button-circle--transform" slot="handle">
			<span class="button-circle__inner">
				{%- render 'icons', icon: 'circle-decoration' -%}
				{%- render 'icons', icon: 'slider-arrow-left', class: 'icon icon-inactive' -%}
				{%- render 'icons', icon: 'slider-arrow-right', class: 'icon icon-inactive' -%}
			</span>

			<span class="button-circle__text">
				{%- render 'icons', icon: 'slider-arrow-left', class: "icon-hover" -%}
				{%- render 'icons', icon: 'slider-arrow-right', class: "icon-hover" -%}
			</span>
		</div>
	</img-comparison-slider>
</section>

{%- render 'adastra' with '/src/scripts/section-before-after.js' -%}

