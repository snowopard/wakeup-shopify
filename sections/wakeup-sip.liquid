{%- comment -%}
------------------------------------------------------------------------------
	Section: Wake Up — SIP
------------------------------------------------------------------------------
{%- endcomment -%}

{%- assign eyebrow                        = section.settings.eyebrow -%}
{%- assign heading                        = section.settings.heading -%}
{%- assign supporting_text                = section.settings.supporting_text -%}

{%- assign background_image               = section.settings.background_image | default: section.settings.background_image_mobile -%}
{%- assign background_image_mobile        = section.settings.background_image_mobile -%}
{%- assign product_image                  = section.settings.product_image | default: section.settings.product_image_mobile -%}
{%- assign product_image_mobile           = section.settings.product_image_mobile -%}
{%- assign glass_image                    = section.settings.glass_image | default: section.settings.glass_image_mobile -%}
{%- assign glass_image_mobile             = section.settings.glass_image_mobile -%}
{%- assign splash_image                   = section.settings.splash_image -%}
{%- assign overlay_strength               = section.settings.overlay_strength -%}
{%- assign background_focal_point         = section.settings.background_focal_point -%}

{%- assign section_height                 = section.settings.section_height -%}
{%- assign product_position               = section.settings.product_position -%}
{%- assign content_alignment              = section.settings.content_alignment -%}
{%- assign show_transition_gradient       = section.settings.show_transition_gradient -%}

{%- case background_focal_point -%}
	{%- when 'top' -%}
		{%- assign focal_position = 'center top' -%}
	{%- when 'bottom' -%}
		{%- assign focal_position = 'center bottom' -%}
	{%- when 'left' -%}
		{%- assign focal_position = 'left center' -%}
	{%- when 'right' -%}
		{%- assign focal_position = 'right center' -%}
	{%- else -%}
		{%- assign focal_position = 'center center' -%}
{%- endcase -%}

{%- assign enable_color_scheme_inheritance = section.settings.enable_color_scheme_inheritance -%}
{%- assign color_scheme                    = section.settings.color_scheme -%}

{%- if enable_color_scheme_inheritance -%}
	{%- assign color_scheme = settings.main_color_scheme -%}
{%- endif -%}

{%- assign enable_lazy_load = true -%}

{%- if section.index == 1 -%}
	{%- assign enable_lazy_load = false -%}
{%- endif -%}

{{ 'wakeup-sip.css' | asset_url | stylesheet_tag }}

{%- capture sip_styles -%}
	--wakeup-sip-min-height: {{ section_height }};
	--wu-sip-overlay-opacity: {{ overlay_strength | divided_by: 100.0 }};
	--wu-sip-focal-position: {{ focal_position }};
{%- endcapture -%}

<section
	class="wakeup-sip js-animate {% if request.visual_preview_mode or section.index == 1 %}animated{% endif %} {% if color_scheme != blank %}color-{{ color_scheme.id }}{% endif %}"
	data-wu-theme="night"
	data-product-position="{{ product_position }}"
	data-content-alignment="{{ content_alignment }}"
	style="{{ sip_styles | strip_newlines }}"
>
	<div class="wakeup-sip__media" aria-hidden="true">
		{%- render 'theme-image',
			image: background_image,
			mobile_image: background_image_mobile,
			mobile_breakpoint: '767',
			img_class: 'wakeup-sip__bg-img',
			picture_class: 'wakeup-sip__bg-picture',
			alt: '',
			lazy: enable_lazy_load,
			src_width: 1600,
			src_crop: 'center',
			breakpoints: '480, 767, 1024, 1440, 1920',
			widths: '480, 767, 1024, 1440, 1920',
			svg_placeholder_name: 'lifestyle-1'
		-%}

		<div class="wakeup-sip__overlay"></div>

		{%- if show_transition_gradient -%}
			<div class="wakeup-sip__transition"></div>
		{%- endif -%}
	</div>

	<div class="wakeup-sip__content">
		<div class="wu-container wakeup-sip__inner">
			{%- if eyebrow != blank -%}
				<p class="wu-eyebrow wakeup-sip__eyebrow need-animate">{{- eyebrow -}}</p>
			{%- endif -%}

			{%- if heading != blank -%}
				<h2 class="wu-heading wu-heading--display wakeup-sip__heading need-animate">{{- heading -}}</h2>
			{%- endif -%}

			{%- if supporting_text != blank -%}
				<div class="wu-body wakeup-sip__text need-animate">{{- supporting_text -}}</div>
			{%- endif -%}
		</div>

		{%- if glass_image != blank or glass_image_mobile != blank -%}
			<div class="wakeup-sip__scene">
				<div class="wakeup-sip__glass need-animate">
					{%- render 'theme-image',
						image: glass_image,
						mobile_image: glass_image_mobile,
						mobile_breakpoint: '767',
						img_class: 'wakeup-sip__glass-img',
						picture_class: 'wakeup-sip__glass-picture',
						alt: glass_image.alt,
						lazy: enable_lazy_load,
						src_width: 900,
						svg_placeholder_name: 'product-2'
					-%}
				</div>

				{%- if product_image != blank or product_image_mobile != blank -%}
					<div class="wakeup-sip__product need-animate">
						{%- render 'theme-image',
							image: product_image,
							mobile_image: product_image_mobile,
							mobile_breakpoint: '767',
							img_class: 'wakeup-sip__product-img',
							picture_class: 'wakeup-sip__product-picture',
							alt: product_image.alt,
							lazy: enable_lazy_load,
							src_width: 500,
							svg_placeholder_name: 'product-1'
						-%}
					</div>
				{%- endif -%}

				{%- if splash_image != blank -%}
					<div class="wakeup-sip__splash need-animate" aria-hidden="true">
						{%- render 'theme-image',
							image: splash_image,
							img_class: 'wakeup-sip__splash-img',
							picture_class: 'wakeup-sip__splash-picture',
							alt: '',
							lazy: enable_lazy_load,
							src_width: 600,
							svg_placeholder_name: 'product-2'
						-%}
					</div>
				{%- endif -%}
			</div>
		{%- elsif product_image != blank or product_image_mobile != blank -%}
			<div class="wakeup-sip__scene wakeup-sip__scene--product-only">
				<div class="wakeup-sip__product need-animate">
					{%- render 'theme-image',
						image: product_image,
						mobile_image: product_image_mobile,
						mobile_breakpoint: '767',
						img_class: 'wakeup-sip__product-img',
						picture_class: 'wakeup-sip__product-picture',
						alt: product_image.alt,
						lazy: enable_lazy_load,
						src_width: 700,
						svg_placeholder_name: 'product-1'
					-%}
				</div>
			</div>
		{%- endif -%}
	</div>
</section>

{%- schema -%}
{
	"name": "Wake Up: SIP",
	"class": "shopify-section--wakeup-sip",
	"disabled_on": {
		"groups": ["header", "footer", "custom.popup"]
	},
	"settings": [
		{
			"type": "header",
			"content": "Content"
		},
		{
			"type": "text",
			"id": "eyebrow",
			"label": "Step label / eyebrow",
			"info": "Optional. Keep it short."
		},
		{
			"type": "inline_richtext",
			"id": "heading",
			"label": "Heading",
			"default": "SIP."
		},
		{
			"type": "richtext",
			"id": "supporting_text",
			"label": "Supporting text",
			"default": "<p>Cold water. A steady hand. The ritual begins.</p>"
		},
		{
			"type": "header",
			"content": "Media"
		},
		{
			"type": "image_picker",
			"id": "background_image",
			"label": "Background image (desktop)",
			"info": "Cool water / freshness atmosphere. 2400px width recommended."
		},
		{
			"type": "image_picker",
			"id": "background_image_mobile",
			"label": "Background image (mobile)",
			"info": "Optional. Falls back to the desktop image if not set."
		},
		{
			"type": "image_picker",
			"id": "product_image",
			"label": "Sachet / product image",
			"info": "The same product, now in use. 1200px width recommended."
		},
		{
			"type": "image_picker",
			"id": "product_image_mobile",
			"label": "Sachet / product image (mobile)",
			"info": "Optional. Falls back to the desktop image if not set."
		},
		{
			"type": "image_picker",
			"id": "glass_image",
			"label": "Glass / water image",
			"info": "The product in preparation — glass, water, ice. 1600px width recommended."
		},
		{
			"type": "image_picker",
			"id": "glass_image_mobile",
			"label": "Glass / water image (mobile)",
			"info": "Optional. Falls back to the desktop image if not set."
		},
		{
			"type": "image_picker",
			"id": "splash_image",
			"label": "Ice / splash / condensation overlay",
			"info": "Fully optional decorative layer. Only renders if an image is set here."
		},
		{
			"type": "range",
			"id": "overlay_strength",
			"label": "Overlay strength",
			"min": 0,
			"max": 90,
			"step": 5,
			"unit": "%",
			"default": 55,
			"info": "Controls how strongly the cool-blue atmosphere tints the background image."
		},
		{
			"type": "select",
			"id": "background_focal_point",
			"label": "Background focal point",
			"info": "Controls which part of the background image stays visible when cropped.",
			"options": [
				{
					"value": "center",
					"label": "Center"
				},
				{
					"value": "top",
					"label": "Top"
				},
				{
					"value": "bottom",
					"label": "Bottom"
				},
				{
					"value": "left",
					"label": "Left"
				},
				{
					"value": "right",
					"label": "Right"
				}
			],
			"default": "center"
		},
		{
			"type": "header",
			"content": "Layout"
		},
		{
			"type": "select",
			"id": "section_height",
			"label": "Section height",
			"options": [
				{
					"value": "auto",
					"label": "Auto (content height, recommended)"
				},
				{
					"value": "90svh",
					"label": "Tall"
				},
				{
					"value": "100svh",
					"label": "Full screen"
				}
			],
			"default": "auto"
		},
		{
			"type": "select",
			"id": "product_position",
			"label": "Scene position (desktop)",
			"info": "Desktop only — the scene always stays centered on mobile and tablet.",
			"options": [
				{
					"value": "center",
					"label": "Center"
				},
				{
					"value": "left",
					"label": "Left"
				},
				{
					"value": "right",
					"label": "Right"
				}
			],
			"default": "center"
		},
		{
			"type": "select",
			"id": "content_alignment",
			"label": "Content alignment",
			"info": "Applies at all breakpoints.",
			"options": [
				{
					"value": "center",
					"label": "Center"
				},
				{
					"value": "left",
					"label": "Left"
				}
			],
			"default": "center"
		},
		{
			"type": "checkbox",
			"id": "show_transition_gradient",
			"label": "Show SIP → transition atmosphere",
			"default": true,
			"info": "A brightening blue gradient at the bottom of the section that prepares the handoff into the Night → Morning transition."
		},
		{
			"type": "header",
			"content": "Colors"
		},
		{
			"type": "checkbox",
			"id": "enable_color_scheme_inheritance",
			"label": "Enable color scheme inheritance",
			"default": false,
			"info": "SIP uses its own cool-blue palette by default. Enable this to force it to follow the theme's main color scheme instead."
		},
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"label": "Color scheme",
			"default": "scheme-1",
			"info": "Only affects elements that don't already use the Wake Up palette."
		}
	],
	"presets": [
		{
			"name": "Wake Up: SIP"
		}
	]
}
{%- endschema -%}
