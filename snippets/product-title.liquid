{% comment %}
------------------------------------------------------------------------------
  Snippet: Product Title
------------------------------------------------------------------------------
{% endcomment %}
{%- assign preset_title 				= 'Product title' -%}
{%- assign title 						= product.title -%}
{%- assign enable_custom_font_and_color = block.settings.enable_custom_font_and_color -%}
{%- assign heading_font_product 		= block.settings.heading_font_product -%}
{%- assign color_heading_product 		= block.settings.color_heading_product -%}

{% if is_preset %}
	{% assign title = preset_title %}
{% endif %}

{%- if enable_custom_font_and_color -%}
	<style>{{- heading_font_product | font_face: font_display: 'swap' -}}</style>
{%- endif -%}

{%- capture styles -%}
	{% if enable_custom_font_and_color %}
		--product-heading-font: {{ heading_font_product.family | replace: '"', "'" }}, {{ heading_font_product.fallback_families }}; {{-  -}}
		--product-heading-font-weight: {{- heading_font_product.weight -}}; {{-  -}}
		{% if color_heading_product != blank %}
			--color-heading-product: {{- color_heading_product -}}; {{-  -}}
		{% endif %}
	{% endif %}
	--offset-top-desktop: {{ block.settings.offset_top_desktop }}px; {{-  -}}
	--offset-bottom-desktop: {{ block.settings.offset_bottom_desktop }}px; {{-  -}}
	--offset-top-mobile: {{ block.settings.offset_top_mobile }}px; {{-  -}}
	--offset-bottom-mobile: {{ block.settings.offset_bottom_mobile }}px;
{%- endcapture -%}

{%- capture title_classes -%}
	product-title{% if enable_custom_font_and_color %} product-title--custom-font-and-color{% endif %} h4 js-product-title
{%- endcapture -%}

<div class="product-title-wrapper" style="{{ styles }}">
	{% if template.name == 'product' %}
		<h1 class="{{ title_classes }}">
			{{- title -}}
		</h1>
	{% else %}
		<a
			class="{{ title_classes }} focus-visible-outline"
			href="{{- product.url -}}"
		>
			{{- title -}}
		</a>
	{% endif %}
</div>
