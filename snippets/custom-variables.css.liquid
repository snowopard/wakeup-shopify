<style>
	shopify-accelerated-checkout {
		--shopify-accelerated-checkout-button-block-size: 54px;
		--shopify-accelerated-checkout-button-border-radius: 4px;
		--shopify-accelerated-checkout-button-box-shadow: none;
		--shopify-accelerated-checkout-skeleton-background-color: #dedede;
		--shopify-accelerated-checkout-skeleton-animation-opacity-start: 1;
		--shopify-accelerated-checkout-skeleton-animation-opacity-end: 0.5;
		--shopify-accelerated-checkout-skeleton-animation-duration: 4s;
		--shopify-accelerated-checkout-skeleton-animation-timing-function: ease;
	}
	shopify-accelerated-checkout-cart {
		--shopify-accelerated-checkout-button-block-size: 58px;
		--shopify-accelerated-checkout-button-inline-size: 58px;
		--shopify-accelerated-checkout-button-border-radius: 4px;
		--shopify-accelerated-checkout-button-box-shadow: none;
		--shopify-accelerated-checkout-inline-alignment: flex-start;
		--shopify-accelerated-checkout-row-gap: 12px;
		--shopify-accelerated-checkout-skeleton-background-color: #dedede;
		--shopify-accelerated-checkout-skeleton-animation-opacity-start: 1;
		--shopify-accelerated-checkout-skeleton-animation-opacity-end: 0.5;
		--shopify-accelerated-checkout-skeleton-animation-duration: 4s;
		--shopify-accelerated-checkout-skeleton-animation-timing-function: ease;
	}

	{% comment  %}
		*** Global ***
	{% endcomment %}
	:root {
		{% comment  %} Container {% endcomment %}
		--global-container-width: {{ settings.container_width }};
		--global-border-radius: 16px;
		--global-gap: 16px;
		--global-gap-small: 8px;

		{% comment %} Images {% endcomment %}
		--loading-image: url({{- "loading.svg" | asset_url -}});

		{% comment %} Product Card {% endcomment %}
		--product-card-object-fit: {{- settings.image_object_fit -}};
		--color-background-quick-buttons: {{ settings.bg_quick_buttons }};
		--color-border-quick-buttons: {{ settings.border_color_quick_buttons }};
		--color-border-quick-buttons-alpha: {{ settings.border_color_quick_buttons | color_modify: 'alpha', 0.16 }};
		--color-text-quick-buttons: {{ settings.color_quick_buttons }};
		--color-background-quick-buttons-hover: {{ settings.bg_quick_buttons_hover }};
		--color-text-quick-buttons-hover: {{ settings.color_quick_buttons_hover }};

		--color-product-card-swatch-container: {{ settings.product_card_swatches_container }};
		--color-product-card-swatch-bg: {{ settings.product_card_swatch_background }};
		--color-product-card-swatch-bg-active: {{ settings.product_card_swatch_background_active }};
		--color-product-card-swatch-border: {{ settings.product_card_swatch_border }};
		--color-product-card-swatch-border-active: {{ settings.product_card_swatch_border_active }};
		--color-product-card-swatch-count: {{ settings.product_card_swatch_count }};

		{% comment %} Product labels {% endcomment %}
		--color-sale-label: {{ settings.color_label_sale }};
		--color-label-base: {{- settings.color_label_base -}};
		--color-label-primary: {{- settings.color_label_primary -}};
		--color-label-secondary: {{- settings.color_label_secondary -}};
		--color-label-sold-out: {{- settings.color_label_sold_out -}};

		--color-background-label-base: {{- settings.color_label_base_background -}};
		--color-background-label-primary: {{- settings.color_label_primary_background -}};
		--color-background-label-secondary: {{- settings.color_label_secondary_background -}};
		--color-background-label-sale: {{- settings.color_label_sale_background -}};
		--color-background-label-sold-out: {{- settings.color_label_sold_out_background -}};

		{% comment %} Other UI elements {% endcomment %}
		--color-compare-sticky-button-bg: {{ settings.compare_sticky_button_bg }};
		--color-compare-sticky-button-color: {{ settings.compare_sticky_button_color }};
		--color-pdp-compare-remove-button-color: {{ settings.compare_remove_button_color }};
		--color-pdp-compare-remove-button-background: {{ settings.compare_remove_button_background }};
		--color-pdp-compare-remove-border-color: {{ settings.compare_remove_border_color }};
	}

	{% comment %} Fonts {% endcomment %}
	{% assign base_bold_font = settings.base_font | font_modify: 'weight', 'bold' %}
	{% assign base_bold_font_medium = settings.base_font | font_modify: 'weight', '500' %}
	{% assign base_italic_font = settings.base_font | font_modify: 'style', 'italic' %}
	{% assign base_bold_italic_font = settings.base_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' %}
	{% assign heading_thin_italic = settings.heading_font | font_modify: 'weight', '200' | font_modify: 'style', 'italic' %}

	{% if heading_thin_italic == nil %}
		{% assign heading_thin_italic = settings.heading_font | font_modify: 'weight', '300' | font_modify: 'style', 'italic' %}
	{% endif %}

	{{- settings.base_font | font_face: font_display: 'swap' -}}
	{{- base_bold_font | font_face: font_display: 'swap' -}}
	{{- base_bold_font_medium | font_face: font_display: 'swap' -}}
	{{- base_italic_font | font_face: font_display: 'swap' -}}
	{{- base_bold_italic_font| font_face: font_display: 'swap' }}
	{{- settings.heading_font | font_face: font_display: 'swap' -}}
	{{- settings.heading_font_second | font_face: font_display: 'swap' -}}
	{{- heading_thin_italic | font_face: font_display: 'swap' -}}
	{{- settings.button_font_family | font_face: font_display: 'swap' -}}

	{% if settings.uppercase %}
		{% assign heading-text-transform = 'uppercase' %}
	{% else %}
		{% assign heading-text-transform = 'none' %}
	{% endif %}

	{% if settings.button_font_uppercase %}
		{% assign button_text_transform = 'uppercase' %}
	{% else %}
		{% assign button_text_transform = 'none' %}
	{% endif %}

	:root {
		--body-font-size: {{- settings.base_font_size | times: 0.1391 | round -}}px;
		--body-font-size-without-unit: {{- settings.base_font_size | times: 0.1391 | round -}};
		--heading-font-size: {{- settings.heading_font_size | times: 0.1391 | round -}}px;
		--base-font-family: {{ settings.base_font.family }}, {{ settings.base_font.fallback_families }};
		--heading-font-family: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
		--heading-font-weight: {{- settings.heading_font.weight -}};
		--heading-font-second-family: {{ settings.heading_font_second.family }}, {{ settings.heading_font_second.fallback_families }};
		--heading-font-second-weight: {{- settings.heading_font_second.weight -}};
		--heading-text-transform: {{- heading-text-transform -}};
		--button-font-family: {{ settings.button_font_family.family }}, {{ settings.button_font_family.fallback_families }};
		--button-font-weight: {{ settings.button_font_family.weight }};
		--button-font-size: {{- settings.button_font_size | times: 0.1391 | round -}}px;
		--button-text-transform: {{- button_text_transform -}};
	}

	{%- assign color_scroll_thumb_opacity	= settings.color_scroll_thumb_opacity | divided_by: 100.0 | default: 0.2 -%}
	{%- assign color_scroll_track_opacity	= settings.color_scroll_track_opacity | divided_by: 100.0 | default: 0.0 -%}

	@media (-moz-touch-enabled: 0), (hover: hover) {
		body * {
			scrollbar-color: {{- settings.color_scroll_thumb | color_modify: 'alpha', color_scroll_thumb_opacity }} {{ settings.color_scroll_track | color_modify: 'alpha', color_scroll_track_opacity -}};
		}

		body *::-webkit-scrollbar-track {
			background-color: {{- settings.color_scroll_track | color_modify: 'alpha', color_scroll_track_opacity -}};
		}

		body *::-webkit-scrollbar-thumb {
			background-color: {{- settings.color_scroll_thumb | color_modify: 'alpha', color_scroll_thumb_opacity -}};
		}
	}


	{% comment %}
		*** Color schemes ***
	{% endcomment %}

	{% assign main_color_scheme = settings.main_color_scheme %}

	{% for scheme in settings.color_schemes -%}
		{% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}

		{% if main_color_scheme == scheme -%}
		:root,
		{%- endif %}
		.color-{{ scheme.id }} {
			{% comment %} Text colors {% endcomment %}
			--color-text-primary: {{- scheme.settings.color_text_primary | default: '#000' -}};
			--color-text-primary-alpha: {{- scheme.settings.color_text_primary | color_modify: 'alpha', 0.12 -}};
			--color-text-secondary: {{- scheme.settings.color_text_secondary | default: '#535353' -}};
			--color-text-thirdly: {{- scheme.settings.color_text_thirdly | default: '#9D9D9D' -}};
			--color-heading: {{- scheme.settings.color_text_heading | default: '#000' -}};
			--link-color: {{- scheme.settings.color_link -}};
			--color-accent: {{- scheme.settings.color_accent | default: '#FFD875' -}};
			--color-text-attention: {{ scheme.settings.color_support_attention | default: '#D33636' }};
			--color-text-success: {{ scheme.settings.color_support_success | default: '#81B154' }};
			--color-text-attention-lighten: {{ scheme.settings.color_support_attention | default: '#D33636' | color_modify: 'alpha', 0.34 }};
			--color-text-success-lighten: {{ scheme.settings.color_support_success | default: '#81B154' | color_modify: 'alpha', 0.2 }};

			{% comment %} Background colors {% endcomment %}
			--color-background: {{- scheme.settings.color_background | default: '#fff' -}};
			--color-background-alpha: {{ scheme.settings.color_background | color_modify: 'alpha', 0.9 }};
			--color-background-darken: {{ scheme.settings.color_background | color_darken: 2.8 }};
			--color-background-secondary: {{ scheme.settings.color_background_secondary }};
			--color-background-popup-drawer: {{ scheme.settings.color_background_popup_drawer }};
			--color-background-popup-drawer-alpha: {{ scheme.settings.color_background_popup_drawer | color_modify: 'alpha', 0.9 }};

			{%- assign background_brightness = scheme.settings.color_background | color_brightness -%}
			{%- if background_brightness < 128 -%}
				--color-background-modified: {{ scheme.settings.color_background | color_lighten: 13 | color_modify: 'alpha', 0.90 }};
				--color-img-placeholder-bg: {{ scheme.settings.color_background | color_lighten: 7 }};
			{%- else -%}
				--color-background-modified: {{ scheme.settings.color_background | color_darken: 3 | color_modify: 'alpha', 0.90 }};
				--color-img-placeholder-bg: {{ scheme.settings.color_background | color_darken: 7 }};
			{%- endif -%}

			{% comment %} Button primary {% endcomment %}
			--button-text-color-primary: {{- scheme.settings.button_text_color_primary -}};
			--button-background-color-primary: {{- scheme.settings.button_background_color_primary -}};
			--button-border-color-primary: {{- scheme.settings.button_border_color_primary -}};
			--button-border-outer-color-primary: {{- scheme.settings.button_border_outer_color_primary -}};
			--button-border-outer-alpha-color-primary: {{- scheme.settings.button_border_outer_color_primary | color_modify: 'alpha', 0.16 -}};

			--button-text-color-primary-hover: {{- scheme.settings.button_text_color_primary_hover -}};
			--button-background-color-primary-hover: {{- scheme.settings.button_background_color_primary_hover -}};
			--button-border-color-primary-hover: {{- scheme.settings.button_border_color_primary_hover -}};
			--button-border-outer-color-primary-hover: {{- scheme.settings.button_border_outer_color_primary_hover -}};
			--button-border-outer-alpha-color-primary-hover: {{- scheme.settings.button_border_outer_color_primary_hover | color_modify: 'alpha', 0.16 -}};

			{% comment %} Button icon {% endcomment %}
			--button-icon-text-color: {{- scheme.settings.button_text_color_primary -}};
			--button-icon-background-color: {{- scheme.settings.button_background_color_primary -}};
			--button-icon-border-color: {{- scheme.settings.button_border_color_primary -}};
			--button-icon-border-outer-color: {{- scheme.settings.button_border_outer_color_primary -}};
			--button-icon-border-outer-alpha-color: {{- scheme.settings.button_border_outer_color_primary | color_modify: 'alpha', 0.16 -}};
			--button-icon-counter-text-color: {{- scheme.settings.button_background_color_primary -}};
			--button-icon-counter-background-color: {{- scheme.settings.button_text_color_primary -}};

			--button-icon-text-color-hover: {{- scheme.settings.button_text_color_primary_hover -}};
			--button-icon-background-color-hover: {{- scheme.settings.button_background_color_primary_hover -}};
			--button-icon-border-color-hover: {{- scheme.settings.button_border_color_primary_hover -}};
			--button-icon-border-outer-color-hover: {{- scheme.settings.button_border_outer_color_primary_hover -}};
			--button-icon-border-outer-alpha-color-hover: {{- scheme.settings.button_border_outer_color_primary_hover | color_modify: 'alpha', 0.16 -}};
			--button-icon-counter-text-color-hover: {{- scheme.settings.button_background_color_primary_hover -}};
			--button-icon-counter-background-color-hover: {{- scheme.settings.button_text_color_primary_hover -}};

			{% comment %} Button circle icon {% endcomment %}

			--button-icon-circle-text-color: {{- scheme.settings.color_text_primary | default: '#000' -}};
			--button-icon-circle-text-color-hover: {{- scheme.settings.color_text_primary | default: '#000' -}};

			{% comment %}Button secondary{% endcomment %}
			--button-text-color-secondary: {{- scheme.settings.button_text_color_secondary -}};
			--button-background-color-secondary: {{- scheme.settings.button_background_color_secondary -}};
			--button-border-color-secondary: {{- scheme.settings.button_border_color_secondary -}};

			--button-text-color-secondary-hover: {{- scheme.settings.button_text_color_secondary_hover -}};
			--button-background-color-secondary-hover: {{- scheme.settings.button_background_color_secondary_hover -}};
			--button-border-color-secondary-hover: {{- scheme.settings.button_border_color_secondary_hover -}};

			{% comment %} Button circle {% endcomment %}

			--button-icon-color-circle: {{- scheme.settings.button_icon_color_circle -}};
			--button-background-color-circle: {{- scheme.settings.button_background_color_circle -}};
			--button-border-color-circle: {{- scheme.settings.button_border_color_circle -}};
			--button-border-outer-color-circle: {{- scheme.settings.button_border_outer_color_circle -}};

			--button-icon-color-circle-hover: {{- scheme.settings.button_icon_color_circle_hover -}};
			--button-background-color-circle-hover: {{- scheme.settings.button_background_color_circle_hover -}};
			--button-border-color-circle-hover: {{- scheme.settings.button_border_color_circle_hover -}};
			--button-border-outer-color-circle-hover: {{- scheme.settings.button_border_outer_color_circle_hover -}};

			{% comment %} Border colors {% endcomment %}
			--color-border-primary: {{- scheme.settings.color_border_primary -}};
			--color-border-secondary: {{- scheme.settings.color_border_secondary -}};
			--color-border-thirdly: {{- scheme.settings.color_border_thirdly -}};

			{% comment %}Product colors{% endcomment %}
			--product-sale-price-color: {{- scheme.settings.product_sale_price -}};

			{% comment %}Button media{% endcomment %}
			--button-icon-color-social: {{- scheme.settings.button_icon_color_social -}};
			--button-icon-color-social-hover: {{- scheme.settings.button_icon_color_social_hover -}};

			{% comment %} Slider {% endcomment %}
			--color-slider-arrow-icon: {{- scheme.settings.color_slider_arrow_icon -}};

			--color-slider-arrow-icon-hover: {{- scheme.settings.color_slider_arrow_icon_hover -}};

			{% comment %} Button option {% endcomment %}
			--color-button-option: {{- scheme.settings.color_button_option -}};
			--background-button-option: {{- scheme.settings.background_button_option -}};
			--color-border-button-option: {{- scheme.settings.color_button_option | color_modify: 'alpha', 0.2 -}};

			--color-button-option-hover: {{- scheme.settings.color_hover_button_option -}};
			--background-button-option-hover: {{- scheme.settings.background_hover_button_option -}};
			--color-border-button-option-hover: {{- scheme.settings.color_hover_button_option | color_modify: 'alpha', 0.43 -}};

			{% comment %} Preloader colors {% endcomment %}
			--color-preloader-primary: {{- scheme.settings.color_loader_circle | default: '#E6E6E6' -}};
			--color-preloader-secondary: {{- scheme.settings.color_loader_item | default: '#000' -}};
			--background-color-preloader: {{- scheme.settings.color_loader_overlay | color_modify: 'alpha', 0.35 -}};

			{% comment %} Custom select colors {% endcomment %}
			--color-custom-select-trigger-background: {{- scheme.settings.color_text_primary | color_modify: 'alpha', 0.06 -}};
		}
	{% endfor %}
</style>
