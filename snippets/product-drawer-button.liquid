{%- comment -%}
	------------------------------------------------------------------------------
	Snippet: Product drawer button

	- icon: image,
	- target: string,
	- text: string

	{%- render "product-drawer-button", icon: image, target: target, text: text -%}
	------------------------------------------------------------------------------
{%- endcomment -%}

<div class="product-form__block">
	<button
		type="button"
		class="button-link button-link--full-width"
		data-target="{{ target }}"
		data-js-toggle="{{ target }}"
	>
		{%- if icon != blank -%}
			{%- capture img_focal -%}
				--img-desktop-pos: {{ icon.presentation.focal_point }};
			{%- endcapture -%}

			<img
				class="button-link__pre-icon"
				srcset="{{ icon | image_url: width: 24, height: 24 }} 1x,
								{{ icon | image_url: width: 48, height: 48 }} 2x"
				src="{{- icon | image_url: width: 24, height: 24 -}}"
				aria-hidden="true"
				width="24"
				height="24"
				style="{{ img_focal }}"
				alt=""
				loading="lazy"
			/>
		{%- endif -%}

		<span data-text="{{- text -}}">
			<span class="button-link__text">{{- text -}}</span>
		</span>

		<span class="button-link__icons">
			{% render 'icons', icon: 'arrow-right', class: 'icon-base' %}
			{% render 'icons', icon: 'arrow-right', class: 'icon-hover' %}
		</span>
	</button>
</div>
