{%- comment -%}
	------------------------------------------------------------------------------
	Snippet: Product card
	- product: product object (required, object)
	- is_lazy: is lazy load enable (optional, default: true, boolean)
	- hide_button: is hide button (optional, default: false, boolean)
{%- endcomment -%}

{%- assign currency_code_enabled	= settings.is_currency_code_enabled -%}
{%- assign show_unit_price			= settings.is_show_unit_price -%}
{%- assign product_color 			= product.metafields.custom.main_background_color -%}

{%- render 'adastra' with '/src/styles/product-card-mini.scss' -%}

<article
	class="product-card-mini"
	{% if product_color != blank %}
		style="--product-main-color: {{ product_color }};"
	{% endif %}
>
	<div class="product-card-mini__container">
		<a href="{{- product.url -}}"
		   class="product-card-mini__image-wrapper {% if product_color != blank %}product-card-mini__image-wrapper--ellipse{%- endif -%}"
		   aria-label="{{- product.title | escape -}}"
		>
			{%- if product != blank -%}
				{%- assign image = product.featured_image | default: settings.product_default_image -%}

				{%- capture image_eager -%}
					<picture>
						<source
							srcset="{{ image | img_url: '108x' }} 1x, {{ image | img_url: '216x' }} 2x"
							media="(max-width: 1500px)"
							width="108"
							height="108"
						>

						<img
							class="product-card-mini__image"
							src="{{ image | img_url: '144x' }}"
							srcset="{{ image | img_url: '144x'  }} 1x, {{ image | img_url: '288x' }} 2x"
							width="144"
							height="144"
							alt="{{- image.alt | escape -}}"
						/>
					</picture>
				{%- endcapture -%}

				{%- if enable_lazy_load -%}
					<picture class="lazy">
						<source
							data-srcset="{{ image | img_url: '108x' }} 1x, {{ image | img_url: '216x' }} 2x"
							srcset="{{ image | img_url: '10x' }} 1x, {{ image | img_url: '10x' }} 2x"
							media="(max-width: 1500px)"
							width="108"
							height="108"
						>

						<img
							class="product-card-mini__image"
							src="{{ image | image | img_url: '10x' }}"
							data-src="{{ image | img_url: '144x' }}"
							srcset="{{ image | img_url: '10x'  }} 1x, {{ image | img_url: '10x' }} 2x"
							data-srcset="{{ image | img_url: '144x' }} 1x, {{ image | img_url: '288x' }} 2x"
							width="144"
							height="144"
							alt="{{- image.alt | escape -}}"
							fetchpriority="low"
						/>
					</picture>
				{%- else -%}
					{{- image_eager -}}
				{%- endif -%}
			{%- else -%}
				{%- assign min	     = 1 -%}
				{%- assign max       = 5 -%}
				{%- assign diff	     = max | minus: min -%}
				{%- assign random_number		= "now" | date: "%N" | modulo: diff | plus: min -%}
				{%- assign placeholder_svg_name	= 'product-apparel-' | append: random_number -%}
				{{- placeholder_svg_name | placeholder_svg_tag: 'product-card-mini__image product-card-mini__image--placeholder' -}}
			{%- endif -%}
		</a>

		<div class="product-card-mini__content">
			<a class="product-card-mini__title" href="{{ product.url }}">
				{%- if product != blank -%}
					{{- product.title -}}
				{%- else -%}
					{{- 'products.product_card.product_title' | t -}}
				{%- endif -%}
			</a>

			<div class="product-card-mini__content-inner">
				<div class="product-card-mini__price {% if hide_button != true %}product-card-mini__price--wrap{%- endif -%}">
					{%- render 'price', product: product, show_unit_price: show_unit_price, currency_code_enabled: currency_code_enabled, simplified_view: simplified_view -%}
				</div>

				{%- if hide_button != true -%}
					{% if product.available %}
						{%- if product.has_only_default_variant or product.variants.size == 1 -%}
							{% if product.template_suffix == 'pre-order' %}
								{%- assign button_label = 'products.product.pre_order' | t | escape -%}
							{% else %}
								{%- assign button_label = 'products.product_card.add_to_cart' | t | escape -%}
							{% endif %}
						{%- else -%}
							{%- assign button_label = 'products.product_card.open_quick_view' | t | escape -%}
						{%- endif -%}
					{% else %}
						{%- assign button_label = 'products.product.sold_out' | t | escape -%}
					{% endif %}

					<button
						class="button-circle button-circle--small product-card-mini__button product-card-mini__button--js js-add-to-cart"
						type="button"
						{% if product.template_suffix == 'pre-order' %}data-preorder{% endif %}
						{% if product != blank %}
							data-product-handle="{{- product.handle -}}"
							data-min-quantity="{{- product.selected_or_first_available_variant.quantity_rule.min -}}"
							{% if product.has_only_default_variant or product.variants.size == 1 %}
								data-variant-id="{{- product.variants[0].id -}}"
							{% endif %}
						{% endif %}
						{% unless product.available %}
							disabled
						{% endunless %}
						title="{{- button_label -}}"
						aria-label="{{- button_label -}}"
					>
						<span class="button-circle__inner">
							{%- render 'icons', icon: 'circle-decoration' -%}
							{%- render 'icons', icon: 'plus' -%}
						</span>
					</button>
				{%- endif -%}
			</div>
		</div>
	</div>
</article>
