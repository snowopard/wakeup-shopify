{%- comment -%}
------------------------------------------------------------------------------
	Snippet: Password content image
------------------------------------------------------------------------------
{%- endcomment -%}

{%- assign image_size_375_2x 	= image_size_375 | times: 2 -%}
{%- assign image_size_420_2x 	= image_size_420 | times: 2 -%}
{%- assign image_size_767_2x 	= image_size_767 | times: 2 -%}
{%- assign image_size_991_2x 	= image_size_991 | times: 2 -%}
{%- assign image_size_1199_2x 	= image_size_1199 | times: 2 -%}
{%- assign image_size_2x 	 	= image_size | times: 2 -%}

{%- if image != blank -%}
	{%- capture img_focal -%}
		--img-pos: {{ image.presentation.focal_point }};
	{%- endcapture -%}

	<picture class="password-content__image-inner {{ image_class }} need-animate">
		{%- if image_size_375 != blank -%}
			<source
				srcset="{{ image | image_url: width: image_size_375 }} 1x,
						{{ image | image_url: width: image_size_375_2x }} 2x"
				media="(max-width: 375px)"
				width="{{ image_size_375 }}"
				height="{{ image_size_375 }}"
			/>
		{%- endif -%}

		{%- if image_size_420 != blank -%}
			<source
				srcset="{{ image | image_url: width: image_size_420 }} 1x,
						{{ image | image_url: width: image_size_420_2x }} 2x"
				media="(max-width: 420px)"
				width="{{ image_size_420 }}"
				height="{{ image_size_420 }}"
			/>
		{%- endif -%}

		{%- if image_size_767 != blank -%}
			<source
				srcset="{{ image | image_url: width: image_size_767 }} 1x,
						{{ image | image_url: width: image_size_767_2x }} 2x"
				media="(max-width: 767px)"
				width="{{ image_size_767 }}"
				height="{{ image_size_767 }}"
			/>
		{%- endif -%}

		{%- if image_size_991 != blank -%}
			<source
				srcset="{{ image | image_url: width: image_size_991 }} 1x,
						{{ image |  image_url: width: image_size_991_2x }} 2x"
				media="(max-width: 991px)"
				width="{{ image_size_991 }}"
				height="{{ image_size_991 }}"
			/>
		{%- endif -%}

		{%- if image_size_1199 != blank -%}
			<source
				srcset="{{ image | image_url: width: image_size_1199 }} 1x,
						{{ image | image_url: width: image_size_1199_2x }} 2x"
				media="(max-width: 1199px)"
				width="{{ image_size_1199 }}"
				height="{{ image_size_1199 }}"
			/>
		{%- endif -%}

		<img
			class="password-content__image"
			srcset="{{ image | image_url: width: image_size }} 1x,
					{{ image | image_url: width: image_size_2x }} 2x"
			src="{{ image | image_url: width: image_size }}"
			alt="{{- image.alt -}}"
			width="{{ image_size }}"
			height="{{ image_size }}"
			style="{{ img_focal }}"
		/>
	</picture>
{%- else -%}
	{{- 'image' | placeholder_svg_tag: 'password-content__image password-content__image--placeholder' -}}
{%- endif -%}
