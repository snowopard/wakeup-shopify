{%- assign enable_variant_images 			= settings.is_images_swatches_enabled -%}

{%- assign swatch_option					= settings.color_swatches_option | default: 'Color' | downcase -%}
{%- assign swatches 						= swatch_option | split: ',' -%}
{%- assign is_color_swatches_enabled		= settings.is_color_swatches_enabled -%}
{%- assign variants_type					= settings.quick_view_variant_picker -%}
{%- assign swatch_type 						= settings.quick_view_color_swatch_type -%}
{%- assign enable_compare_products 			= settings.enable_compare_products -%}

{%- assign add_to_card_button_text_color				= settings.quick_view_add_to_card_button_text_color -%}
{%- assign add_to_card_button_background_color			= settings.quick_view_add_to_card_button_background_color -%}
{%- assign add_to_card_button_border_color				= settings.quick_view_add_to_card_button_border_color -%}
{%- assign add_to_card_button_text_color_hover			= settings.quick_view_add_to_card_button_text_color_hover -%}
{%- assign add_to_card_button_background_color_hover	= settings.quick_view_add_to_card_button_background_color_hover -%}
{%- assign add_to_card_button_border_color_hover		= settings.quick_view_add_to_card_button_border_color_hover -%}

{%- assign compare_button_text_color				= settings.quick_view_compare_button_text_color -%}
{%- assign compare_button_background_color			= settings.quick_view_compare_button_background_color -%}
{%- assign compare_button_border_color				= settings.quick_view_compare_button_border_color -%}
{%- assign compare_button_text_color_hover			= settings.quick_view_compare_button_text_color_hover -%}
{%- assign compare_button_background_color_hover	= settings.quick_view_compare_button_background_color_hover -%}
{%- assign compare_button_border_color_hover		= settings.quick_view_compare_button_border_color_hover -%}

{%- capture add_to_card_button_styles -%}
	--text-color: {{- add_to_card_button_text_color -}};  {{-  -}}
	--background-color: {{- add_to_card_button_background_color -}};  {{-  -}}
	--border-color: {{- add_to_card_button_border_color -}};  {{-  -}}
	--text-color-hover: {{- add_to_card_button_text_color_hover -}};  {{-  -}}
	--background-color-hover: {{- add_to_card_button_background_color_hover -}};  {{-  -}}
	--border-color-hover: {{- add_to_card_button_border_color_hover -}};  {{-  -}}
{%- endcapture -%}

{%- capture compare_button_styles -%}
	--text-color: {{- compare_button_text_color -}};  {{-  -}}
	--background-color: {{- compare_button_background_color -}};  {{-  -}}
	--border-color: {{- compare_button_border_color -}};  {{-  -}}
	--text-color-hover: {{- compare_button_text_color_hover -}};  {{-  -}}
	--background-color-hover: {{- compare_button_background_color_hover -}};  {{-  -}}
	--border-color-hover: {{- compare_button_border_color_hover -}};  {{-  -}}
{%- endcapture -%}

{% case swatch_type %}
	{% when 'rectangle' %}
		{% assign swatch_container_class	= 'product-options__swatch-container product-options__swatch-container--small-gap' %}
		{% assign swatch_class 				= 'radio-option-swatch-rectangle' %}
		{% assign swatch_label_class 		= 'radio-option-swatch-rectangle__label' %}
		{% assign swatch_size 				= 64 %}
	{% when 'square' %}
		{% assign swatch_container_class	= 'product-options__swatch-container' %}
		{% assign swatch_class 				= 'radio-option-swatch-square' %}
		{% assign swatch_label_class 		= 'radio-option-swatch-square__label' %}
		{% assign swatch_size 				= 80 %}
{% endcase %}

{% if variants_type == "select" %}
	{% assign swatch_size = 80 %}
{% endif %}

{%- form 'product', product, class: 'quick-view__form quick-view-form js-quick-view-form', novalidate: 'novalidate', id: 'quick-view-form' -%}
	{% if product.template_suffix == 'pre-order' %}
		<input type="hidden" name="properties[_Pre-order]" value="true">
	{% endif %}

	<div class="quick-view-form__options">
		<div class="quick-view-form__options-container js-accordion-container">
			<div class="js-quick-view-product-options">
				{%- for option in product.options_with_values -%}
					<fieldset class="fieldset quick-view-form__option {% if variants_type == "radio" %} js-accordion-item accordion is-active{% else %} quick-view-form__option--no-border{%- endif -%}">
						{%- assign option_position  		= option.position -%}
						{%- assign option_name_downcased	= option.name | downcase -%}
						{%- assign option_name_handle		= option.name | handle -%}
						{%- assign option_index				= "option" | append: option_position -%}
						{%- assign swatch_count 			= option.values | map: 'swatch' | compact | size -%}

						{% assign use_color_swatch = false %}

						{% if swatch_count > 0 and is_color_swatches_enabled %}
							{% assign use_color_swatch = true %}
						{% endif %}

						{% for swatch in swatches %}
							{% assign swatch_string = swatch | strip %}

							{% if swatch_string == option_name_downcased %}
								{% assign swatch_option = swatch_string %}
								{%- break -%}
							{% endif %}
						{% endfor %}

						{% if is_color_swatches_enabled and option_name_downcased == swatch_option %}
							{% assign use_color_swatch = true %}
						{% endif %}

						{%- if variants_type == "radio" -%}
							<button
								type="button"
								class="fieldset__legend legend quick-view-form__name accordion__title focus-visible-outline js-accordion-control"
								aria-expanded="true"
								aria-controls="quick-view-accordion-{{- option.position -}}"
								aria-label="{{ 'accordions.show' | t | escape }}"
							>
								<span class="product-options__swatch-wrapper">
									<span class="product-options__swatch-label">{{- option.name -}}:</span>

									<span class="product-options__swatch-value js-swatch-label-name"
										  data-swatch-name="{{ option.name }}"
										  data-swatch-position="{{ option.position }}"
									>
										{{- option.selected_value -}}
									</span>
								</span>

								<span class="quick-view-form__accordion-icon" aria-hidden="true">
									{%- render 'icons', icon: 'arrow-down', class: 'icon-arrow-down' -%}
								</span>
							</button>

							<div class="quick-view-form__accordion-content-animate accordion__content accordion__content--animate js-accordion-content" style="height: auto;" id="quick-view-accordion-{{- option.position -}}">
								<div class="quick-view-form__accordion-content js-accordion-inner">
									{% if use_color_swatch %}
										<div class="{{- swatch_container_class -}} {% if enable_variant_images %} product-options__swatch-container--images{% endif %}">
											{%- for value in option.values  -%}
												{%- assign handleized_value = value | handleize -%}

												{%- capture swatch_styles -%}
													{% assign image_name = value | handle | prepend: 'swatch-' | append: '.png' %}
													{% assign swatch_color_fallback = value | split: ' ' | last | handle %}

													{% assign variant_image = blank %}

													{% if enable_variant_images %}
														{% assign variant_image = value.variant.featured_image | default: value.variant.image %}
													{% endif %}

													{% assign swatch_image = variant_image | default: value.swatch.image | default: images[image_name] %}
													{% assign swatch_color = value.swatch.color | default: swatch_color_fallback %}

													style="
														{%- if swatch_image != blank -%}
															--swatch-image: url(
																{%- if enable_variant_images -%}
																	{{- swatch_image | image_url: width: 80, height: 80 -}}
																{%- else -%}
																	{{- swatch_image | image_url: width: swatch_size, height: swatch_size -}}
																{%- endif -%}
															);
														{%- else -%}
															--swatch-color: {{ swatch_color }};
														{%- endif -%}
													"
												{%- endcapture -%}

												<div class="radio-container {{ swatch_class }}" {{- swatch_styles -}}>
													{%- assign is_disabled = true -%}

													{% if value.available %}
														{%- assign is_disabled = false -%}
													{% endif %}

													<input
														id="quick-view-{{- value | handle -}}-{{ option_name_handle }}"
														type="radio"
														class="visually-hidden radio-input js-swatch"
														value="{{- value -}}"
														name="option{{- option.position -}}"
														{% if value.selected %}
															checked
														{% endif %}
														data-option="option{{- option.position -}}"
														data-option-value-id="{{ value.id }}"
													/>

													<label
														for="quick-view-{{- value | handle -}}-{{ option_name_handle }}"
														class="{{ swatch_label_class }} {% if is_disabled %}is-disabled{% endif %}"
													>
														<span class="visually-hidden">{{- value -}}</span>
													</label>
												</div>
											{%- endfor -%}
										</div>
										</fieldset>
										{%- continue -%}
									{% endif %}

									{%- for value in option.values -%}
										{%- assign is_disabled = true -%}

										{% if value.available %}
											{%- assign is_disabled = false -%}
										{% endif %}

										{%- capture container_classes -%}
											radio-container radio-option quick-view-form__radio-container
										{%- endcapture -%}

										<div class="{{- container_classes -}}">
											<input
												id="quick-view-{{- value | handle -}}-{{ option_name_handle }}"
												type="radio"
												class="visually-hidden radio-input"
												value="{{- value | escape -}}"
												name="option{{- option.position -}}"
												data-option="option{{- option.position -}}"
												data-option-value-id="{{ value.id }}"
												{%- if value.selected -%}checked{%- endif -%}
											>

											<label
												for="quick-view-{{- value | handle -}}-{{ option_name_handle }}"
												class="radio-option__label {% if is_disabled %}is-disabled{% endif %}"
											>
												<span class="radio-label__text">
													{{- value -}}
												</span>
											</label>
										</div>
									{%- endfor -%}
								</div>
							</div>
						{%- else -%}
							<div id="quick-view-option-{{ option_name_handle }}" class="custom-dropdown js-custom-dropdown">
								<style>
									{%- for value in option.values  -%}
										.custom-dropdown:has(#quick-view-{{- value | handle -}}-{{ option_name_handle }}:checked) #quick-view-{{- value | handle -}}-{{ option_name_handle }}-trigger {
											display: flex;
										}
									{% endfor %}
								</style>

								<span class="custom-dropdown__label">{{ option.name }}</span>

								<button class="custom-dropdown__trigger js-custom-dropdown-trigger" type="button">
									{%- for value in option.values  -%}
										{%- capture swatch_styles -%}
											{% assign image_name = value | handle | prepend: 'swatch-' | append: '.png' %}
											{% assign swatch_color_fallback = value | split: ' ' | last | handle %}

											{% assign variant_image = blank %}

											{% if enable_variant_images %}
												{% assign variant_image = value.variant.featured_image | default: value.variant.image %}
											{% endif %}

											{% assign swatch_image = variant_image | default: value.swatch.image | default: images[image_name] %}
											{% assign swatch_color = value.swatch.color | default: swatch_color_fallback %}

											style="
												{%- if swatch_image != blank -%}
													--swatch-image: url({{- swatch_image | image_url: width: swatch_size, height: swatch_size -}});
												{%- else -%}
													--swatch-color: {{ swatch_color }};
												{%- endif -%}
											"
										{%- endcapture -%}

										<span class="custom-dropdown__trigger-content {% if use_color_swatch %}custom-dropdown__trigger-content--color-swatch{% endif %}" id="quick-view-{{- value | handle -}}-{{ option_name_handle }}-trigger"
										{%- if use_color_swatch -%}
											{{ swatch_styles }}
										{%- endif -%}
										>
											{{- value -}}
										</span>
									{% endfor %}
									{%- render 'icons', icon: 'arrow-down', class: 'custom-dropdown__trigger-icon' -%}
								</button>

								<div class="custom-dropdown__options">
									{%- for value in option.values  -%}
										{%- assign is_disabled = true -%}

										{% if value.available %}
											{%- assign is_disabled = false -%}
										{% endif %}

										{%- capture swatch_styles -%}
											{% assign image_name = value | handle | prepend: 'swatch-' | append: '.png' %}
											{% assign swatch_color_fallback = value | split: ' ' | last | handle %}

											{% assign variant_image = blank %}

											{% if enable_variant_images %}
												{% assign variant_image = value.variant.featured_image | default: value.variant.image %}
											{% endif %}

											{% assign swatch_image = variant_image | default: value.swatch.image | default: images[image_name] %}
											{% assign swatch_color = value.swatch.color | default: swatch_color_fallback %}

											style="
												{%- if swatch_image != blank -%}
													--swatch-image: url({{- swatch_image | image_url: width: swatch_size, height: swatch_size -}});
												{%- else -%}
													--swatch-color: {{ swatch_color }};
												{%- endif -%}
											"
										{%- endcapture -%}
										<label
											class="custom-dropdown__option {% if use_color_swatch %}custom-dropdown__option--color-swatch{% endif %} {% if is_disabled %}is-disabled{% endif %}"
											{%- if use_color_swatch -%}
												{{ swatch_styles }}
											{%- endif -%}
										>
											<input
													id="quick-view-{{- value | handle -}}-{{ option_name_handle }}"
													type="radio"
													class="visually-hidden radio-input"
													value="{{- value -}}"
													name="option{{- option.position -}}"
													{% if value.selected %}
														checked
													{% endif %}
													data-option="option{{- option.position -}}"
													data-option-value-id="{{ value.id }}"
											/>
											{{- value -}}
										</label>
									{%- endfor -%}
								</div>
							</div>
						{%- endif -%}
					</fieldset>
				{%- endfor -%}

				<script type="application/json" data-selected-variant>
					{{ product.selected_or_first_available_variant | json }}
				</script>
			</div>
		</div>

		<input class="js-quick-view-hidden-select" type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

		<div class="quick-view-form__error" id="QuickViewError-{{- product.id -}}" role="alert">
			<small class="quick-view-form__error js-quick-view-error"></small>
		</div>
	</div>

	<div class="quick-view-form__controls {% if variants_type == "select" %} quick-view-form__controls--no-border{% endif %}">
		<div class="quick-view-form__additional-data js-product-quantity">
			<div class="quick-view__price js-quick-view-price">
				{%- render 'price', product: product, show_unit_price: show_unit_price, currency_code_enabled: currency_code_enabled, use_variant: true -%}
			</div>

			{%- render 'product-quantity', product: product -%}
		</div>

		<div class="quick-view__buttons">
			<button
				class="button-simple button-simple--custom quick-view__button quick-view__button--desktop js-quick-view-submit-button"
				style="{{- add_to_card_button_styles -}}"
				data-add-to-card="{{- "products.product.add_to_cart" | t -}}"
				data-sold-out="{{- "products.product.sold_out" | t -}}"
				data-unavailable="{{- "products.product.unavailable" | t -}}"
				{% if product.template_suffix == 'pre-order' %}
					data-preorder
				{% endif %}
				type="submit"
				{%- if product.selected_or_first_available_variant.available == false -%}
					disabled
				{%- endif -%}
			>
				{% render 'icons', icon: 'cart' %}
				<span class="js-quick-view-submit-text">
					{%- if product.selected_or_first_available_variant == null -%}
						{{- 'products.product.unavailable' | t -}}
					{%- elsif product.selected_or_first_available_variant.available -%}
						{% if product.template_suffix == 'pre-order' %}
							{{- 'products.product.pre_order' | t -}}
						{% else %}
							{{- 'products.product.add_to_cart' | t -}}
						{% endif %}
					{%- else -%}
						{{- "products.product.sold_out" | t -}}
					{%- endif -%}
				</span>
			</button>

			{%- if quick_view_enable_buy_it_now -%}
				<div class="additional-checkout-buttons">
					{{- form | payment_button  -}}
				</div>
			{%- endif -%}

			{%- if enable_compare_products -%}
				<button
					class="button-simple button-simple--custom quick-view-form__compare-button is-hidden js-compare-products-button"
					style="{{- compare_button_styles -}}"
					data-product-handle="{{- product.handle -}}"
					data-product-title="{{- product.title | escape -}}"
					aria-label="{{ 'products.compare_products.product_button_add' | t: product: product.title | escape }}"
					type="button">
					{%- render 'icons', icon: 'compare' -%}
					{{ 'products.quick_view.to_compare' | t }}
					{% render 'icons', icon: 'checkmark' %}
				</button>
			{%- endif -%}
		</div>
	</div>
{%- endform -%}
