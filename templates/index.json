		"faq_simple_HqUbWV": {
			"type": "faq-simple",
			"blocks": {
				"faq_item_dhdDPE": {
					"type": "faq_item",
					"settings": {
						"heading": "I made a mistake in the shipping address. Can I change it?",
						"text": "<p>If you notice a mistake in your shipping address, please contact us as soon as possible. We can update the address if your order hasn’t been processed yet. Once it has been shipped, we’re unable to make changes, but you may be able to update delivery details directly with the carrier.</p>"
					}
				},
				"faq_item_eTnUtj": {
					"type": "faq_item",
					"settings": {
						"heading": "I am purchasing a gift. Can you exclude price information?",
						"text": "<p>Our warehouse takes pride in shipping items out as soon as possible. Many of the orders will be processed within 2 hours after you place the order. We are unable to make any changes once an order begins processing, but we do accepts returns and exchanges at any time, and would be happy to reship your order if it is undeliverable as addressed.</p>"
					}
				},
				"faq_item_nQbhFQ": {
					"type": "faq_item",
					"settings": {
						"heading": "Can I make a change to my order?",
						"text": "<p>We’re happy to help with changes if your order hasn’t been processed yet. Please reach out to us as quickly as possible, and we’ll do our best to update it. Once an order has been shipped, we’re unable to make modifications.</p>"
					}
				},
				"faq_item_xNGQx8": {
					"type": "faq_item",
					"settings": {
						"heading": "How do I prepare my boba drink set?",
						"text": "<p>Each set comes with easy step-by-step instructions. Simply cook the boba pearls, mix with the included tea or flavor base, add ice or milk if you like, and enjoy your café-style drink at home in just a few minutes.</p>"
					}
				},
				"faq_item_FVLeB6": {
					"type": "faq_item",
					"settings": {
						"heading": "Do you ship internationally?",
						"text": "<p>Yes! We ship to many countries worldwide. Shipping rates and delivery times vary depending on your location, and you’ll see the exact options available at checkout. If your country isn’t listed, feel free to contact us and we’ll do our best to help.</p>"
					}
				},
				"faq_item_9mpcrW": {
					"type": "faq_item",
					"settings": {
						"heading": "What currencies do you accept?",
						"text": "<p>We accept payments in multiple currencies. Your local currency will usually display automatically based on your location. At checkout, you’ll see the available currency options before completing your order.</p>"
					}
				}
			},
